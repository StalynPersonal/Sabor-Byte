@page "/inicio"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@implements IAsyncDisposable
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject ConexionComandas Conexion
@inject NavigationManager Navegacion
@inject IJSRuntime JS

<PageTitle>SaborByte — Cocina</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <MudText Typo="Typo.h6" Class="mb-2">En preparación</MudText>
    @if (_comandasEnPreparacion.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mb-4">No hay comandas pendientes.</MudText>
    }
    else
    {
        <MudGrid Class="mb-6">
            @foreach (var comanda in _comandasEnPreparacion)
            {
                <MudItem xs="12" sm="6" md="4">
                    <ComandaCard Comanda="comanda" OnImprimir="ImprimirAsync"
                                 OnPreparar="item => CambiarEstadoAsync(item, EstadoItemComanda.EnPreparacion)"
                                 OnListo="item => CambiarEstadoAsync(item, EstadoItemComanda.Listo)"
                                 OnCancelar="CancelarAsync" />
                </MudItem>
            }
        </MudGrid>
    }

    @if (_comandasListas.Count > 0)
    {
        <MudDivider Class="mb-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Listas</MudText>
        <MudGrid>
            @foreach (var comanda in _comandasListas)
            {
                <MudItem xs="12" sm="6" md="4">
                    <ComandaCard Comanda="comanda" OnImprimir="ImprimirAsync"
                                 OnPreparar="item => CambiarEstadoAsync(item, EstadoItemComanda.EnPreparacion)"
                                 OnListo="item => CambiarEstadoAsync(item, EstadoItemComanda.Listo)"
                                 OnCancelar="CancelarAsync" />
                </MudItem>
            }
        </MudGrid>
    }
}

@if (_comandaAImprimir is not null)
{
    <div class="solo-imprimir">
        <p style="text-align:center; margin:0; font-weight:bold">COMANDA #@_comandaAImprimir.NumeroComanda</p>
        @if (!string.IsNullOrEmpty(_comandaAImprimir.NumeroMesa))
        {
            <p style="text-align:center; margin:0">Mesa @_comandaAImprimir.NumeroMesa@(string.IsNullOrEmpty(_comandaAImprimir.NombreSalon) ? "" : $" ({_comandaAImprimir.NombreSalon})")</p>
        }
        <p style="text-align:center; margin:0">@_comandaAImprimir.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        <hr />
        @foreach (var item in _comandaAImprimir.Items.Where(i => i.Estado != EstadoItemComanda.Cancelado))
        {
            <p style="margin:4px 0">@item.Cantidad x @item.NombreProducto</p>
            @if (!string.IsNullOrEmpty(item.Notas))
            {
                <p style="margin:0 0 4px 12px">Nota: @item.Notas</p>
            }
        }
    </div>
}

@code {
    private List<ComandaDto> _comandas = [];
    private ComandaDto? _comandaAImprimir;

    // "Lista" = ya no queda nada por preparar (todos sus ítems activos están Listo o
    // Entregado) — se separa de "En preparación" para no perderla de vista pero sin que
    // estorbe entre las que sí necesitan trabajo. Una comanda con todos los ítems
    // cancelados no tiene nada que mostrar en ninguna de las dos secciones.
    private List<ComandaDto> _comandasEnPreparacion => _comandas
        .Where(c => c.Items.Any(i => i.Estado is EstadoItemComanda.Pendiente or EstadoItemComanda.EnPreparacion))
        .OrderBy(c => c.CreadoEn)
        .ToList();

    private List<ComandaDto> _comandasListas => _comandas
        .Where(c => c.Items.Any(i => i.Estado is EstadoItemComanda.Listo or EstadoItemComanda.Entregado) &&
                    !c.Items.Any(i => i.Estado is EstadoItemComanda.Pendiente or EstadoItemComanda.EnPreparacion))
        .OrderBy(c => c.CreadoEn)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        if (Sesion.RequiereSeleccionSucursal)
        {
            Navegacion.NavigateTo("/seleccionar-sucursal");
            return;
        }

        var sucursalId = Sesion.SucursalActivaId;
        _comandas = await ApiClient.ObtenerComandasAbiertasAsync(sucursalId);

        Conexion.ComandaCreada += OnComandaCreada;
        Conexion.ItemActualizado += OnItemActualizado;
        Conexion.ComandaCancelada += OnComandaCancelada;
        await Conexion.ConectarAsync();
    }

    private void OnComandaCreada(ComandaDto comanda)
    {
        _comandas.Add(comanda);
        InvokeAsync(StateHasChanged);
    }

    private void OnItemActualizado(Guid comandaId, ComandaItemDto item)
    {
        var comanda = _comandas.FirstOrDefault(c => c.Id == comandaId);
        var existente = comanda?.Items.FirstOrDefault(i => i.Id == item.Id);
        if (existente is not null)
        {
            comanda!.Items[comanda.Items.IndexOf(existente)] = item;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnComandaCancelada(Guid comandaId, Guid? itemId)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CambiarEstadoAsync(ComandaItemDto item, EstadoItemComanda nuevoEstado)
    {
        var sucursalId = Sesion.SucursalActivaId;
        await ApiClient.CambiarEstadoItemAsync(sucursalId, item.Id, nuevoEstado);
        item.Estado = nuevoEstado; // optimista; el evento SignalR reconfirma
    }

    private async Task CancelarAsync(ComandaItemDto item)
    {
        var sucursalId = Sesion.SucursalActivaId;
        await ApiClient.CancelarItemAsync(sucursalId, item.Id, "Cancelado desde cocina", RolQueCancelo.Cocina);
        item.Estado = EstadoItemComanda.Cancelado;
        StateHasChanged();
    }

    private async Task ImprimirAsync(ComandaDto comanda)
    {
        _comandaAImprimir = comanda;
        StateHasChanged();
        // Sin esta espera, "print" a veces se dispara antes de que el navegador termine de
        // pintar el bloque .solo-imprimir con el detalle — sale la hoja con el título pero
        // sin los ítems.
        await Task.Delay(50);
        await JS.InvokeVoidAsync("print");
    }

    public async ValueTask DisposeAsync()
    {
        Conexion.ComandaCreada -= OnComandaCreada;
        Conexion.ItemActualizado -= OnItemActualizado;
        Conexion.ComandaCancelada -= OnComandaCancelada;
        await Task.CompletedTask;
    }
}
