@page "/cajas"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<PageTitle>SaborByte</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Cajas</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NuevaCaja" Disabled="_sucursalSeleccionadaId == Guid.Empty">
            Nueva caja
        </MudButton>
    </div>

    <MudSelect T="Guid" Label="Sucursal" Value="_sucursalSeleccionadaId" ValueChanged="OnSucursalCambiadaAsync" Class="mb-4" Style="max-width:400px">
        @foreach (var sucursal in _sucursales)
        {
            <MudSelectItem Value="@sucursal.Id">@sucursal.Nombre</MudSelectItem>
        }
    </MudSelect>

    <MudTable Items="_cajas" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Número</MudTh>
            <MudTh>Activa</MudTh>
            <MudTh>IP autorizada</MudTh>
            <MudTh>Próximo N° de factura</MudTh>
            <MudTh>Formato de impresión</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Numero</MudTd>
            <MudTd>@(context.Activa ? "Sí" : "No")</MudTd>
            <MudTd>@(context.IpPermitida ?? "(cualquiera)")</MudTd>
            <MudTd>@context.ProximoNumeroFactura</MudTd>
            <MudTd>@TextoFormato(context.FormatoImpresion)</MudTd>
            <MudTd>
                <MudTooltip Text="Ver estado">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="() => VerEstadoAsync(context)" />
                </MudTooltip>
                <MudTooltip Text="Editar">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditarCaja(context)" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDialog @bind-Visible="_viendoEstado" Options="_opcionesDialogo">
    <TitleContent>Estado — Caja @_cajaViendoEstado?.Numero</TitleContent>
    <DialogContent>
        @if (_cargandoEstado)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_estadoCaja is not null)
        {
            @if (!_estadoCaja.TurnoAbierto)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No hay ningún turno abierto en esta caja ahora mismo.</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2"><strong>Turno:</strong> #@_estadoCaja.NumeroTurno</MudText>
                <MudText Typo="Typo.body2">
                    <strong>Abierto:</strong> @_estadoCaja.FechaHoraApertura?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    por @(_estadoCaja.UsuarioAperturaNombre ?? "?")
                </MudText>
                @if (!string.IsNullOrWhiteSpace(_estadoCaja.IpApertura))
                {
                    <MudText Typo="Typo.body2"><strong>IP de apertura:</strong> @_estadoCaja.IpApertura</MudText>
                }
                @if (_estadoCaja.OtrasIpsDetectadas.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        También se detectó actividad facturando desde: @string.Join(", ", _estadoCaja.OtrasIpsDetectadas)
                    </MudAlert>
                }
                <MudText Typo="Typo.body2" Class="mt-2">
                    <strong>Facturado en este turno:</strong> RD$ @_estadoCaja.TotalFacturadoTurno.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
                    (@_estadoCaja.CantidadFacturasTurno factura(s))
                </MudText>
            }

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-1">Logueado ahora mismo en esta caja</MudText>
            @if (_estadoCaja.UsuariosActivosAhora.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Nadie tiene esta caja abierta en su pantalla ahora mismo.</MudText>
            }
            else
            {
                @foreach (var nombre in _estadoCaja.UsuariosActivosAhora)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="mr-1 mb-1">@nombre</MudChip>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                    Puede ser distinto de quién abrió el turno — por ejemplo, si esa persona
                    se retiró y otra continuó facturando en la misma caja.
                </MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _viendoEstado = false">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_editando" Options="_opcionesDialogo">
    <TitleContent>@(_cajaId is null ? "Nueva caja" : "Editar caja")</TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Número (ej. 01)" @bind-Value="_form.Numero" Class="mb-2" />
        <MudCheckBox T="bool" @bind-Value="_form.Activa" Label="Activa" Class="mb-2" />

        <MudTextField T="string" Label="IP autorizada (opcional)" @bind-Value="_form.IpPermitida" Class="mb-2" />
        <MudTextField T="string" Label="Hostname autorizado (opcional)" @bind-Value="_form.HostnamePermitido" Class="mb-2" />

        <MudNumericField T="long" Label="Próximo N° de factura (secuencia)" @bind-Value="_form.ProximoNumeroFactura" Class="mb-2" />
        <MudText Typo="Typo.caption" Class="mb-2">
            El próximo número de factura completo será: <strong>@VistaPreviaNumeroFactura()</strong>
            (código de sucursal + número de caja + secuencia de 5 dígitos). No se puede retroceder, solo mantener o avanzar.
        </MudText>

        <MudSelect T="FormatoImpresion" Label="Formato de impresión" @bind-Value="_form.FormatoImpresion" Class="mb-2">
            <MudSelectItem Value="FormatoImpresion.Ticket80mm">Ticket térmico 80mm</MudSelectItem>
            <MudSelectItem Value="FormatoImpresion.Ticket58mm">Ticket térmico 58mm (impresora portátil)</MudSelectItem>
            <MudSelectItem Value="FormatoImpresion.Carta">Hoja carta (8.5x11)</MudSelectItem>
        </MudSelect>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Define qué plantilla usa esta caja al imprimir facturas y notas de crédito — según la impresora física conectada a esa estación.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editando = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Guardar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _opcionesDialogo = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };

    private List<CajaDto> _cajas = [];
    private List<SucursalResumenDto> _sucursales = [];
    private Guid _sucursalSeleccionadaId;
    private bool _editando;
    private bool _procesando;
    private Guid? _cajaId;
    private GuardarCajaRequestDto _form = new();

    private bool _viendoEstado;
    private bool _cargandoEstado;
    private CajaDto? _cajaViendoEstado;
    private EstadoCajaDto? _estadoCaja;

    private string? _codigoSucursal => _sucursales.FirstOrDefault(s => s.Id == _sucursalSeleccionadaId)?.Codigo;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        _sucursales = await ApiClient.ListarSucursalesGestionAsync();
        _sucursalSeleccionadaId = _sucursales.Any(s => s.Id == Sesion.SucursalActivaId)
            ? Sesion.SucursalActivaId
            : _sucursales.FirstOrDefault()?.Id ?? Guid.Empty;

        await CargarAsync();
    }

    private async Task OnSucursalCambiadaAsync(Guid sucursalId)
    {
        _sucursalSeleccionadaId = sucursalId;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        if (_sucursalSeleccionadaId == Guid.Empty)
        {
            _cajas = [];
            return;
        }

        _cajas = await ApiClient.ListarCajasGestionAsync(_sucursalSeleccionadaId);
    }

    private string VistaPreviaNumeroFactura() =>
        $"{_codigoSucursal ?? "??"}{(string.IsNullOrEmpty(_form.Numero) ? "??" : _form.Numero)}{_form.ProximoNumeroFactura:D5}";

    private async Task VerEstadoAsync(CajaDto caja)
    {
        _cajaViendoEstado = caja;
        _estadoCaja = null;
        _cargandoEstado = true;
        _viendoEstado = true;
        _estadoCaja = await ApiClient.ObtenerEstadoCajaAsync(caja.Id);
        _cargandoEstado = false;
    }

    private void NuevaCaja()
    {
        _cajaId = null;
        _form = new GuardarCajaRequestDto();
        _editando = true;
    }

    private void EditarCaja(CajaDto caja)
    {
        _cajaId = caja.Id;
        _form = new GuardarCajaRequestDto
        {
            Numero = caja.Numero,
            Activa = caja.Activa,
            IpPermitida = caja.IpPermitida,
            HostnamePermitido = caja.HostnamePermitido,
            ProximoNumeroFactura = caja.ProximoNumeroFactura,
            FormatoImpresion = caja.FormatoImpresion
        };
        _editando = true;
    }

    private static string TextoFormato(FormatoImpresion formato) => formato switch
    {
        FormatoImpresion.Ticket58mm => "Ticket 58mm",
        FormatoImpresion.Carta => "Carta (8.5x11)",
        _ => "Ticket 80mm"
    };

    private async Task GuardarAsync()
    {
        if (_procesando) return;
        _procesando = true;
        try
        {
            var (exito, error) = _cajaId is null
                ? await ApiClient.CrearCajaAsync(_sucursalSeleccionadaId, _form)
                : await ApiClient.ActualizarCajaAsync(_sucursalSeleccionadaId, _cajaId.Value, _form);

            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
                return;
            }

            Snackbar.Add(_cajaId is null ? "Caja creada." : "Caja actualizada.", Severity.Success);
            _editando = false;
            await CargarAsync();
        }
        finally
        {
            _procesando = false;
        }
    }
}
