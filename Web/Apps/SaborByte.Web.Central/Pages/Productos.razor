        <MudButton OnClick="() => _creandoUnidadMedida = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarUnidadMedidaAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Crear</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_viendoDetalle" Options="_opcionesDialogo">
    <TitleContent>Detalle del producto</TitleContent>
    <DialogContent>
        @if (_detalle is not null)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2">@_detalle.Nombre @(_detalle.EsCombo ? "(combo)" : "")</MudText>
            @if (!string.IsNullOrEmpty(_detalle.ImagenUrl))
            {
                <MudImage Src="@_detalle.ImagenUrl" Width="120" Height="120" ObjectFit="ObjectFit.Cover" Class="rounded mb-3" />
            }
            @if (!string.IsNullOrEmpty(_detalle.Descripcion))
            {
                <MudText Typo="Typo.body2" Class="mb-3">@_detalle.Descripcion</MudText>
            }

            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td>Código</td><td>@_detalle.Codigo</td></tr>
                    <tr><td>Códigos de barra</td><td>@(_detalle.CodigosBarra.Count > 0 ? string.Join(", ", _detalle.CodigosBarra) : "—")</td></tr>
                    <tr><td>Tipo</td><td>@TextoTipo(_detalle)</td></tr>
                    <tr><td>Categoría</td><td>@(_categorias.FirstOrDefault(c => c.Id == _detalle.CategoriaId)?.Nombre ?? "—")</td></tr>
                    <tr><td>Precio</td><td>RD$ @_detalle.Precio.ToString("0.00")</td></tr>
                    <tr><td>Costo unitario</td><td>@(_detalle.CostoUnitario is decimal costo ? $"RD$ {costo:0.00}" : "—")</td></tr>
                    <tr><td>Tasa de ITBIS</td><td>@(_detalle.TasaItbis * 100)%</td></tr>
                    <tr><td>Unidad de medida</td><td>@(_unidadesMedida.FirstOrDefault(u => u.Id == _detalle.UnidadMedidaId)?.Nombre ?? "—")</td></tr>
                    @if (_detalle.Inventariable)
                    {
                        <tr><td>Stock actual</td><td>@_detalle.StockActual.ToString("0.###")</td></tr>
                        <tr><td>Stock mínimo</td><td>@(_detalle.StockMinimo?.ToString("0.###") ?? "—")</td></tr>
                        <tr><td>Stock máximo</td><td>@(_detalle.StockMaximo?.ToString("0.###") ?? "—")</td></tr>
                    }
                    <tr><td>Activo</td><td>@(_detalle.Activo ? "Sí" : "No")</td></tr>
                    <tr><td>Creado por</td><td>@(_detalle.CreadoPorNombre ?? "—") — @_detalle.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
                    @if (_detalle.ActualizadoEn is DateTime actualizadoEn)
                    {
                        <tr><td>Última edición</td><td>@(_detalle.ActualizadoPorNombre ?? "—") — @actualizadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
                    }
                </tbody>
            </MudSimpleTable>

            @if (_detalle.EsCombo)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Componentes</MudText>
                @if (_detalle.Componentes.Count == 0)
                {
                    <MudText Typo="Typo.body2">Este combo no tiene componentes.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>Código</th><th>Producto</th><th>Cantidad</th></tr></thead>
                        <tbody>
                            @foreach (var componente in _detalle.Componentes)
                            {
                                <tr><td>@(componente.ProductoIncluidoCodigo ?? "—")</td><td>@componente.ProductoIncluidoNombre</td><td>@componente.Cantidad.ToString("0.###")</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            }
            else if (_detalle.TipoProducto == TipoProducto.Vendible && !_detalle.Inventariable)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Receta (insumos)</MudText>
                @if (_detalle.Receta.Count == 0)
                {
                    <MudText Typo="Typo.body2">Este producto todavía no tiene receta configurada.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>Código</th><th>Insumo</th><th>Cantidad</th><th>Opcional</th></tr></thead>
                        <tbody>
                            @foreach (var ingrediente in _detalle.Receta)
                            {
                                <tr>
                                    <td>@(ingrediente.InsumoCodigo ?? "—")</td>
                                    <td>@ingrediente.InsumoNombre</td>
                                    <td>@ingrediente.CantidadUsada.ToString("0.###")</td>
                                    <td>@(ingrediente.Opcional ? "Sí" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _viendoDetalle = false">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _procesando;
    private MudTable<ProductoDetalleDto>? _tabla;
    private readonly DialogOptions _opcionesDialogo = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
    private readonly DialogOptions _opcionesDialogoGrande = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };

    private string _textoBusqueda = string.Empty;
    private TipoProducto? _filtroTipo;
    private bool _incluirInactivos;

    private List<ProductoDetalleDto> _insumos = [];
    private List<ProductoDetalleDto> _vendiblesParaCombo = [];
    private List<CategoriaDto> _categorias = [];
    private List<UnidadMedidaDto> _unidadesMedida = [];

    private bool _creandoCategoria;
    private GuardarCategoriaRequestDto _formCategoria = new();

    private bool _creandoUnidadMedida;
    private GuardarUnidadMedidaRequestDto _formUnidadMedida = new();

    private bool _viendoDetalle;
    private ProductoDetalleDto? _detalle;

    private bool _editando;
    private Guid? _productoId;
    private GuardarProductoRequestDto _form = new();
    private string _nuevoCodigoBarra = string.Empty;
    private bool _editandoEsCombo;

    private bool _editandoReceta;

    private bool _editandoCombo;
    private Guid? _comboIdEditando;
    private CrearComboRequestDto _formCombo = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        await CargarListasParaFormulariosAsync();
    }

    private Guid SucursalId => Sesion.SucursalActivaId;

    // Listas completas (sin paginar) para los selects de receta/combo — independientes
    // de la tabla principal, que sí está paginada.
    private async Task CargarListasParaFormulariosAsync()
    {
        var insumos = await ApiClient.ListarProductosAsync(1, 500, tipo: TipoProducto.Insumo, incluirInactivos: false, sucursalId: SucursalId);
        _insumos = insumos.Items;

        var vendibles = await ApiClient.ListarProductosAsync(1, 500, tipo: TipoProducto.Vendible, incluirInactivos: false);
        // Un combo solo puede incluir productos Vendibles que NO sean a su vez combos
        // (evita anidar combos dentro de combos, que el backend no espera en v1).
        _vendiblesParaCombo = vendibles.Items.Where(p => !p.EsCombo).ToList();

        _categorias = await ApiClient.ListarCategoriasAsync();
        _unidadesMedida = await ApiClient.ListarUnidadesMedidaAsync();
    }

    private ProductoDetalleDto? ObtenerInsumoPorId(Guid id) =>
        id == Guid.Empty ? null : _insumos.FirstOrDefault(p => p.Id == id);

    private Task<IEnumerable<ProductoDetalleDto>> BuscarInsumosAsync(string texto, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(texto))
            return Task.FromResult(_insumos.AsEnumerable());

        var resultado = _insumos.Where(p =>
            p.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            (p.Descripcion?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Codigo?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
            p.CodigosBarra.Any(cb => cb.Contains(texto, StringComparison.OrdinalIgnoreCase)));

        return Task.FromResult(resultado);
    }

    private ProductoDetalleDto? ObtenerVendiblePorId(Guid id) =>
        id == Guid.Empty ? null : _vendiblesParaCombo.FirstOrDefault(p => p.Id == id);

    private Task<IEnumerable<ProductoDetalleDto>> BuscarVendiblesParaComboAsync(string texto, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(texto))
            return Task.FromResult(_vendiblesParaCombo.AsEnumerable());

        var resultado = _vendiblesParaCombo.Where(p =>
            p.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            (p.Descripcion?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Codigo?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
            p.CodigosBarra.Any(cb => cb.Contains(texto, StringComparison.OrdinalIgnoreCase)));

        return Task.FromResult(resultado);
    }

    private void AbrirNuevaUnidadMedida()
    {
        _formUnidadMedida = new GuardarUnidadMedidaRequestDto();
        _creandoUnidadMedida = true;
    }

    private async Task GuardarUnidadMedidaAsync()
    {
        if (_procesando) return;

        if (string.IsNullOrWhiteSpace(_formUnidadMedida.Nombre))
        {
            Snackbar.Add("El nombre es obligatorio.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            var (exito, error) = await ApiClient.CrearUnidadMedidaAsync(_formUnidadMedida);
            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add("Unidad de medida creada.", Severity.Success);
            _unidadesMedida = await ApiClient.ListarUnidadesMedidaAsync();
            var nueva = _unidadesMedida.FirstOrDefault(u => u.Nombre == _formUnidadMedida.Nombre);
            if (nueva is not null && _editando)
                _form.UnidadMedidaId = nueva.Id;

            _creandoUnidadMedida = false;
        }
        finally
        {
            _procesando = false;
        }
    }

    private void AbrirNuevaCategoria()
    {
        _formCategoria = new GuardarCategoriaRequestDto();
        _creandoCategoria = true;
    }

    private async Task GuardarCategoriaAsync()
    {
        if (_procesando) return;

        if (string.IsNullOrWhiteSpace(_formCategoria.Nombre))
        {
            Snackbar.Add("El nombre es obligatorio.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            var (exito, error) = await ApiClient.CrearCategoriaAsync(_formCategoria);
            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add("Categoría creada.", Severity.Success);
            _categorias = await ApiClient.ListarCategoriasAsync();
            var nueva = _categorias.FirstOrDefault(c => c.Nombre == _formCategoria.Nombre);
            if (nueva is not null)
            {
                if (_editando) _form.CategoriaId = nueva.Id;
                if (_editandoCombo) _formCombo.CategoriaId = nueva.Id;
            }

            _creandoCategoria = false;
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task<TableData<ProductoDetalleDto>> CargarPaginaAsync(TableState estado, CancellationToken ct)
    {
        var resultado = await ApiClient.ListarProductosAsync(
            estado.Page + 1, estado.PageSize, _textoBusqueda, _filtroTipo, _incluirInactivos, SucursalId);

        return new TableData<ProductoDetalleDto> { Items = resultado.Items, TotalItems = resultado.TotalRegistros };
    }

    private Task RecargarTablaAsync() => _tabla?.ReloadServerData() ?? Task.CompletedTask;

    private async Task OnFiltroTipoChanged(TipoProducto? valor)
    {
        _filtroTipo = valor;
        await RecargarTablaAsync();
    }

    private async Task OnIncluirInactivosChanged(bool valor)
    {
        _incluirInactivos = valor;
        await RecargarTablaAsync();
    }

    private void NuevoProducto()
    {
        _productoId = null;
        _form = new GuardarProductoRequestDto
        {
            TipoProducto = TipoProducto.Vendible,
            CategoriaId = _categorias.FirstOrDefault()?.Id ?? Guid.Empty,
            UnidadMedidaId = _unidadesMedida.FirstOrDefault()?.Id ?? Guid.Empty
        };
        _editandoEsCombo = false;
        _nuevoCodigoBarra = string.Empty;
        _editando = true;
    }

    private void NuevoCombo()
    {
        _comboIdEditando = null;
        _formCombo = new CrearComboRequestDto { CategoriaId = _categorias.FirstOrDefault()?.Id ?? Guid.Empty };
        _editandoCombo = true;
    }

    private async Task OnKeyDownCodigoBarra(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AgregarCodigoBarra();
        await Task.CompletedTask;
    }

    private async Task OnImagenSeleccionadaAsync(IBrowserFile? archivo)
    {
        if (archivo is null)
            return;

        const long maxBytes = 2 * 1024 * 1024;
        if (archivo.Size > maxBytes)
        {
            Snackbar.Add("La imagen no puede superar 2 MB.", Severity.Error);
            return;
        }

        using var stream = archivo.OpenReadStream(maxBytes);
        using var memoria = new MemoryStream();
        await stream.CopyToAsync(memoria);
        _form.ImagenUrl = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}";
    }

    private void AgregarCodigoBarra()
    {
        var codigo = _nuevoCodigoBarra.Trim();
        if (!string.IsNullOrEmpty(codigo) && !_form.CodigosBarra.Contains(codigo))
            _form.CodigosBarra.Add(codigo);

        _nuevoCodigoBarra = string.Empty;
    }

    // Inventariable y Receta son mutuamente excluyentes (el backend lo rechaza si llegan
    // juntos) — sin esto, marcar Inventariable en un producto que ya tenía receta configurada
    // guardaba igual el _form.Receta viejo (el diálogo de edición no lo muestra ni lo toca) y
    // el guardado fallaba con un error que no explicaba qué había que hacer.
    private void OnInventariableChanged(bool valor)
    {
        _form.Inventariable = valor;
        if (valor && _form.Receta.Count > 0)
        {
            _form.Receta.Clear();
            Snackbar.Add("Se borró la receta configurada: un producto Inventariable no puede tener receta.", Severity.Warning);
        }
    }

    private async Task GuardarComboAsync()
    {
        if (_procesando) return;

        if (_formCombo.Componentes.Count == 0)
        {
            Snackbar.Add("El combo debe tener al menos un componente.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            var esNuevo = _comboIdEditando is null;
            var (exito, error) = esNuevo
                ? await ApiClient.CrearComboAsync(_formCombo)
                : await ApiClient.ActualizarComboAsync(_comboIdEditando!.Value, _formCombo);

            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add(esNuevo ? "Combo creado." : "Combo actualizado.", Severity.Success);
            _editandoCombo = false;
            _comboIdEditando = null;
            await CargarListasParaFormulariosAsync();
            await RecargarTablaAsync();
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task VerDetalleAsync(Guid id)
    {
        _detalle = await ApiClient.ObtenerProductoAsync(id, SucursalId);
        _viendoDetalle = _detalle is not null;
    }

    // Compartido entre "Editar producto" y "Receta": guardar en cualquiera de los dos
    // diálogos hace un PUT completo, así que el formulario siempre debe traer TODOS los
    // campos del producto (incluida la receta) para no pisar datos que ese diálogo no muestra.
    private static GuardarProductoRequestDto ConstruirForm(ProductoDetalleDto producto) => new()
    {
        Nombre = producto.Nombre,
        Descripcion = producto.Descripcion,
        Codigo = producto.Codigo ?? string.Empty,
        CodigosBarra = [.. producto.CodigosBarra],
        ImagenUrl = producto.ImagenUrl,
        Precio = producto.Precio,
        CostoUnitario = producto.CostoUnitario,
        TasaItbis = producto.TasaItbis,
        TipoProducto = producto.TipoProducto,
        Inventariable = producto.Inventariable,
        UnidadMedidaId = producto.UnidadMedidaId,
        CategoriaId = producto.CategoriaId,
        Receta = producto.Receta.Select(r => new IngredienteRequestDto
        {
            InsumoId = r.InsumoId,
            CantidadUsada = r.CantidadUsada,
            IncluidoPorDefecto = r.IncluidoPorDefecto,
            Opcional = r.Opcional
        }).ToList()
    };

    private async Task EditarProducto(Guid id)
    {
        var producto = await ApiClient.ObtenerProductoAsync(id);
        if (producto is null)
            return;

        if (producto.EsCombo)
        {
            _comboIdEditando = id;
            _formCombo = new CrearComboRequestDto
            {
                Nombre = producto.Nombre,
                Codigo = producto.Codigo ?? string.Empty,
                Precio = producto.Precio,
                CategoriaId = producto.CategoriaId,
                Componentes = producto.Componentes.Select(c => new ComponenteComboRequestDto
                {
                    ProductoIncluidoId = c.ProductoIncluidoId,
                    Cantidad = c.Cantidad
                }).ToList()
            };
            _editandoCombo = true;
            return;
        }

        _productoId = id;
        _form = ConstruirForm(producto);
        _editandoEsCombo = false;
        _nuevoCodigoBarra = string.Empty;
        _editando = true;
    }

    private async Task GuardarAsync()
    {
        if (_procesando) return;
        _procesando = true;
        try
        {
            var esNuevo = _productoId is null;
            var (exito, error) = _productoId is null
                ? await ApiClient.CrearProductoAsync(_form)
                : await ApiClient.ActualizarProductoAsync(_productoId.Value, _form);

            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add(esNuevo ? "Producto creado." : "Producto actualizado.", Severity.Success);
            _editando = false;
            await CargarListasParaFormulariosAsync();
            await RecargarTablaAsync();
        }
        finally
        {
            _procesando = false;
        }
    }

    private static string TextoTipo(ProductoDetalleDto p) => p.TipoProducto switch
    {
        TipoProducto.Insumo => "Insumo",
        _ when p.Inventariable => "Vendible (reventa)",
        _ => "Vendible"
    };

    private static string TextoTooltipReceta(ProductoDetalleDto p) => p.TipoProducto switch
    {
        TipoProducto.Insumo => "Los insumos no tienen receta propia",
        _ when p.EsCombo => "Los combos no tienen receta propia",
        _ when p.Inventariable => "Es de reventa (Inventariable) — no tiene receta, lleva su propio stock",
        _ => "Receta (ingredientes)"
    };

    private async Task AbrirRecetaAsync(Guid id)
    {
        var producto = await ApiClient.ObtenerProductoAsync(id);
        if (producto is null)
            return;

        _productoId = id;
        _form = ConstruirForm(producto);
        _editandoReceta = true;
    }

    private async Task GuardarRecetaAsync()
    {
        if (_procesando) return;
        _procesando = true;
        try
        {
            var (exito, error) = await ApiClient.ActualizarProductoAsync(_productoId!.Value, _form);
            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add("Receta actualizada.", Severity.Success);
            _editandoReceta = false;
            await CargarListasParaFormulariosAsync();
            await RecargarTablaAsync();
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task DesactivarAsync(Guid id)
    {
        await ApiClient.DesactivarProductoAsync(id);
        Snackbar.Add("Producto desactivado.", Severity.Success);
        await RecargarTablaAsync();
    }

    private async Task ActivarAsync(Guid id)
    {
        await ApiClient.ActivarProductoAsync(id);
        Snackbar.Add("Producto activado.", Severity.Success);
        await RecargarTablaAsync();
    }
