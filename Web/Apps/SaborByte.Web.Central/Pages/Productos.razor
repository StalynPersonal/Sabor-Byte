@page "/productos"
@using Microsoft.AspNetCore.Components.Forms
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<PageTitle>SaborByte — Central</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Productos</MudText>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="NuevoCombo">
                Nuevo combo
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NuevoProducto">
                Nuevo producto
            </MudButton>
        </div>
    </div>

    <MudPaper Class="pa-3 mb-3">
        <MudGrid>
            <MudItem xs="12" sm="5">
                <MudTextField T="string" Label="Buscar por nombre o código" @bind-Value="_textoBusqueda"
                               Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="RecargarTablaAsync"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudSelect T="TipoProducto?" Label="Tipo" Value="_filtroTipo" ValueChanged="OnFiltroTipoChanged">
                    <MudSelectItem Value="@((TipoProducto?)null)">Todos</MudSelectItem>
                    <MudSelectItem Value="@((TipoProducto?)TipoProducto.Vendible)">Vendible</MudSelectItem>
                    <MudSelectItem Value="@((TipoProducto?)TipoProducto.Insumo)">Insumo</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4" Class="d-flex align-center">
                <MudCheckBox T="bool" Value="_incluirInactivos" ValueChanged="OnIncluirInactivosChanged" Label="Mostrar inactivos" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable @ref="_tabla" ServerData="CargarPaginaAsync" Hover="true" Dense="true" T="ProductoDetalleDto">
        <HeaderContent>
            <MudTh>Código</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Combo</MudTh>
            <MudTh>Precio (con ITBIS)</MudTh>
            <MudTh>Stock</MudTh>
            <MudTh>Activo</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Código">@context.Codigo</MudTd>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Tipo">@TextoTipo(context)</MudTd>
            <MudTd DataLabel="Combo">@(context.EsCombo ? "Sí" : "No")</MudTd>
            <MudTd DataLabel="Precio (con ITBIS)">RD$ @((context.Precio * (1 + context.TasaItbis)).ToString("0.00"))</MudTd>
            <MudTd DataLabel="Stock">@(context.Inventariable ? context.StockActual.ToString("0.###") : "-")</MudTd>
            <MudTd DataLabel="Activo">@(context.Activo ? "Sí" : "No")</MudTd>
            <MudTd DataLabel="Acciones">
                <MudTooltip Text="Ver detalle">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="() => VerDetalleAsync(context.Id)" />
                </MudTooltip>
                <MudTooltip Text="Editar">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditarProducto(context.Id)" />
                </MudTooltip>
                <MudTooltip Text="@TextoTooltipReceta(context)">
                    <MudIconButton Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small"
                                   Disabled="context.TipoProducto != TipoProducto.Vendible || context.EsCombo || context.Inventariable"
                                   OnClick="() => AbrirRecetaAsync(context.Id)" />
                </MudTooltip>
                @if (context.Activo)
                {
                    <MudTooltip Text="Desactivar">
                        <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" OnClick="() => DesactivarAsync(context.Id)" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Activar">
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" OnClick="() => ActivarAsync(context.Id)" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }" InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
}

<MudDialog @bind-Visible="_editando" Options="_opcionesDialogo">
    <TitleContent>@(_productoId is null ? "Nuevo producto" : "Editar producto")</TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Nombre" @bind-Value="_form.Nombre" Class="mb-2" />
        <MudTextField T="string" Label="Descripción" @bind-Value="_form.Descripcion" Class="mb-2" />
        <MudTextField T="string" Label="Código (único)" @bind-Value="_form.Codigo" Class="mb-2" Required="true" />

        <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Imagen</MudText>
        <div class="d-flex align-center gap-3 mb-2">
            @if (!string.IsNullOrEmpty(_form.ImagenUrl))
            {
                <MudImage Src="@_form.ImagenUrl" Width="72" Height="72" ObjectFit="ObjectFit.Cover" Class="rounded" />
            }
            <MudFileUpload T="IBrowserFile" FilesChanged="OnImagenSeleccionadaAsync" Accept=".jpg,.jpeg,.png,.webp,.gif">
                <CustomContent Context="subidor">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Image" OnClick="@(() => subidor.OpenFilePickerAsync())">
                        @(string.IsNullOrEmpty(_form.ImagenUrl) ? "Seleccionar imagen" : "Cambiar imagen")
                    </MudButton>
                </CustomContent>
            </MudFileUpload>
            @if (!string.IsNullOrEmpty(_form.ImagenUrl))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => _form.ImagenUrl = null" />
            }
        </div>

        <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Códigos de barra</MudText>
        <div class="d-flex gap-2 align-center mb-2">
            <MudTextField T="string" Label="Agregar código de barra" @bind-Value="_nuevoCodigoBarra" Immediate="true"
                           @onkeydown="OnKeyDownCodigoBarra" Style="flex:1" />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="AgregarCodigoBarra">Agregar</MudButton>
        </div>
        <div class="d-flex flex-wrap gap-1 mb-3">
            @foreach (var codigo in _form.CodigosBarra)
            {
                <MudChip T="string" Size="Size.Small" OnClose="() => _form.CodigosBarra.Remove(codigo)">@codigo</MudChip>
            }
        </div>

        <MudSelect T="TipoProducto" Label="Tipo" @bind-Value="_form.TipoProducto" Class="mb-2" Disabled="_editandoEsCombo">
            <MudSelectItem Value="TipoProducto.Vendible">Vendible</MudSelectItem>
            <MudSelectItem Value="TipoProducto.Insumo">Insumo</MudSelectItem>
        </MudSelect>
        @if (_editandoEsCombo)
        {
            <MudAlert Severity="Severity.Info" Class="mb-2" Dense="true">Un combo no puede cambiar de tipo.</MudAlert>
        }
        else if (_productoId is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2" Dense="true">
                Si cambias el tipo: pasar a Insumo borra la receta actual; pasar a Vendible
                requiere configurar receta o marcarlo Inventariable. El sistema no deja
                cambiarlo si otro producto depende de este (como insumo de una receta o
                componente de un combo).
            </MudAlert>
        }

        <div class="d-flex gap-2 align-center mb-2">
            <MudSelect T="Guid" Label="Categoría" @bind-Value="_form.CategoriaId" Style="flex:1">
                @foreach (var categoria in _categorias)
                {
                    <MudSelectItem Value="@categoria.Id">@categoria.Nombre</MudSelectItem>
                }
            </MudSelect>
            <MudTooltip Text="Nueva categoría">
                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AbrirNuevaCategoria" />
            </MudTooltip>
        </div>

        <MudNumericField T="decimal" Label="Precio" @bind-Value="_form.Precio" Min="0" Class="mb-2" />
        <MudNumericField T="decimal?" Label="Costo unitario (opcional)" @bind-Value="_form.CostoUnitario" Min="0" Class="mb-2" />

        <div class="d-flex gap-2 align-center mb-2">
            <MudSelect T="Guid" Label="Unidad de medida" @bind-Value="_form.UnidadMedidaId" Style="flex:1">
                @foreach (var unidad in _unidadesMedida)
                {
                    <MudSelectItem Value="@unidad.Id">@unidad.Nombre</MudSelectItem>
                }
            </MudSelect>
            <MudTooltip Text="Nueva unidad de medida">
                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AbrirNuevaUnidadMedida" />
            </MudTooltip>
        </div>

        <MudSelect T="decimal" Label="Tasa de ITBIS" @bind-Value="_form.TasaItbis" Class="mb-2">
            <MudSelectItem Value="0.18m">18% (general)</MudSelectItem>
            <MudSelectItem Value="0.16m">16%</MudSelectItem>
            <MudSelectItem Value="0m">0% (tasa cero)</MudSelectItem>
        </MudSelect>

        @if (_form.TipoProducto == TipoProducto.Insumo)
        {
            <MudAlert Severity="Severity.Info" Class="mb-2" Dense="true">
                El stock y sus umbrales mínimo/máximo se configuran por sucursal desde Inventario.
            </MudAlert>
        }
        else
        {
            <MudCheckBox T="bool" Value="_form.Inventariable" ValueChanged="OnInventariableChanged" Label="Inventariable (producto de reventa, sin preparación)" Class="mb-1" />
            @if (_form.Inventariable)
            {
                <MudAlert Severity="Severity.Info" Class="mb-2" Dense="true">
                    Se vende tal cual, sin receta — lleva su propio stock, igual que un insumo
                    (ej. agua embotellada, refresco enlatado). Se configura desde Inventario.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mb-2" Dense="true">
                    Se prepara combinando insumos — su stock se descuenta de la receta (ícono
                    de cubiertos en la tabla), no lleva stock propio.
                </MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editando = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Guardar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_editandoReceta" Options="_opcionesDialogoGrande">
    <TitleContent>Receta — @_form.Nombre</TitleContent>
    <DialogContent>
        @foreach (var linea in _form.Receta)
        {
            <div class="d-flex align-center gap-2 mb-2">
                <MudAutocomplete T="ProductoDetalleDto" Label="Insumo" Value="ObtenerInsumoPorId(linea.InsumoId)"
                                  ValueChanged="v => linea.InsumoId = v?.Id ?? Guid.Empty"
                                  SearchFunc="BuscarInsumosAsync"
                                  ToStringFunc="@(p => p is null ? string.Empty : $"{p.Codigo} — {p.Nombre}")"
                                  Style="flex:2" />
                <MudNumericField T="decimal" Label="Cantidad" @bind-Value="linea.CantidadUsada" Min="0.001m" Step="0.1m" Style="flex:1" />
                <MudCheckBox T="bool" @bind-Value="linea.Opcional" Label="Opcional" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="() => _form.Receta.Remove(linea)" />
            </div>
        }
        <MudButton Size="Size.Small" OnClick="() => _form.Receta.Add(new IngredienteRequestDto())">
            + Agregar ingrediente
        </MudButton>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editandoReceta = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarRecetaAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Guardar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_editandoCombo" Options="_opcionesDialogoGrande">
    <TitleContent>@(_comboIdEditando is null ? "Nuevo combo" : "Editar combo")</TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Nombre del combo" @bind-Value="_formCombo.Nombre" Class="mb-2" />
        <MudTextField T="string" Label="Código (único)" @bind-Value="_formCombo.Codigo" Class="mb-2" Required="true" />
        <MudNumericField T="decimal" Label="Precio del combo" @bind-Value="_formCombo.Precio" Min="0" Class="mb-2" />

        <div class="d-flex gap-2 align-center mb-2">
            <MudSelect T="Guid" Label="Categoría" @bind-Value="_formCombo.CategoriaId" Style="flex:1">
                @foreach (var categoria in _categorias)
                {
                    <MudSelectItem Value="@categoria.Id">@categoria.Nombre</MudSelectItem>
                }
            </MudSelect>
            <MudTooltip Text="Nueva categoría">
                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AbrirNuevaCategoria" />
            </MudTooltip>
        </div>

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Componentes</MudText>
        @foreach (var componente in _formCombo.Componentes)
        {
            <div class="d-flex align-center gap-2 mb-2">
                <MudAutocomplete T="ProductoDetalleDto" Label="Producto" Value="ObtenerVendiblePorId(componente.ProductoIncluidoId)"
                                  ValueChanged="v => componente.ProductoIncluidoId = v?.Id ?? Guid.Empty"
                                  SearchFunc="BuscarVendiblesParaComboAsync"
                                  ToStringFunc="@(p => p is null ? string.Empty : $"{p.Codigo} — {p.Nombre}")"
                                  Style="flex:2" />
                <MudNumericField T="decimal" Label="Cantidad" @bind-Value="componente.Cantidad" Min="1" Style="flex:1" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="() => _formCombo.Componentes.Remove(componente)" />
            </div>
        }
        <MudButton Size="Size.Small" OnClick="() => _formCombo.Componentes.Add(new ComponenteComboRequestDto())">
            + Agregar componente
        </MudButton>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => { _editandoCombo = false; _comboIdEditando = null; }">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarComboAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Guardar combo</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_creandoCategoria" Options="_opcionesDialogo">
    <TitleContent>Nueva categoría</TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Nombre" @bind-Value="_formCategoria.Nombre" Class="mb-2" />
        <MudNumericField T="int" Label="Orden" @bind-Value="_formCategoria.Orden" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _creandoCategoria = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarCategoriaAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Crear</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_creandoUnidadMedida" Options="_opcionesDialogo">
    <TitleContent>Nueva unidad de medida</TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Nombre" @bind-Value="_formUnidadMedida.Nombre" Class="mb-2" />
