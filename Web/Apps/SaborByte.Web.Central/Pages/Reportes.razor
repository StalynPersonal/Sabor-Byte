@page "/reportes"
@using System.Text
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion

<PageTitle>SaborByte</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-2">
        <MudText Typo="Typo.h5">Reportes</MudText>
        <div class="d-flex flex-wrap gap-2 align-center">
            @if (Sesion.SucursalesPermitidas.Count > 1)
            {
                <MudSelect T="Guid" Label="Sucursal" Value="_sucursalIdSeleccionada" ValueChanged="OnSucursalCambiadaAsync" Style="min-width:200px">
                    @foreach (var sucursal in Sesion.SucursalesPermitidas)
                    {
                        <MudSelectItem Value="@sucursal.Id">@sucursal.Nombre</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudDatePicker Label="Desde" @bind-Date="_desde" Style="min-width:180px" />
            <MudDatePicker Label="Hasta" @bind-Date="_hasta" Style="min-width:180px" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CargarTodoAsync" Disabled="_cargando">
                @if (_cargando)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Aplicando...</MudText>
                }
                else
                {
                    <MudText>Aplicar</MudText>
                }
            </MudButton>
            <MudButton Href="@UriActual()" download="@ArchivoActual()" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download">
                Exportar a Excel
            </MudButton>
        </div>
    </div>

    <MudSelect T="TipoReporte" Label="Reporte" Value="_reporte" ValueChanged="OnReporteCambiado" Class="mb-4" Style="max-width:400px">
        <MudSelectItem Value="TipoReporte.VentasResumen">Ventas resumidas por fecha</MudSelectItem>
        <MudSelectItem Value="TipoReporte.VentasDetalle">Ventas detalle por fecha</MudSelectItem>
        <MudSelectItem Value="TipoReporte.VentasPorCajero">Ventas por Cajero (resumen)</MudSelectItem>
        <MudSelectItem Value="TipoReporte.VentasPorMesero">Ventas por Mesero (resumen)</MudSelectItem>
        <MudSelectItem Value="TipoReporte.TopProductos">Top productos vendidos</MudSelectItem>
        <MudSelectItem Value="TipoReporte.PorMetodoPago">Ventas por método de pago</MudSelectItem>
        <MudSelectItem Value="TipoReporte.MovimientosInventario">Movimientos de inventario</MudSelectItem>
        <MudSelectItem Value="TipoReporte.CxCPendientes">Cuentas por cobrar pendientes</MudSelectItem>
        <MudSelectItem Value="TipoReporte.CxPPendientes">Cuentas por pagar pendientes</MudSelectItem>
        <MudSelectItem Value="TipoReporte.CxCPagos">Pagos de CxC recibidos</MudSelectItem>
        <MudSelectItem Value="TipoReporte.CxPPagos">Pagos de CxP realizados</MudSelectItem>
    </MudSelect>

    @if (_reporte == TipoReporte.VentasResumen)
    {
        <MudTable Items="_ventasResumen" Hover="true" Dense="true" T="VentaResumenDiaDto">
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>Facturas</MudTh>
                <MudTh>Total vendido</MudTh>
                <MudTh>ITBIS</MudTh>
                <MudTh>Ticket promedio</MudTh>
            </HeaderContent>
            <RowTemplate Context="v">
                <MudTd>@v.Fecha.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@v.CantidadFacturas</MudTd>
                <MudTd>RD$ @v.TotalVendido.ToString("0.00")</MudTd>
                <MudTd>RD$ @v.TotalItbis.ToString("0.00")</MudTd>
                <MudTd>RD$ @v.TicketPromedio.ToString("0.00")</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_reporte == TipoReporte.VentasDetalle)
    {
        <MudTable Items="_ventasDetalle" Hover="true" Dense="true" T="VentaDetalleDto">
            <HeaderContent>
                <MudTh>Factura</MudTh>
                <MudTh>NCF</MudTh>
                <MudTh>Fecha</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Subtotal</MudTh>
                <MudTh>ITBIS</MudTh>
                <MudTh>Descuento</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Formas de pago</MudTh>
                <MudTh>Cajero</MudTh>
                <MudTh>Mesero</MudTh>
            </HeaderContent>
            <RowTemplate Context="v">
                <MudTd>@(v.NumeroFactura ?? "—")</MudTd>
                <MudTd>@(v.NumeroNcf ?? "—")</MudTd>
                <MudTd>@v.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd>@v.ClienteNombre</MudTd>
                <MudTd>RD$ @v.Subtotal.ToString("0.00")</MudTd>
                <MudTd>RD$ @v.Itbis.ToString("0.00")</MudTd>
                <MudTd>RD$ @v.Descuento.ToString("0.00")</MudTd>
                <MudTd>RD$ @v.Total.ToString("0.00")</MudTd>
                <MudTd>@v.FormasPago</MudTd>
                <MudTd>@v.CajeroNombre</MudTd>
                <MudTd>@(v.MeseroNombre ?? "—")</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_reporte == TipoReporte.VentasPorCajero)
    {
        <MudTable Items="_ventasPorCajero" Hover="true" Dense="true" T="VentaPorCajeroDto">
            <HeaderContent>
                <MudTh>Cajero</MudTh>
                <MudTh>Facturas</MudTh>
                <MudTh>Total vendido</MudTh>
                <MudTh>Ticket promedio</MudTh>
            </HeaderContent>
            <RowTemplate Context="v">
                <MudTd>@v.NombreCajero</MudTd>
                <MudTd>@v.CantidadFacturas</MudTd>
                <MudTd>RD$ @v.TotalVendido.ToString("0.00")</MudTd>
                <MudTd>RD$ @v.TicketPromedio.ToString("0.00")</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_reporte == TipoReporte.VentasPorMesero)
    {
        <MudTable Items="_ventasPorMesero" Hover="true" Dense="true" T="VentaPorMeseroDto">
            <HeaderContent>
                <MudTh>Mesero</MudTh>
                <MudTh>Facturas</MudTh>
                <MudTh>Total vendido</MudTh>
                <MudTh>Ticket promedio</MudTh>
            </HeaderContent>
            <RowTemplate Context="v">
                <MudTd>@v.NombreMesero</MudTd>
                <MudTd>@v.CantidadFacturas</MudTd>
                <MudTd>RD$ @v.TotalVendido.ToString("0.00")</MudTd>
                <MudTd>RD$ @v.TicketPromedio.ToString("0.00")</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_reporte == TipoReporte.TopProductos)
    {
        @if (_ventasPorProducto.Count == 0)
        {
            <MudText Typo="Typo.body2">Sin datos en el rango seleccionado.</MudText>
        }
        else
        {
            <MudChart ChartType="ChartType.Bar" ChartSeries="_serieProductos" ChartLabels="_etiquetasProductos"
                      Width="100%" Height="280px" Class="mb-4" />
        }
        <MudTable Items="_ventasPorProducto" Hover="true" Dense="true" T="VentaPorProductoDto">
            <HeaderContent>
                <MudTh>Producto</MudTh>
                <MudTh>Cantidad vendida</MudTh>
                <MudTh>Total vendido</MudTh>
                <MudTh>Utilidad estimada</MudTh>
            </HeaderContent>
            <RowTemplate Context="p">
                <MudTd>@p.NombreProducto</MudTd>
                <MudTd>@p.CantidadVendida.ToString("0.##")</MudTd>
                <MudTd>RD$ @p.TotalVendido.ToString("0.00")</MudTd>
                <MudTd>@(p.UtilidadEstimada.HasValue ? $"RD$ {p.UtilidadEstimada:0.00}" : "—")</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_reporte == TipoReporte.PorMetodoPago)
    {
        <MudTable Items="_ventasPorMetodoPago" Hover="true" Dense="true" T="VentaPorMetodoPagoDto">
            <HeaderContent>
                <MudTh>Método de pago</MudTh>
                <MudTh>Cantidad de pagos</MudTh>
                <MudTh>Total cobrado</MudTh>
            </HeaderContent>
            <RowTemplate Context="v">
                <MudTd>@v.NombreMetodo</MudTd>
                <MudTd>@v.CantidadPagos</MudTd>
                <MudTd>RD$ @v.TotalCobrado.ToString("0.00")</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_reporte == TipoReporte.MovimientosInventario)
    {
        <MudTable Items="_movimientosInventario" Hover="true" Dense="true" T="MovimientoInventarioReporteDto">
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>Insumo</MudTh>
                <MudTh>Tipo</MudTh>
                <MudTh>Cantidad</MudTh>
                <MudTh>Saldo</MudTh>
                <MudTh>Nota</MudTh>
            </HeaderContent>
            <RowTemplate Context="m">
                <MudTd>@m.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd>@m.NombreProducto</MudTd>
                <MudTd>@m.Tipo</MudTd>
                <MudTd>@m.Cantidad.ToString("0.###")</MudTd>
                <MudTd>@m.SaldoResultante.ToString("0.###")</MudTd>
                <MudTd>@m.Nota</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_reporte == TipoReporte.CxCPendientes)
    {
        <MudTable Items="_cxcPendientes" Hover="true" Dense="true" T="CuentaPendienteDto">
            <HeaderContent>
                <MudTh>Cliente</MudTh>
                <MudTh>Monto original</MudTh>
                <MudTh>Saldo pendiente</MudTh>
                <MudTh>Vencimiento</MudTh>
                <MudTh>Estado</MudTh>
            </HeaderContent>
            <RowTemplate Context="c">
                <MudTd>@c.Nombre</MudTd>
                <MudTd>RD$ @c.MontoOriginal.ToString("0.00")</MudTd>
                <MudTd>RD$ @c.SaldoPendiente.ToString("0.00")</MudTd>
                <MudTd>@c.FechaVencimiento.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@c.Estado</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_reporte == TipoReporte.CxPPendientes)
    {
        <MudTable Items="_cxpPendientes" Hover="true" Dense="true" T="CuentaPendienteDto">
            <HeaderContent>
                <MudTh>Proveedor</MudTh>
                <MudTh>Monto original</MudTh>
                <MudTh>Saldo pendiente</MudTh>
                <MudTh>Vencimiento</MudTh>
                <MudTh>Estado</MudTh>
            </HeaderContent>
            <RowTemplate Context="c">
                <MudTd>@c.Nombre</MudTd>
                <MudTd>RD$ @c.MontoOriginal.ToString("0.00")</MudTd>
                <MudTd>RD$ @c.SaldoPendiente.ToString("0.00")</MudTd>
                <MudTd>@c.FechaVencimiento.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@c.Estado</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_reporte == TipoReporte.CxCPagos)
    {
        <MudTable Items="_cxcPagos" Hover="true" Dense="true" T="PagoCuentaReporteDto">
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Monto</MudTh>
                <MudTh>Forma de pago</MudTh>
                <MudTh>N° comprobante</MudTh>
                <MudTh>Registrado por</MudTh>
                <MudTh>Estado</MudTh>
            </HeaderContent>
            <RowTemplate Context="p">
                <MudTd>@p.FechaPago.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd>@p.Nombre</MudTd>
                <MudTd>RD$ @p.Monto.ToString("0.00")</MudTd>
                <MudTd>@p.MetodoPagoNombre</MudTd>
                <MudTd>@(p.NumeroComprobante ?? "—")</MudTd>
                <MudTd>@p.RegistradoPorNombre</MudTd>
                <MudTd>@(p.Anulado ? "Anulado" : "Vigente")</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_reporte == TipoReporte.CxPPagos)
    {
        <MudTable Items="_cxpPagos" Hover="true" Dense="true" T="PagoCuentaReporteDto">
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>Proveedor</MudTh>
                <MudTh>Monto</MudTh>
                <MudTh>Forma de pago</MudTh>
                <MudTh>N° comprobante</MudTh>
                <MudTh>Registrado por</MudTh>
                <MudTh>Estado</MudTh>
            </HeaderContent>
            <RowTemplate Context="p">
                <MudTd>@p.FechaPago.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd>@p.Nombre</MudTd>
                <MudTd>RD$ @p.Monto.ToString("0.00")</MudTd>
                <MudTd>@p.MetodoPagoNombre</MudTd>
                <MudTd>@(p.NumeroComprobante ?? "—")</MudTd>
                <MudTd>@p.RegistradoPorNombre</MudTd>
                <MudTd>@(p.Anulado ? "Anulado" : "Vigente")</MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private enum TipoReporte
    {
        VentasResumen,
        VentasDetalle,
        VentasPorCajero,
        VentasPorMesero,
        TopProductos,
        PorMetodoPago,
        MovimientosInventario,
        CxCPendientes,
        CxPPendientes,
        CxCPagos,
        CxPPagos
    }

    private TipoReporte _reporte = TipoReporte.VentasResumen;
    private bool _cargando;

    private DateTime? _desde = DateTime.Today.AddDays(-30);
    private DateTime? _hasta = DateTime.Today;

    private List<VentaResumenDiaDto> _ventasResumen = [];
    private List<VentaDetalleDto> _ventasDetalle = [];
    private List<VentaPorCajeroDto> _ventasPorCajero = [];
    private List<VentaPorMeseroDto> _ventasPorMesero = [];
    private List<VentaPorProductoDto> _ventasPorProducto = [];
    private List<VentaPorMetodoPagoDto> _ventasPorMetodoPago = [];
    private List<MovimientoInventarioReporteDto> _movimientosInventario = [];
    private List<CuentaPendienteDto> _cxcPendientes = [];
    private List<CuentaPendienteDto> _cxpPendientes = [];
    private List<PagoCuentaReporteDto> _cxcPagos = [];
    private List<PagoCuentaReporteDto> _cxpPagos = [];

    private List<ChartSeries<double>> _serieProductos = [];
    private string[] _etiquetasProductos = [];

    private Guid _sucursalIdSeleccionada;
    private Guid SucursalId => _sucursalIdSeleccionada;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        if (Sesion.RequiereSeleccionSucursal)
        {
            Navegacion.NavigateTo("/seleccionar-sucursal");
            return;
        }

        _sucursalIdSeleccionada = Sesion.SucursalActivaId;
        await CargarTodoAsync();
    }

    private async Task OnSucursalCambiadaAsync(Guid sucursalId)
    {
        _sucursalIdSeleccionada = sucursalId;
        await CargarTodoAsync();
    }

    private void OnReporteCambiado(TipoReporte reporte) => _reporte = reporte;

    // Los DatePicker dan fechas "de calendario" (sin hora) — se convierten al instante UTC
    // que corresponde a esa medianoche en RD, porque FechaEmision se guarda en UTC (ver
    // HorarioRd). Sin esto, el rango quedaba corrido ~4 horas respecto al día real en RD.
    private RangoFechasRequestDto RangoActual() => new()
    {
        Desde = HorarioRd.ADateTimeUtc(_desde ?? DateTime.Today.AddDays(-30)),
        Hasta = HorarioRd.ADateTimeUtc((_hasta ?? DateTime.Today).AddDays(1)).AddSeconds(-1)
    };

    private async Task CargarTodoAsync()
    {
        _cargando = true;
        var rango = RangoActual();

        try
        {
            // Ninguna de estas llamadas depende de otra — se disparan todas a la vez en vez
            // de esperar una por una, para no multiplicar la latencia de red innecesariamente.
            var tareaVentasResumen = ApiClient.VentasResumenPorDiaAsync(SucursalId, rango);
            var tareaVentasDetalle = ApiClient.VentasDetalleAsync(SucursalId, rango);
            var tareaVentasPorCajero = ApiClient.VentasPorCajeroAsync(SucursalId, rango);
            var tareaVentasPorMesero = ApiClient.VentasPorMeseroAsync(SucursalId, rango);
            var tareaVentasPorProducto = ApiClient.VentasPorProductoAsync(SucursalId, rango);
            var tareaVentasPorMetodoPago = ApiClient.VentasPorMetodoPagoAsync(SucursalId, rango);
            var tareaMovimientosInventario = ApiClient.MovimientosInventarioReporteAsync(SucursalId, rango);
            var tareaCxcPendientes = ApiClient.CxCPendientesAsync(SucursalId);
            var tareaCxpPendientes = ApiClient.CxPPendientesAsync(SucursalId);
            var tareaCxcPagos = ApiClient.CxCPagosAsync(SucursalId, rango);
            var tareaCxpPagos = ApiClient.CxPPagosAsync(SucursalId, rango);

            await Task.WhenAll(
                tareaVentasResumen, tareaVentasDetalle, tareaVentasPorCajero, tareaVentasPorMesero, tareaVentasPorProducto, tareaVentasPorMetodoPago,
                tareaMovimientosInventario, tareaCxcPendientes, tareaCxpPendientes, tareaCxcPagos, tareaCxpPagos);

            _ventasResumen = tareaVentasResumen.Result;
            _ventasDetalle = tareaVentasDetalle.Result;
            _ventasPorCajero = tareaVentasPorCajero.Result;
            _ventasPorMesero = tareaVentasPorMesero.Result;
            _ventasPorProducto = tareaVentasPorProducto.Result;
            _ventasPorMetodoPago = tareaVentasPorMetodoPago.Result;
            _movimientosInventario = tareaMovimientosInventario.Result;
            _cxcPendientes = tareaCxcPendientes.Result;
            _cxpPendientes = tareaCxpPendientes.Result;
            _cxcPagos = tareaCxcPagos.Result;
            _cxpPagos = tareaCxpPagos.Result;
        }
        catch (HttpRequestException)
        {
            // Sesión vencida (ver SesionExpiradaHandler) u otro problema de red: no tumbar
            // toda la pantalla, simplemente dejar los reportes en blanco.
            return;
        }
        finally
        {
            _cargando = false;
        }

        // Top 10 por total vendido, para que el gráfico de barras no se sature.
        var top = _ventasPorProducto.Take(10).ToList();
        _etiquetasProductos = top.Select(p => p.NombreProducto).ToArray();
        _serieProductos = [new ChartSeries<double> { Name = "Total vendido (RD$)", Data = top.Select(p => (double)p.TotalVendido).ToArray() }];
    }

    // --- Exportación a CSV (se abre directo en Excel) ---

    private static string EscaparCsv(object? valor)
    {
        var texto = valor?.ToString() ?? string.Empty;
        return texto.Contains(',') || texto.Contains('"') || texto.Contains('\n')
            ? "\"" + texto.Replace("\"", "\"\"") + "\""
            : texto;
    }

    private static string ConstruirCsvUri(string[] encabezados, IEnumerable<IEnumerable<object?>> filas)
    {
        var sb = new StringBuilder();
        sb.AppendLine(string.Join(",", encabezados.Select(EscaparCsv)));
        foreach (var fila in filas)
            sb.AppendLine(string.Join(",", fila.Select(EscaparCsv)));

        // BOM UTF-8 al inicio para que Excel respete tildes/eñes en vez de mostrarlas mal.
        var bytes = new byte[] { 0xEF, 0xBB, 0xBF }.Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        return "data:text/csv;charset=utf-8;base64," + Convert.ToBase64String(bytes);
    }

    private string UriVentasResumen() => ConstruirCsvUri(
        ["Fecha", "Facturas", "Total vendido", "ITBIS", "Ticket promedio"],
        _ventasResumen.Select(v => new object?[] { v.Fecha.ToString("dd/MM/yyyy"), v.CantidadFacturas, v.TotalVendido, v.TotalItbis, v.TicketPromedio }));

    private string UriVentasDetalle() => ConstruirCsvUri(
        ["Factura", "NCF", "Fecha", "Cliente", "Subtotal", "ITBIS", "Descuento", "Total", "Formas de pago", "Cajero", "Mesero"],
        _ventasDetalle.Select(v => new object?[]
        {
            v.NumeroFactura, v.NumeroNcf, v.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm"),
            v.ClienteNombre, v.Subtotal, v.Itbis, v.Descuento, v.Total, v.FormasPago, v.CajeroNombre, v.MeseroNombre
        }));

    private string UriVentasPorCajero() => ConstruirCsvUri(
        ["Cajero", "Facturas", "Total vendido", "Ticket promedio"],
        _ventasPorCajero.Select(v => new object?[] { v.NombreCajero, v.CantidadFacturas, v.TotalVendido, v.TicketPromedio }));

    private string UriVentasPorMesero() => ConstruirCsvUri(
        ["Mesero", "Facturas", "Total vendido", "Ticket promedio"],
        _ventasPorMesero.Select(v => new object?[] { v.NombreMesero, v.CantidadFacturas, v.TotalVendido, v.TicketPromedio }));

    private string UriTopProductos() => ConstruirCsvUri(
        ["Producto", "Cantidad vendida", "Total vendido", "Utilidad estimada"],
        _ventasPorProducto.Select(p => new object?[] { p.NombreProducto, p.CantidadVendida, p.TotalVendido, p.UtilidadEstimada }));

    private string UriPorMetodoPago() => ConstruirCsvUri(
        ["Método de pago", "Cantidad de pagos", "Total cobrado"],
        _ventasPorMetodoPago.Select(v => new object?[] { v.NombreMetodo, v.CantidadPagos, v.TotalCobrado }));

    private string UriMovimientosInventario() => ConstruirCsvUri(
        ["Fecha", "Insumo", "Tipo", "Cantidad", "Saldo", "Nota"],
        _movimientosInventario.Select(m => new object?[]
        {
            m.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm"), m.NombreProducto, m.Tipo, m.Cantidad, m.SaldoResultante, m.Nota
        }));

    private string UriCxCPendientes() => ConstruirCsvUri(
        ["Cliente", "Monto original", "Saldo pendiente", "Vencimiento", "Estado"],
        _cxcPendientes.Select(c => new object?[] { c.Nombre, c.MontoOriginal, c.SaldoPendiente, c.FechaVencimiento.ToString("dd/MM/yyyy"), c.Estado }));

    private string UriCxPPendientes() => ConstruirCsvUri(
        ["Proveedor", "Monto original", "Saldo pendiente", "Vencimiento", "Estado"],
        _cxpPendientes.Select(c => new object?[] { c.Nombre, c.MontoOriginal, c.SaldoPendiente, c.FechaVencimiento.ToString("dd/MM/yyyy"), c.Estado }));

    private string UriCxCPagos() => ConstruirCsvUri(
        ["Fecha", "Cliente", "Monto", "Forma de pago", "N° comprobante", "Registrado por", "Estado"],
        _cxcPagos.Select(p => new object?[]
        {
            p.FechaPago.ToLocalTime().ToString("dd/MM/yyyy HH:mm"), p.Nombre, p.Monto, p.MetodoPagoNombre,
            p.NumeroComprobante, p.RegistradoPorNombre, p.Anulado ? "Anulado" : "Vigente"
        }));

    private string UriCxPPagos() => ConstruirCsvUri(
        ["Fecha", "Proveedor", "Monto", "Forma de pago", "N° comprobante", "Registrado por", "Estado"],
        _cxpPagos.Select(p => new object?[]
        {
            p.FechaPago.ToLocalTime().ToString("dd/MM/yyyy HH:mm"), p.Nombre, p.Monto, p.MetodoPagoNombre,
            p.NumeroComprobante, p.RegistradoPorNombre, p.Anulado ? "Anulado" : "Vigente"
        }));

    private string UriActual() => _reporte switch
    {
        TipoReporte.VentasResumen => UriVentasResumen(),
        TipoReporte.VentasDetalle => UriVentasDetalle(),
        TipoReporte.VentasPorCajero => UriVentasPorCajero(),
        TipoReporte.VentasPorMesero => UriVentasPorMesero(),
        TipoReporte.TopProductos => UriTopProductos(),
        TipoReporte.PorMetodoPago => UriPorMetodoPago(),
        TipoReporte.MovimientosInventario => UriMovimientosInventario(),
        TipoReporte.CxCPendientes => UriCxCPendientes(),
        TipoReporte.CxPPendientes => UriCxPPendientes(),
        TipoReporte.CxCPagos => UriCxCPagos(),
        TipoReporte.CxPPagos => UriCxPPagos(),
        _ => UriVentasResumen()
    };

    private string ArchivoActual() => _reporte switch
    {
        TipoReporte.VentasResumen => "ventas_resumidas.csv",
        TipoReporte.VentasDetalle => "ventas_detalle.csv",
        TipoReporte.VentasPorCajero => "ventas_por_cajero.csv",
        TipoReporte.VentasPorMesero => "ventas_por_mesero.csv",
        TipoReporte.TopProductos => "top_productos.csv",
        TipoReporte.PorMetodoPago => "ventas_por_metodo_pago.csv",
        TipoReporte.MovimientosInventario => "movimientos_inventario.csv",
        TipoReporte.CxCPendientes => "cxc_pendientes.csv",
        TipoReporte.CxPPendientes => "cxp_pendientes.csv",
        TipoReporte.CxCPagos => "cxc_pagos.csv",
        TipoReporte.CxPPagos => "cxp_pagos.csv",
