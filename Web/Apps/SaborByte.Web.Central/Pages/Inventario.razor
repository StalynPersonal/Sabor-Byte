@page "/inventario"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<PageTitle>SaborByte — Central</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-1">Inventario</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Solo aparece aquí lo que lleva stock propio: tus <strong>insumos</strong> (ingredientes de
        las recetas) y los productos que vendes tal cual, sin preparación, marcados como
        <strong>Inventariable</strong> en "Productos" (ej. agua embotellada). Los platos preparados
        no tienen fila propia — su consumo se calcula solo de su receta.
    </MudText>

    @if (_insumosBajoMinimo > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            @_insumosBajoMinimo producto(s) por debajo de su stock mínimo — resaltados en rojo abajo.
        </MudAlert>
    }

    <div class="d-flex flex-wrap justify-space-between align-center mb-3 gap-2">
        <MudTextField T="string" Label="Buscar por nombre, código o código de barra" @bind-Value="_textoBusqueda"
                       Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="CargarStockAsync"
                       Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:320px" />
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.History" OnClick="() => AbrirMovimientosAsync(null)">
                Ver movimientos
            </MudButton>
            <MudTooltip Text="Corregir el conteo (ej. inventario físico, merma, producto dañado) — el monto puede subir o bajar.">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => AbrirFormulario(esAjuste: true)">
                    Registrar ajuste
                </MudButton>
            </MudTooltip>
            <MudTooltip Text="Llegó mercancía nueva (compra a proveedor) — siempre suma al stock actual.">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => AbrirFormulario(esAjuste: false)">
                    Registrar entrada
                </MudButton>
            </MudTooltip>
        </div>
    </div>

    <MudTable Items="_insumos" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Código</MudTh>
            <MudTh>Producto</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Stock actual</MudTh>
            <MudTh>Mínimo</MudTh>
            <MudTh>Máximo</MudTh>
            <MudTh>Costo unitario</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@(context.Codigo ?? "—")</MudTd>
            <MudTd>@context.Nombre</MudTd>
            <MudTd>@(context.TipoProducto == TipoProducto.Insumo ? "Insumo" : "Vendible (reventa)")</MudTd>
            <MudTd Style="@(EsStockBajo(context) ? "color:var(--mud-palette-error); font-weight:bold" : "")">
                @context.StockActual.ToString("0.###") @NombreUnidadMedida(context.UnidadMedidaId)
                @if (EsStockBajo(context))
                {
                    <MudTooltip Text="Por debajo del mínimo configurado">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Error" Class="ml-1" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd>@(context.StockMinimo?.ToString("0.###") ?? "—")</MudTd>
            <MudTd>@(context.StockMaximo?.ToString("0.###") ?? "—")</MudTd>
            <MudTd>@(context.CostoUnitario is decimal c ? $"RD$ {c:0.00}" : "—")</MudTd>
            <MudTd>
                <MudTooltip Text="Configurar mínimo/máximo de esta sucursal">
                    <MudIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small" OnClick="() => AbrirUmbrales(context)" />
                </MudTooltip>
                <MudTooltip Text="Ver movimientos de este producto">
                    <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small" OnClick="() => AbrirMovimientosAsync(context.Id)" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">
                @(string.IsNullOrWhiteSpace(_textoBusqueda)
                    ? "Todavía no tienes insumos ni productos de reventa dados de alta. Créalos desde \"Productos\"."
                    : "Sin resultados para esa búsqueda.")
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

<MudDialog @bind-Visible="_mostrarFormulario" Options="_opcionesDialogo">
    <TitleContent>@(_esAjuste ? "Registrar ajuste de inventario" : "Registrar entrada de inventario")</TitleContent>
    <DialogContent>
        @if (_esAjuste)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Usa esto para corregir el stock a lo que realmente contaste físicamente — el
                sistema calcula la diferencia solo.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Usa esto cuando llega mercancía nueva de un proveedor — siempre suma.
            </MudAlert>
        }

        <MudSelect T="Guid" Label="Producto" @bind-Value="_productoIdSeleccionado" Class="mb-2">
            @foreach (var insumo in _insumos)
            {
                <MudSelectItem Value="@insumo.Id">@insumo.Nombre (stock: @insumo.StockActual.ToString("0.###"))</MudSelectItem>
            }
        </MudSelect>

        @if (_esAjuste)
        {
            <MudNumericField T="decimal" Label="Nuevo stock (conteo real)" @bind-Value="_nuevoStock" Class="mb-2" />
            <MudTextField T="string" Label="Motivo" @bind-Value="_motivo" Class="mb-2" />
        }
        else
        {
            <MudNumericField T="decimal" Label="Cantidad recibida" @bind-Value="_cantidad" Min="0" Class="mb-2" />
            <MudNumericField T="decimal?" Label="Costo unitario (opcional)" @bind-Value="_costoUnitario" Class="mb-2" />
            <MudTextField T="string" Label="Nota (ej. proveedor, factura)" @bind-Value="_nota" Class="mb-2" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _mostrarFormulario = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_mostrarMovimientos" Options="_opcionesDialogoGrande">
    <TitleContent>
        Movimientos @(_productoFiltradoNombre is null ? "" : $"— {_productoFiltradoNombre}")
    </TitleContent>
    <DialogContent>
        @if (_productoFiltradoId is not null)
        {
            <MudButton Size="Size.Small" Class="mb-2" OnClick="() => AbrirMovimientosAsync(null)">Ver todos los productos</MudButton>
        }
        <MudTable @ref="_tablaMovimientos" ServerData="CargarPaginaMovimientosAsync" Hover="true" Dense="true" T="MovimientoInventarioDto">
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>Producto</MudTh>
                <MudTh>Tipo</MudTh>
                <MudTh>Cantidad</MudTh>
                <MudTh>Saldo</MudTh>
                <MudTh>Nota</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd>@context.NombreProducto</MudTd>
                <MudTd>@TextoTipoMovimiento(context.Tipo)</MudTd>
                <MudTd Style="@(context.Cantidad < 0 ? "color:var(--mud-palette-error)" : "color:var(--mud-palette-success)")">
                    @(context.Cantidad > 0 ? "+" : "")@context.Cantidad.ToString("0.###")
                </MudTd>
                <MudTd>@context.SaldoResultante.ToString("0.###")</MudTd>
                <MudTd>@context.Nota</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">Sin movimientos todavía.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _mostrarMovimientos = false">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_editandoUmbrales" Options="_opcionesDialogo">
    <TitleContent>Umbrales de stock — @_insumoUmbrales?.Nombre</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Si el stock actual baja del mínimo, el producto aparece resaltado aquí y en el
            aviso del panel de Inicio.
        </MudText>
        <MudNumericField T="decimal?" Label="Stock mínimo (alerta)" @bind-Value="_umbralMinimo" Class="mb-2" />
        <MudNumericField T="decimal?" Label="Stock máximo" @bind-Value="_umbralMaximo" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editandoUmbrales = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarUmbralesAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _opcionesDialogo = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
    private readonly DialogOptions _opcionesDialogoGrande = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };

    private string _textoBusqueda = string.Empty;
    private List<ProductoDetalleDto> _insumos = [];
    private List<UnidadMedidaDto> _unidadesMedida = [];

    private bool _mostrarMovimientos;
    private MudTable<MovimientoInventarioDto>? _tablaMovimientos;
    private Guid? _productoFiltradoId;
    private string? _productoFiltradoNombre;

    private int _insumosBajoMinimo => _insumos.Count(EsStockBajo);

    private bool _mostrarFormulario;
    private bool _esAjuste;
    private Guid _productoIdSeleccionado;
    private decimal _cantidad;
    private decimal? _costoUnitario;
    private decimal _nuevoStock;
    private string _motivo = string.Empty;
    private string _nota = string.Empty;

    private bool _editandoUmbrales;
    private ProductoDetalleDto? _insumoUmbrales;
    private decimal? _umbralMinimo;
    private decimal? _umbralMaximo;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        _unidadesMedida = await ApiClient.ListarUnidadesMedidaAsync(incluirInactivos: true);
        await CargarStockAsync();
    }

    private async Task CargarStockAsync()
    {
        var sucursalId = Sesion.SucursalActivaId;
        var productos = await ApiClient.ListarInventariablesAsync(sucursalId, _textoBusqueda);
        _insumos = productos.OrderBy(p => p.Nombre).ToList();
    }

    private async Task<TableData<MovimientoInventarioDto>> CargarPaginaMovimientosAsync(TableState estado, CancellationToken ct)
    {
        var resultado = await ApiClient.ListarMovimientosInventarioAsync(
            Sesion.SucursalActivaId, estado.Page + 1, estado.PageSize, _productoFiltradoId);
        return new TableData<MovimientoInventarioDto> { Items = resultado.Items, TotalItems = resultado.TotalRegistros };
    }

    private async Task AbrirMovimientosAsync(Guid? productoId)
    {
        _productoFiltradoId = productoId;
        _productoFiltradoNombre = productoId is null ? null : _insumos.FirstOrDefault(p => p.Id == productoId)?.Nombre;
        _mostrarMovimientos = true;
        await (_tablaMovimientos?.ReloadServerData() ?? Task.CompletedTask);
    }

    private string NombreUnidadMedida(Guid unidadMedidaId) =>
        _unidadesMedida.FirstOrDefault(u => u.Id == unidadMedidaId)?.Nombre ?? "?";

    private static bool EsStockBajo(ProductoDetalleDto p) => p.StockMinimo is decimal min && p.StockActual < min;

    private static string TextoTipoMovimiento(TipoMovimientoInventario tipo) => tipo switch
    {
        TipoMovimientoInventario.Entrada => "Entrada",
        TipoMovimientoInventario.Ajuste => "Ajuste",
        TipoMovimientoInventario.ConsumoVenta => "Venta",
        TipoMovimientoInventario.ReversoCancelacion => "Reverso (cancelación)",
        _ => tipo.ToString()
    };

    private void AbrirFormulario(bool esAjuste)
    {
        _esAjuste = esAjuste;
        _productoIdSeleccionado = _insumos.Count > 0 ? _insumos[0].Id : Guid.Empty;
        _cantidad = 0;
        _costoUnitario = null;
        _nuevoStock = 0;
        _motivo = string.Empty;
        _nota = string.Empty;
        _mostrarFormulario = true;
    }

    private async Task GuardarAsync()
    {
        var sucursalId = Sesion.SucursalActivaId;

        var (exito, error) = _esAjuste
            ? await ApiClient.RegistrarAjusteInventarioAsync(sucursalId, new RegistrarAjusteRequestDto
            {
                ProductoId = _productoIdSeleccionado,
                NuevoStock = _nuevoStock,
                Motivo = _motivo
            })
            : await ApiClient.RegistrarEntradaInventarioAsync(sucursalId, new RegistrarEntradaRequestDto
            {
                ProductoId = _productoIdSeleccionado,
                Cantidad = _cantidad,
                CostoUnitario = _costoUnitario,
                Nota = _nota
            });

        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add(_esAjuste ? "Ajuste registrado." : "Entrada registrada.", Severity.Success);
        _mostrarFormulario = false;
        await CargarStockAsync();
        if (_mostrarMovimientos)
            await (_tablaMovimientos?.ReloadServerData() ?? Task.CompletedTask);
    }

    private void AbrirUmbrales(ProductoDetalleDto insumo)
    {
        _insumoUmbrales = insumo;
        _umbralMinimo = insumo.StockMinimo;
        _umbralMaximo = insumo.StockMaximo;
        _editandoUmbrales = true;
    }

    private async Task GuardarUmbralesAsync()
    {
        var (exito, error) = await ApiClient.ConfigurarUmbralesInventarioAsync(Sesion.SucursalActivaId, new ConfigurarUmbralesRequestDto
        {
            ProductoId = _insumoUmbrales!.Id,
            StockMinimo = _umbralMinimo,
            StockMaximo = _umbralMaximo
        });

        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Umbrales actualizados.", Severity.Success);
        _editandoUmbrales = false;
        await CargarStockAsync();
    }
}
