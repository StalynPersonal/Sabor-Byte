@page "/inventario"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<PageTitle>SaborByte — Central</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Inventario (insumos)</MudText>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => AbrirFormulario(esAjuste: true)">
                Registrar ajuste
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => AbrirFormulario(esAjuste: false)">
                Registrar entrada
            </MudButton>
        </div>
    </div>

    <MudTable Items="_insumos" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Insumo</MudTh>
            <MudTh>Stock actual</MudTh>
            <MudTh>Stock mínimo</MudTh>
            <MudTh>Stock máximo</MudTh>
            <MudTh>Costo unitario</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Nombre</MudTd>
            <MudTd Style="@(EsStockBajo(context) ? "color:var(--mud-palette-error); font-weight:bold" : "")">
                @context.StockActual.ToString("0.###") @NombreUnidadMedida(context.UnidadMedidaId)
            </MudTd>
            <MudTd>@(context.StockMinimo?.ToString("0.###") ?? "-")</MudTd>
            <MudTd>@(context.StockMaximo?.ToString("0.###") ?? "-")</MudTd>
            <MudTd>@(context.CostoUnitario is decimal c ? $"RD$ {c:0.00}" : "-")</MudTd>
            <MudTd>
                <MudTooltip Text="Configurar umbrales de esta sucursal">
                    <MudIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small" OnClick="() => AbrirUmbrales(context)" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.h6" Class="mt-6 mb-2">Movimientos recientes</MudText>
    <MudTable Items="_movimientos" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Insumo</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Cantidad</MudTh>
            <MudTh>Saldo</MudTh>
            <MudTh>Nota</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.FechaHora.ToLocalTime().ToString("dd/MM HH:mm")</MudTd>
            <MudTd>@context.NombreProducto</MudTd>
            <MudTd>@context.Tipo</MudTd>
            <MudTd Style="@(context.Cantidad < 0 ? "color:var(--mud-palette-error)" : "color:var(--mud-palette-success)")">
                @(context.Cantidad > 0 ? "+" : "")@context.Cantidad.ToString("0.###")
            </MudTd>
            <MudTd>@context.SaldoResultante.ToString("0.###")</MudTd>
            <MudTd>@context.Nota</MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDialog @bind-Visible="_mostrarFormulario" Options="_opcionesDialogo">
    <TitleContent>@(_esAjuste ? "Registrar ajuste de inventario" : "Registrar entrada de inventario")</TitleContent>
    <DialogContent>
        <MudSelect T="Guid" Label="Insumo" @bind-Value="_productoIdSeleccionado" Class="mb-2">
            @foreach (var insumo in _insumos)
            {
                <MudSelectItem Value="@insumo.Id">@insumo.Nombre (stock: @insumo.StockActual.ToString("0.###"))</MudSelectItem>
            }
        </MudSelect>

        @if (_esAjuste)
        {
            <MudNumericField T="decimal" Label="Nuevo stock (conteo real)" @bind-Value="_nuevoStock" Class="mb-2" />
            <MudTextField T="string" Label="Motivo" @bind-Value="_motivo" Class="mb-2" />
        }
        else
        {
            <MudNumericField T="decimal" Label="Cantidad recibida" @bind-Value="_cantidad" Min="0" Class="mb-2" />
            <MudNumericField T="decimal?" Label="Costo unitario (opcional)" @bind-Value="_costoUnitario" Class="mb-2" />
            <MudTextField T="string" Label="Nota (ej. proveedor, factura)" @bind-Value="_nota" Class="mb-2" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _mostrarFormulario = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_editandoUmbrales" Options="_opcionesDialogo">
    <TitleContent>Umbrales de stock — @_insumoUmbrales?.Nombre</TitleContent>
    <DialogContent>
        <MudNumericField T="decimal?" Label="Stock mínimo (alerta)" @bind-Value="_umbralMinimo" Class="mb-2" />
        <MudNumericField T="decimal?" Label="Stock máximo" @bind-Value="_umbralMaximo" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editandoUmbrales = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarUmbralesAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _opcionesDialogo = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };

    private List<ProductoDetalleDto> _insumos = [];
    private List<MovimientoInventarioDto> _movimientos = [];
    private List<UnidadMedidaDto> _unidadesMedida = [];

    private bool _mostrarFormulario;
    private bool _esAjuste;
    private Guid _productoIdSeleccionado;
    private decimal _cantidad;
    private decimal? _costoUnitario;
    private decimal _nuevoStock;
    private string _motivo = string.Empty;
    private string _nota = string.Empty;

    private bool _editandoUmbrales;
    private ProductoDetalleDto? _insumoUmbrales;
    private decimal? _umbralMinimo;
    private decimal? _umbralMaximo;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var sucursalId = Sesion.SucursalActivaId;
        var productos = await ApiClient.ListarProductosAsync(1, 500, tipo: TipoProducto.Insumo, sucursalId: sucursalId);
        _insumos = productos.Items.OrderBy(p => p.Nombre).ToList();
        _movimientos = await ApiClient.ListarMovimientosInventarioAsync(sucursalId);
        _unidadesMedida = await ApiClient.ListarUnidadesMedidaAsync(incluirInactivos: true);
    }

    private string NombreUnidadMedida(Guid unidadMedidaId) =>
        _unidadesMedida.FirstOrDefault(u => u.Id == unidadMedidaId)?.Nombre ?? "?";

    private static bool EsStockBajo(ProductoDetalleDto p) => p.StockMinimo is decimal min && p.StockActual < min;

    private void AbrirFormulario(bool esAjuste)
    {
        _esAjuste = esAjuste;
        _productoIdSeleccionado = _insumos.Count > 0 ? _insumos[0].Id : Guid.Empty;
        _cantidad = 0;
        _costoUnitario = null;
        _nuevoStock = 0;
        _motivo = string.Empty;
        _nota = string.Empty;
        _mostrarFormulario = true;
    }

    private async Task GuardarAsync()
    {
        var sucursalId = Sesion.SucursalActivaId;

        var (exito, error) = _esAjuste
            ? await ApiClient.RegistrarAjusteInventarioAsync(sucursalId, new RegistrarAjusteRequestDto
            {
                ProductoId = _productoIdSeleccionado,
                NuevoStock = _nuevoStock,
                Motivo = _motivo
            })
            : await ApiClient.RegistrarEntradaInventarioAsync(sucursalId, new RegistrarEntradaRequestDto
            {
                ProductoId = _productoIdSeleccionado,
                Cantidad = _cantidad,
                CostoUnitario = _costoUnitario,
                Nota = _nota
            });

        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add(_esAjuste ? "Ajuste registrado." : "Entrada registrada.", Severity.Success);
        _mostrarFormulario = false;
        await CargarAsync();
    }

    private void AbrirUmbrales(ProductoDetalleDto insumo)
    {
        _insumoUmbrales = insumo;
        _umbralMinimo = insumo.StockMinimo;
        _umbralMaximo = insumo.StockMaximo;
        _editandoUmbrales = true;
    }

    private async Task GuardarUmbralesAsync()
    {
        var (exito, error) = await ApiClient.ConfigurarUmbralesInventarioAsync(Sesion.SucursalActivaId, new ConfigurarUmbralesRequestDto
        {
            ProductoId = _insumoUmbrales!.Id,
            StockMinimo = _umbralMinimo,
            StockMaximo = _umbralMaximo
        });

        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Umbrales actualizados.", Severity.Success);
        _editandoUmbrales = false;
        await CargarAsync();
    }
}
