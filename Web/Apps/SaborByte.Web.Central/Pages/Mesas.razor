@page "/mesas"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<PageTitle>SaborByte</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="@(_editando ? 7 : 12)">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h5">Mesas</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NuevaMesa" Disabled="_sucursalSeleccionadaId == Guid.Empty">
                    Nueva mesa
                </MudButton>
            </div>

            <MudSelect T="Guid" Label="Sucursal" Value="_sucursalSeleccionadaId" ValueChanged="OnSucursalCambiadaAsync" Class="mb-4" Style="max-width:400px">
                @foreach (var sucursal in _sucursales)
                {
                    <MudSelectItem Value="@sucursal.Id">@sucursal.Nombre</MudSelectItem>
                }
            </MudSelect>

            @if (_mesas.Count == 0)
            {
                <MudText Typo="Typo.body2">No hay mesas registradas.</MudText>
            }
            else
            {
                @foreach (var salonGrupo in _mesas.GroupBy(m => m.Salon ?? "Sin salón"))
                {
                    <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2">@salonGrupo.Key</MudText>
                    <MudGrid>
                        @foreach (var mesa in salonGrupo)
                        {
                            <MudItem xs="6" sm="4" md="3">
                                <MudCard Class="cursor-pointer" Style="@EstiloTarjeta(mesa)" @onclick="() => EditarMesa(mesa)">
                                    <MudCardContent>
                                        <MudText Typo="Typo.subtitle1">Mesa @mesa.Numero</MudText>
                                        <MudText Typo="Typo.body2">Capacidad: @mesa.Capacidad</MudText>
                                        <MudText Typo="Typo.body2">@(mesa.Estado == EstadoMesa.Libre ? "Libre" : "Ocupada")</MudText>
                                        @if (!mesa.Activo)
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Error">Inactiva</MudText>
                                        }
                                    </MudCardContent>
                                    <MudCardActions>
                                        @if (mesa.Estado == EstadoMesa.Ocupada)
                                        {
                                            <MudButton Size="Size.Small" Color="Color.Warning"
                                                       OnClick="@(async (MouseEventArgs e) => await LiberarAsync(mesa.Id))">
                                                Liberar
                                            </MudButton>
                                        }
                                        @if (mesa.Activo)
                                        {
                                            <MudButton Size="Size.Small" Color="Color.Error" Disabled="@(mesa.Estado == EstadoMesa.Ocupada)"
                                                       OnClick="@(async (MouseEventArgs e) => await DesactivarAsync(mesa.Id))">
                                                Desactivar
                                            </MudButton>
                                        }
                                        else
                                        {
                                            <MudButton Size="Size.Small" Color="Color.Success"
                                                       OnClick="@(async (MouseEventArgs e) => await ActivarAsync(mesa.Id))">
                                                Activar
                                            </MudButton>
                                        }
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
            }
        </MudItem>

        @if (_editando)
        {
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">@(_mesaId is null ? "Nueva mesa" : "Editar mesa")</MudText>

                    <MudTextField T="string" Label="Número" @bind-Value="_form.Numero" Required="true" Class="mb-2" />
                    <MudTextField T="string" Label="Salón" @bind-Value="_form.Salon" Required="true" Class="mb-2" />
                    <MudNumericField T="int" Label="Capacidad" @bind-Value="_form.Capacidad" Min="1" Required="true" Class="mb-2" />

                    <div class="d-flex gap-2 mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="_procesando">
                            @if (_procesando)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            }
                            else
                            {
                                <MudText>Guardar</MudText>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="() => _editando = false">Cancelar</MudButton>
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<MesaDto> _mesas = [];
    private List<SucursalResumenDto> _sucursales = [];
    private Guid _sucursalSeleccionadaId;
    private bool _editando;
    private bool _procesando;
    private Guid? _mesaId;
    private GuardarMesaRequestDto _form = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        _sucursales = await ApiClient.ListarSucursalesGestionAsync();
        _sucursalSeleccionadaId = _sucursales.Any(s => s.Id == Sesion.SucursalActivaId)
            ? Sesion.SucursalActivaId
            : _sucursales.FirstOrDefault()?.Id ?? Guid.Empty;

        await CargarAsync();
    }

    private async Task OnSucursalCambiadaAsync(Guid sucursalId)
    {
        _sucursalSeleccionadaId = sucursalId;
        _editando = false;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        if (_sucursalSeleccionadaId == Guid.Empty)
        {
            _mesas = [];
            return;
        }

        _mesas = await ApiClient.ListarMesasAsync(_sucursalSeleccionadaId);
    }

    private static string EstiloTarjeta(MesaDto mesa)
    {
        if (!mesa.Activo)
            return "border-left: 4px solid var(--mud-palette-error); opacity: 0.6";

        return mesa.Estado == EstadoMesa.Ocupada
            ? "border-left: 4px solid var(--mud-palette-warning)"
            : "border-left: 4px solid var(--mud-palette-success)";
    }

    private void NuevaMesa()
    {
        _mesaId = null;
        _form = new GuardarMesaRequestDto();
        _editando = true;
    }

    private void EditarMesa(MesaDto mesa)
    {
        _mesaId = mesa.Id;
        _form = new GuardarMesaRequestDto
        {
            Numero = mesa.Numero,
            Salon = mesa.Salon,
            Capacidad = mesa.Capacidad
        };
        _editando = true;
    }

    private async Task GuardarAsync()
    {
        if (_procesando) return;

        if (string.IsNullOrWhiteSpace(_form.Numero))
        {
            Snackbar.Add("El número es obligatorio.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Salon))
        {
            Snackbar.Add("El salón es obligatorio.", Severity.Error);
            return;
        }

        if (_form.Capacidad <= 0)
        {
            Snackbar.Add("La capacidad debe ser mayor a cero.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            var (exito, error) = _mesaId is null
                ? await ApiClient.CrearMesaAsync(_sucursalSeleccionadaId, _form)
                : await ApiClient.ActualizarMesaAsync(_sucursalSeleccionadaId, _mesaId.Value, _form);

            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
                return;
            }

            Snackbar.Add(_mesaId is null ? "Mesa creada." : "Mesa actualizada.", Severity.Success);
            _editando = false;
            await CargarAsync();
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task LiberarAsync(Guid mesaId)
    {
        await ApiClient.LiberarMesaAsync(_sucursalSeleccionadaId, mesaId);
        Snackbar.Add("Mesa liberada.", Severity.Success);
        await CargarAsync();
    }

    private async Task DesactivarAsync(Guid mesaId)
    {
        var (exito, error) = await ApiClient.DesactivarMesaAsync(_sucursalSeleccionadaId, mesaId);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Mesa desactivada.", Severity.Success);
        await CargarAsync();
    }

    private async Task ActivarAsync(Guid mesaId)
    {
        var (exito, error) = await ApiClient.ActivarMesaAsync(_sucursalSeleccionadaId, mesaId);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Mesa activada.", Severity.Success);
        await CargarAsync();
    }
}
