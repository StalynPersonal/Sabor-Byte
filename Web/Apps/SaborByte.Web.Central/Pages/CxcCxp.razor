@page "/cxccxp"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<PageTitle>SaborByte — Central</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-4">Cuentas por Cobrar / Cuentas por Pagar</MudText>

    <MudTabs>
        <MudTabPanel Text="Por Cobrar">
            <div class="d-flex flex-wrap justify-space-between align-center mt-2 mb-2 gap-2">
                <div class="d-flex align-center gap-4">
                    <MudTextField T="string" Label="Buscar por cliente o RNC/cédula" @bind-Value="_textoCxC"
                                   Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="RecargarCxCAsync"
                                   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width:280px" />
                    <MudCheckBox T="bool" Value="_incluirPagadasCxC" ValueChanged="v => OnIncluirPagadasCxCAsync(v)" Label="Incluir pagadas" />
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AbrirNuevaCxC">
                    Nueva cuenta por cobrar
                </MudButton>
            </div>

            <MudTable @ref="_tablaCxC" ServerData="CargarPaginaCxCAsync" Hover="true" Dense="true" T="CuentaPorCobrarDto">
                <HeaderContent>
                    <MudTh>Cliente</MudTh>
                    <MudTh>Vencimiento</MudTh>
                    <MudTh>Monto original</MudTh>
                    <MudTh>Saldo pendiente</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Registrada por</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="cuenta">
                    <MudTd>@cuenta.ClienteNombre</MudTd>
                    <MudTd>@cuenta.FechaVencimiento.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>RD$ @cuenta.MontoOriginal.ToString("0.00")</MudTd>
                    <MudTd>RD$ @cuenta.SaldoPendiente.ToString("0.00")</MudTd>
                    <MudTd>@TextoEstado(cuenta.Estado)</MudTd>
                    <MudTd>@cuenta.RegistradaPorNombre</MudTd>
                    <MudTd>
                        <MudTooltip Text="Ver pagos">
                            <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small" OnClick="() => VerPagosCxCAsync(cuenta)" />
                        </MudTooltip>
                        @if (cuenta.Estado != EstadoCuenta.Pagada)
                        {
                            <MudTooltip Text="Registrar pago">
                                <MudIconButton Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Color="Color.Primary" OnClick="() => AbrirPagoCxC(cuenta)" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }" InfoFormat="{first_item}-{last_item} de {all_items}" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Por Pagar">
            <div class="d-flex flex-wrap justify-space-between align-center mt-2 mb-2 gap-2">
                <div class="d-flex align-center gap-4">
                    <MudTextField T="string" Label="Buscar por proveedor, RNC o documento" @bind-Value="_textoCxP"
                                   Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="RecargarCxPAsync"
                                   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width:280px" />
                    <MudCheckBox T="bool" Value="_incluirPagadasCxP" ValueChanged="v => OnIncluirPagadasCxPAsync(v)" Label="Incluir pagadas" />
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AbrirNuevaCxP">
                    Nueva cuenta por pagar
                </MudButton>
            </div>

            <MudTable @ref="_tablaCxP" ServerData="CargarPaginaCxPAsync" Hover="true" Dense="true" T="CuentaPorPagarDto">
                <HeaderContent>
                    <MudTh>Proveedor</MudTh>
                    <MudTh>Documento</MudTh>
                    <MudTh>Vencimiento</MudTh>
                    <MudTh>Saldo pendiente</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Registrada por</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="cuenta">
                    <MudTd>@cuenta.ProveedorNombre</MudTd>
                    <MudTd>@cuenta.DocumentoReferencia</MudTd>
                    <MudTd>@cuenta.FechaVencimiento.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>RD$ @cuenta.SaldoPendiente.ToString("0.00")</MudTd>
                    <MudTd>@TextoEstado(cuenta.Estado)</MudTd>
                    <MudTd>@cuenta.RegistradaPorNombre</MudTd>
                    <MudTd>
                        <MudTooltip Text="Ver pagos">
                            <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small" OnClick="() => VerPagosCxPAsync(cuenta)" />
                        </MudTooltip>
                        @if (cuenta.Estado != EstadoCuenta.Pagada)
                        {
                            <MudTooltip Text="Registrar pago">
                                <MudIconButton Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Color="Color.Primary" OnClick="() => AbrirPagoCxP(cuenta)" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }" InfoFormat="{first_item}-{last_item} de {all_items}" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Proveedores">
            <div class="d-flex justify-space-between align-center mt-2 mb-2">
                <MudCheckBox T="bool" Value="_incluirProveedoresInactivos" ValueChanged="v => OnIncluirProveedoresInactivosAsync(v)" Label="Mostrar inactivos" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AbrirNuevoProveedor">
                    Nuevo proveedor
                </MudButton>
            </div>

            <MudTable Items="_proveedoresGestion" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Nombre</MudTh>
                    <MudTh>RNC</MudTh>
                    <MudTh>Teléfono</MudTh>
                    <MudTh>Activo</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.NombreORazonSocial</MudTd>
                    <MudTd>@(context.Rnc ?? "—")</MudTd>
                    <MudTd>@(context.Telefono ?? "—")</MudTd>
                    <MudTd>@(context.Activo ? "Sí" : "No")</MudTd>
                    <MudTd>
                        <MudTooltip Text="Editar">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditarProveedor(context)" />
                        </MudTooltip>
                        @if (context.Activo)
                        {
                            <MudTooltip Text="Desactivar">
                                <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" OnClick="() => AlternarActivoProveedorAsync(context)" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Activar">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" OnClick="() => AlternarActivoProveedorAsync(context)" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
}

<MudDialog @bind-Visible="_creandoCxC" Options="_opcionesDialogo">
    <TitleContent>Nueva cuenta por cobrar</TitleContent>
    <DialogContent>
        <MudAutocomplete T="ClienteDto" Label="Cliente" Value="_clienteCxC" ValueChanged="c => _clienteCxC = c"
                          SearchFunc="BuscarClientesAsync" ToStringFunc="@(c => c?.NombreORazonSocial ?? string.Empty)" Class="mb-2" />

        <MudAutocomplete T="FacturaResumenDto" Label="Factura" Value="_facturaCxC" ValueChanged="f => _facturaCxC = f"
                          SearchFunc="BuscarFacturasAsync" ToStringFunc="@(f => f is null ? string.Empty : $"{f.NumeroNcf} - RD$ {f.Total:0.00}")" Class="mb-2" />

        <MudNumericField T="decimal" Label="Monto" @bind-Value="_formCxC.MontoOriginal" Class="mb-2" />
        <MudDatePicker Label="Fecha de vencimiento" @bind-Date="_fechaVencimientoCxC" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _creandoCxC = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CrearCxCAsync">Crear</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_pagandoCxC" Options="_opcionesDialogo">
    <TitleContent>Registrar pago — saldo RD$ @(_cuentaPagoCxC?.SaldoPendiente.ToString("0.00"))</TitleContent>
    <DialogContent>
        <MudNumericField T="decimal" Label="Monto del pago" @bind-Value="_formPagoCxC.Monto" Class="mb-2" />
        <MudSelect T="Guid" Label="Forma de pago" @bind-Value="_formPagoCxC.MetodoPagoId" Class="mb-2">
            @foreach (var metodo in _metodosPago)
            {
                <MudSelectItem Value="@metodo.Id">@metodo.Nombre</MudSelectItem>
            }
        </MudSelect>
        @if (RequiereComprobante(_formPagoCxC.MetodoPagoId))
        {
            <MudTextField T="string" Label="N° de comprobante" @bind-Value="_formPagoCxC.NumeroComprobante"
                           Required="true" RequiredError="Este método de pago requiere número de comprobante." Class="mb-2" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _pagandoCxC = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmarPagoCxCAsync">Confirmar pago</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_viendoPagos" Options="_opcionesDialogo">
    <TitleContent>Pagos registrados</TitleContent>
    <DialogContent>
        @if (_pagosVistos.Count == 0)
        {
            <MudText Typo="Typo.body2">Todavía no se ha registrado ningún pago para esta cuenta.</MudText>
        }
        else
        {
            <MudTable Items="_pagosVistos" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Monto</MudTh>
                    <MudTh>Forma de pago</MudTh>
                    <MudTh>N° comprobante</MudTh>
                    <MudTh>Registrado por</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.FechaPago.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>RD$ @context.Monto.ToString("0.00")</MudTd>
                    <MudTd>@context.MetodoPagoNombre</MudTd>
                    <MudTd>@(context.NumeroComprobante ?? "—")</MudTd>
                    <MudTd>@context.RegistradoPorNombre</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _viendoPagos = false">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_editandoProveedor" Options="_opcionesDialogo">
    <TitleContent>@(_proveedorId is null ? "Nuevo proveedor" : "Editar proveedor")</TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Nombre" @bind-Value="_formProveedor.NombreORazonSocial" Class="mb-2" />
        <MudTextField T="string" Label="RNC" @bind-Value="_formProveedor.Rnc" Class="mb-2" />
        <MudTextField T="string" Label="Teléfono" @bind-Value="_formProveedor.Telefono" Class="mb-2" />
        @if (_proveedorId is not null)
        {
            <MudCheckBox T="bool" @bind-Value="_formProveedor.Activo" Label="Activo" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editandoProveedor = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarProveedorAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_creandoCxP" Options="_opcionesDialogo">
    <TitleContent>Nueva cuenta por pagar</TitleContent>
    <DialogContent>
        <MudSelect T="Guid" Label="Proveedor" @bind-Value="_formCxP.ProveedorId" Class="mb-2">
            @foreach (var proveedor in _proveedoresActivos)
            {
                <MudSelectItem Value="@proveedor.Id">@proveedor.NombreORazonSocial</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string" Label="Documento de referencia" @bind-Value="_formCxP.DocumentoReferencia" Class="mb-2" />
        <MudNumericField T="decimal" Label="Monto" @bind-Value="_formCxP.MontoOriginal" Class="mb-2" />
        <MudDatePicker Label="Fecha de vencimiento" @bind-Date="_fechaVencimientoCxP" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _creandoCxP = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CrearCxPAsync">Crear</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_pagandoCxP" Options="_opcionesDialogo">
    <TitleContent>Registrar pago — saldo RD$ @(_cuentaPagoCxP?.SaldoPendiente.ToString("0.00"))</TitleContent>
    <DialogContent>
        <MudNumericField T="decimal" Label="Monto del pago" @bind-Value="_formPagoCxP.Monto" Class="mb-2" />
        <MudSelect T="Guid" Label="Forma de pago" @bind-Value="_formPagoCxP.MetodoPagoId" Class="mb-2">
            @foreach (var metodo in _metodosPago)
            {
                <MudSelectItem Value="@metodo.Id">@metodo.Nombre</MudSelectItem>
            }
        </MudSelect>
        @if (RequiereComprobante(_formPagoCxP.MetodoPagoId))
        {
            <MudTextField T="string" Label="N° de comprobante" @bind-Value="_formPagoCxP.NumeroComprobante"
                           Required="true" RequiredError="Este método de pago requiere número de comprobante." Class="mb-2" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _pagandoCxP = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmarPagoCxPAsync">Confirmar pago</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _opcionesDialogo = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };

    private MudTable<CuentaPorCobrarDto>? _tablaCxC;
    private MudTable<CuentaPorPagarDto>? _tablaCxP;
    private bool _incluirPagadasCxC;
    private bool _incluirPagadasCxP;
    private string _textoCxC = string.Empty;
    private string _textoCxP = string.Empty;

    private List<ProveedorDto> _proveedoresActivos = [];
    private List<ProveedorDto> _proveedoresGestion = [];
    private bool _incluirProveedoresInactivos;
    private List<MetodoPagoDto> _metodosPago = [];

    private bool _creandoCxC;
    private ClienteDto? _clienteCxC;
    private FacturaResumenDto? _facturaCxC;
    private CrearCuentaPorCobrarRequestDto _formCxC = new();
    private DateTime? _fechaVencimientoCxC = DateTime.Today.AddDays(30);
    private bool _pagandoCxC;
    private CuentaPorCobrarDto? _cuentaPagoCxC;
    private RegistrarPagoRequestDto _formPagoCxC = new();

    private bool _editandoProveedor;
    private Guid? _proveedorId;
    private GuardarProveedorRequestDto _formProveedor = new();

    private bool _creandoCxP;
    private CrearCuentaPorPagarRequestDto _formCxP = new();
    private DateTime? _fechaVencimientoCxP = DateTime.Today.AddDays(30);
    private bool _pagandoCxP;
    private CuentaPorPagarDto? _cuentaPagoCxP;
    private RegistrarPagoRequestDto _formPagoCxP = new();

    private bool _viendoPagos;
    private List<PagoCuentaDto> _pagosVistos = [];

    private Guid SucursalId => Sesion.SucursalActivaId;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        await CargarProveedoresAsync();
        _metodosPago = await ApiClient.ListarMetodosPagoAsync();
    }

    private async Task CargarProveedoresAsync()
    {
        _proveedoresActivos = await ApiClient.ListarProveedoresAsync(SucursalId);
        _proveedoresGestion = _incluirProveedoresInactivos
            ? await ApiClient.ListarProveedoresAsync(SucursalId, incluirInactivos: true)
            : _proveedoresActivos;
    }

    private async Task<TableData<CuentaPorCobrarDto>> CargarPaginaCxCAsync(TableState estado, CancellationToken ct)
    {
        var resultado = await ApiClient.ListarPorCobrarAsync(SucursalId, estado.Page + 1, estado.PageSize, _incluirPagadasCxC, _textoCxC);
        return new TableData<CuentaPorCobrarDto> { Items = resultado.Items, TotalItems = resultado.TotalRegistros };
    }

    private async Task<TableData<CuentaPorPagarDto>> CargarPaginaCxPAsync(TableState estado, CancellationToken ct)
    {
        var resultado = await ApiClient.ListarPorPagarAsync(SucursalId, estado.Page + 1, estado.PageSize, _incluirPagadasCxP, _textoCxP);
        return new TableData<CuentaPorPagarDto> { Items = resultado.Items, TotalItems = resultado.TotalRegistros };
    }

    private Task RecargarCxCAsync() => _tablaCxC?.ReloadServerData() ?? Task.CompletedTask;
    private Task RecargarCxPAsync() => _tablaCxP?.ReloadServerData() ?? Task.CompletedTask;

    private async Task OnIncluirPagadasCxCAsync(bool valor)
    {
        _incluirPagadasCxC = valor;
        await RecargarCxCAsync();
    }

    private async Task OnIncluirPagadasCxPAsync(bool valor)
    {
        _incluirPagadasCxP = valor;
        await RecargarCxPAsync();
    }

    private async Task OnIncluirProveedoresInactivosAsync(bool valor)
    {
        _incluirProveedoresInactivos = valor;
        await CargarProveedoresAsync();
    }

    private static string TextoEstado(EstadoCuenta estado) => estado switch
    {
        EstadoCuenta.Pendiente => "Pendiente",
        EstadoCuenta.PagadaParcial => "Pagada parcial",
        EstadoCuenta.Pagada => "Pagada",
        EstadoCuenta.Vencida => "Vencida",
        _ => estado.ToString()
    };

    private async Task VerPagosCxCAsync(CuentaPorCobrarDto cuenta)
    {
        _pagosVistos = await ApiClient.ListarPagosPorCobrarAsync(SucursalId, cuenta.Id);
        _viendoPagos = true;
    }

    private async Task VerPagosCxPAsync(CuentaPorPagarDto cuenta)
    {
        _pagosVistos = await ApiClient.ListarPagosPorPagarAsync(SucursalId, cuenta.Id);
        _viendoPagos = true;
    }

    private async Task<IEnumerable<ClienteDto>> BuscarClientesAsync(string texto, CancellationToken ct) =>
        await ApiClient.BuscarClientesAsync(SucursalId, texto);

    private async Task<IEnumerable<FacturaResumenDto>> BuscarFacturasAsync(string texto, CancellationToken ct)
    {
        var resultado = await ApiClient.BuscarFacturasAsync(SucursalId, 1, 20, texto);
        return resultado.Items;
    }

    private void AbrirNuevaCxC()
    {
        _formCxC = new CrearCuentaPorCobrarRequestDto();
        _clienteCxC = null;
        _facturaCxC = null;
        _fechaVencimientoCxC = DateTime.Today.AddDays(30);
        _creandoCxC = true;
    }

    private async Task CrearCxCAsync()
    {
        if (_clienteCxC is null || _facturaCxC is null)
        {
            Snackbar.Add("Selecciona un cliente y una factura.", Severity.Error);
            return;
        }

        _formCxC.ClienteId = _clienteCxC.Id;
        _formCxC.FacturaId = _facturaCxC.Id;
        _formCxC.FechaVencimiento = _fechaVencimientoCxC ?? DateTime.Today.AddDays(30);

        var (exito, error) = await ApiClient.CrearCuentaPorCobrarAsync(SucursalId, _formCxC);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Cuenta por cobrar creada.", Severity.Success);
        _creandoCxC = false;
        await RecargarCxCAsync();
    }

    private void AbrirPagoCxC(CuentaPorCobrarDto cuenta)
    {
        _cuentaPagoCxC = cuenta;
        _formPagoCxC = new RegistrarPagoRequestDto { MetodoPagoId = _metodosPago.FirstOrDefault()?.Id ?? Guid.Empty };
        _pagandoCxC = true;
    }

    private bool RequiereComprobante(Guid metodoPagoId) =>
        _metodosPago.FirstOrDefault(m => m.Id == metodoPagoId)?.RequiereComprobante ?? false;

    private async Task ConfirmarPagoCxCAsync()
    {
        if (_cuentaPagoCxC is null) return;

        if (RequiereComprobante(_formPagoCxC.MetodoPagoId) && string.IsNullOrWhiteSpace(_formPagoCxC.NumeroComprobante))
        {
            Snackbar.Add("Este método de pago requiere número de comprobante.", Severity.Error);
            return;
        }

        var (exito, error) = await ApiClient.PagarCuentaPorCobrarAsync(SucursalId, _cuentaPagoCxC.Id, _formPagoCxC);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Pago registrado.", Severity.Success);
        _pagandoCxC = false;
        await RecargarCxCAsync();
    }

    private void AbrirNuevoProveedor()
    {
        _proveedorId = null;
        _formProveedor = new GuardarProveedorRequestDto();
        _editandoProveedor = true;
    }

    private void EditarProveedor(ProveedorDto proveedor)
    {
        _proveedorId = proveedor.Id;
        _formProveedor = new GuardarProveedorRequestDto
        {
            NombreORazonSocial = proveedor.NombreORazonSocial,
            Rnc = proveedor.Rnc,
            Telefono = proveedor.Telefono,
            Activo = proveedor.Activo
        };
        _editandoProveedor = true;
    }

    private async Task GuardarProveedorAsync()
    {
        if (string.IsNullOrWhiteSpace(_formProveedor.NombreORazonSocial))
        {
            Snackbar.Add("El nombre del proveedor es obligatorio.", Severity.Error);
            return;
        }

        var (exito, error) = _proveedorId is null
            ? await ApiClient.CrearProveedorAsync(SucursalId, _formProveedor)
            : await ApiClient.ActualizarProveedorAsync(SucursalId, _proveedorId.Value, _formProveedor);

        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add(_proveedorId is null ? "Proveedor creado." : "Proveedor actualizado.", Severity.Success);
        _editandoProveedor = false;
        await CargarProveedoresAsync();
    }

    private async Task AlternarActivoProveedorAsync(ProveedorDto proveedor)
    {
        var request = new GuardarProveedorRequestDto
        {
            NombreORazonSocial = proveedor.NombreORazonSocial,
            Rnc = proveedor.Rnc,
            Telefono = proveedor.Telefono,
            Activo = !proveedor.Activo
        };

        var (exito, error) = await ApiClient.ActualizarProveedorAsync(SucursalId, proveedor.Id, request);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add(request.Activo ? "Proveedor activado." : "Proveedor desactivado.", Severity.Success);
        await CargarProveedoresAsync();
    }

    private void AbrirNuevaCxP()
    {
        _formCxP = new CrearCuentaPorPagarRequestDto();
        _fechaVencimientoCxP = DateTime.Today.AddDays(30);
        _creandoCxP = true;
    }

    private async Task CrearCxPAsync()
    {
        if (_formCxP.ProveedorId == Guid.Empty)
        {
            Snackbar.Add("Selecciona un proveedor.", Severity.Error);
            return;
        }

        _formCxP.FechaVencimiento = _fechaVencimientoCxP ?? DateTime.Today.AddDays(30);

        var (exito, error) = await ApiClient.CrearCuentaPorPagarAsync(SucursalId, _formCxP);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Cuenta por pagar creada.", Severity.Success);
        _creandoCxP = false;
        await RecargarCxPAsync();
    }

    private void AbrirPagoCxP(CuentaPorPagarDto cuenta)
    {
        _cuentaPagoCxP = cuenta;
        _formPagoCxP = new RegistrarPagoRequestDto { MetodoPagoId = _metodosPago.FirstOrDefault()?.Id ?? Guid.Empty };
        _pagandoCxP = true;
    }

    private async Task ConfirmarPagoCxPAsync()
    {
        if (_cuentaPagoCxP is null) return;

        if (RequiereComprobante(_formPagoCxP.MetodoPagoId) && string.IsNullOrWhiteSpace(_formPagoCxP.NumeroComprobante))
        {
            Snackbar.Add("Este método de pago requiere número de comprobante.", Severity.Error);
            return;
        }

        var (exito, error) = await ApiClient.PagarCuentaPorPagarAsync(SucursalId, _cuentaPagoCxP.Id, _formPagoCxP);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Pago registrado.", Severity.Success);
        _pagandoCxP = false;
        await RecargarCxPAsync();
    }
}
