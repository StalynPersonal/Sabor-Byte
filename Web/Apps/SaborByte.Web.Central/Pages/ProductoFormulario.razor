@page "/productos/nuevo"
@page "/productos/editar/{ProductoId:guid}"
@using Microsoft.AspNetCore.Components.Forms
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<PageTitle>SaborByte</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <div class="d-flex align-center gap-2 mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="Volver" />
        <MudText Typo="Typo.h5">@(ProductoId is null ? "Nuevo producto" : "Editar producto")</MudText>
    </div>

    <MudPaper Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Información general</MudText>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Nombre" @bind-Value="_form.Nombre" Class="mb-2" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Código (único)" @bind-Value="_form.Codigo" Class="mb-2" Required="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="Descripción" @bind-Value="_form.Descripcion" Class="mb-2" />
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Códigos de barra</MudText>
                <div class="d-flex gap-2 align-center mb-2">
                    <MudTextField T="string" Label="Agregar código de barra" @bind-Value="_nuevoCodigoBarra" Immediate="true"
                                   @onkeydown="OnKeyDownCodigoBarra" Style="flex:1" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="AgregarCodigoBarra">Agregar</MudButton>
                </div>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var codigo in _form.CodigosBarra)
                    {
                        <MudChip T="string" Size="Size.Small" OnClose="() => _form.CodigosBarra.Remove(codigo)">@codigo</MudChip>
                    }
                </div>
            </MudItem>

            <MudItem xs="12" md="4" Class="d-flex flex-column align-center">
                @if (!string.IsNullOrEmpty(_form.ImagenUrl))
                {
                    <MudImage Src="@_form.ImagenUrl" Width="220" Height="220" ObjectFit="ObjectFit.Cover" Class="rounded mb-2" />
                }
                else
                {
                    <div class="d-flex align-center justify-center rounded mb-2" style="width:220px; height:220px; background-color:var(--mud-palette-background-grey)">
                        <MudIcon Icon="@Icons.Material.Filled.Fastfood" Size="Size.Large" Color="Color.Default" />
                    </div>
                }
                <div class="d-flex align-center gap-2 mb-2">
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnImagenSeleccionadaAsync" Accept=".jpg,.jpeg,.png,.webp,.gif">
                        <CustomContent Context="subidor">
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Image" OnClick="@(() => subidor.OpenFilePickerAsync())">
                                @(string.IsNullOrEmpty(_form.ImagenUrl) ? "Seleccionar imagen" : "Cambiar imagen")
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>
                    @if (!string.IsNullOrEmpty(_form.ImagenUrl))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => _form.ImagenUrl = null" />
                    }
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="display:block; text-align:center">
                    Usa una foto donde el producto llene la mayor parte del encuadre, con poco
                    fondo/espacio en blanco alrededor. Mínimo 600 px en el lado más corto.
                </MudText>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle1" Class="mb-2">Clasificación y precio</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect T="TipoProducto" Label="Tipo" @bind-Value="_form.TipoProducto">
                    <MudSelectItem Value="TipoProducto.Vendible">Vendible</MudSelectItem>
                    <MudSelectItem Value="TipoProducto.Insumo">Insumo</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="8">
                <div class="d-flex gap-2 align-center">
                    <MudSelect T="Guid" Label="Categoría" @bind-Value="_form.CategoriaId" Style="flex:1">
                        @foreach (var categoria in _categorias)
                        {
                            <MudSelectItem Value="@categoria.Id">@categoria.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTooltip Text="Nueva categoría">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AbrirNuevaCategoria" />
                    </MudTooltip>
                </div>
            </MudItem>
            @if (ProductoId is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        Si cambias el tipo: pasar a Insumo borra la receta actual; pasar a Vendible
                        requiere configurar receta o marcarlo Inventariable. El sistema no deja
                        cambiarlo si otro producto depende de este (como insumo de una receta o
                        componente de un combo).
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12" md="4">
                <MudNumericField T="decimal" Label="Precio de venta (con ITBIS incluido)" @bind-Value="_precioConItbis" Min="0" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="decimal?" Label="Costo unitario (opcional)" @bind-Value="_form.CostoUnitario" Min="0" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="decimal" Label="Tasa de ITBIS" @bind-Value="_form.TasaItbis">
                    <MudSelectItem Value="0.18m">18% (general)</MudSelectItem>
                    <MudSelectItem Value="0.16m">16%</MudSelectItem>
                    <MudSelectItem Value="0m">0% (tasa cero)</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <div class="d-flex gap-2 align-center">
                    <MudSelect T="Guid" Label="Unidad de medida" @bind-Value="_form.UnidadMedidaId" Style="flex:1">
                        @foreach (var unidad in _unidadesMedida)
                        {
                            <MudSelectItem Value="@unidad.Id">@unidad.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTooltip Text="Nueva unidad de medida">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AbrirNuevaUnidadMedida" />
                    </MudTooltip>
                </div>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle1" Class="mb-2">Inventario</MudText>
        @if (_form.TipoProducto == TipoProducto.Insumo)
        {
            <MudAlert Severity="Severity.Info" Class="mb-2" Dense="true">
                El stock y sus umbrales mínimo/máximo se configuran por sucursal desde Inventario.
            </MudAlert>
        }
        else
        {
            <MudCheckBox T="bool" Value="_form.Inventariable" ValueChanged="OnInventariableChanged" Label="Inventariable (producto de reventa, sin preparación)" Class="mb-1" />
            @if (_form.Inventariable)
            {
                <MudAlert Severity="Severity.Info" Class="mb-2" Dense="true">
                    Se vende tal cual, sin receta — lleva su propio stock, igual que un insumo
                    (ej. agua embotellada, refresco enlatado). Se configura desde Inventario.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mb-2" Dense="true">
                    Se prepara combinando insumos — su stock se descuenta de la receta, no lleva
                    stock propio.
                </MudAlert>
            }
        }

        @if (_form.TipoProducto == TipoProducto.Insumo || _form.Inventariable)
        {
            <MudCheckBox T="bool" @bind-Value="_form.PermiteVentaConStockNegativo" Label="Permitir venta con stock negativo" Class="mb-1" />
            @if (_form.PermiteVentaConStockNegativo)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2" Dense="true">
                    Se podrá seguir vendiendo aunque el stock llegue a 0 o quede negativo. Por
                    defecto esto está bloqueado para no vender algo que físicamente no existe.
                </MudAlert>
            }
        }

        <div class="d-flex gap-2 mt-4">
            <MudButton OnClick="Volver">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="_procesando">
                @if (_procesando)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <MudText>Guardar</MudText>
                }
            </MudButton>
        </div>
    </MudPaper>
}

<MudDialog @bind-Visible="_creandoCategoria" Options="_opcionesDialogo">
    <TitleContent>Nueva categoría</TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Nombre" @bind-Value="_formCategoria.Nombre" Class="mb-2" />
        <MudNumericField T="int" Label="Orden" @bind-Value="_formCategoria.Orden" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _creandoCategoria = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarCategoriaAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Crear</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_creandoUnidadMedida" Options="_opcionesDialogo">
    <TitleContent>Nueva unidad de medida</TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Nombre" @bind-Value="_formUnidadMedida.Nombre" Required="true" RequiredError="El nombre es obligatorio." Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _creandoUnidadMedida = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarUnidadMedidaAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Crear</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid? ProductoId { get; set; }

    private readonly DialogOptions _opcionesDialogo = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };

    private bool _procesando;
    private GuardarProductoRequestDto _form = new();
    // El formulario le pide al usuario el precio CON ITBIS incluido (lo que el cliente
    // paga) — _form.Precio (neto, lo que se guarda) se calcula a partir de esto recién al
    // guardar, dividiendo por (1 + TasaItbis). El resto del sistema (venta, comanda,
    // carrito, promociones) sigue usando Producto.Precio como neto, sin cambios.
    private decimal _precioConItbis;
    private string _nuevoCodigoBarra = string.Empty;

    private List<CategoriaDto> _categorias = [];
    private List<UnidadMedidaDto> _unidadesMedida = [];

    private bool _creandoCategoria;
    private GuardarCategoriaRequestDto _formCategoria = new();

    private bool _creandoUnidadMedida;
    private GuardarUnidadMedidaRequestDto _formUnidadMedida = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        _categorias = await ApiClient.ListarCategoriasAsync();
        _unidadesMedida = await ApiClient.ListarUnidadesMedidaAsync();

        if (ProductoId is null)
        {
            _form = new GuardarProductoRequestDto
            {
                TipoProducto = TipoProducto.Vendible,
                CategoriaId = _categorias.FirstOrDefault()?.Id ?? Guid.Empty,
                UnidadMedidaId = _unidadesMedida.FirstOrDefault()?.Id ?? Guid.Empty
            };
            _precioConItbis = 0;
            return;
        }

        var producto = await ApiClient.ObtenerProductoAsync(ProductoId.Value);
        if (producto is null || producto.EsCombo)
        {
            // Un combo se edita desde el listado de Productos (diálogo "Editar combo"),
            // no en este formulario — si llegan aquí por error, se regresa al listado.
            Navegacion.NavigateTo("/productos");
            return;
        }

        _form = ConstruirForm(producto);
        _precioConItbis = Math.Round(producto.Precio * (1 + producto.TasaItbis), 2);
    }

    private void Volver() => Navegacion.NavigateTo("/productos");

    private static GuardarProductoRequestDto ConstruirForm(ProductoDetalleDto producto) => new()
    {
        Nombre = producto.Nombre,
        Descripcion = producto.Descripcion,
        Codigo = producto.Codigo ?? string.Empty,
        CodigosBarra = [.. producto.CodigosBarra],
        ImagenUrl = producto.ImagenUrl,
        Precio = producto.Precio,
        CostoUnitario = producto.CostoUnitario,
        TasaItbis = producto.TasaItbis,
        TipoProducto = producto.TipoProducto,
        Inventariable = producto.Inventariable,
        PermiteVentaConStockNegativo = producto.PermiteVentaConStockNegativo,
        UnidadMedidaId = producto.UnidadMedidaId,
        CategoriaId = producto.CategoriaId,
        // Se preserva la receta actual aunque este formulario no la muestre — guardar aquí
        // hace un PUT completo, así que si no se trae tal cual se pisaría con una lista vacía.
        Receta = producto.Receta.Select(r => new IngredienteRequestDto
        {
            InsumoId = r.InsumoId,
            CantidadUsada = r.CantidadUsada,
            IncluidoPorDefecto = r.IncluidoPorDefecto,
            Opcional = r.Opcional
        }).ToList()
    };

    private async Task OnKeyDownCodigoBarra(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AgregarCodigoBarra();
        await Task.CompletedTask;
    }

    private void AgregarCodigoBarra()
    {
        var codigo = _nuevoCodigoBarra.Trim();
        if (!string.IsNullOrEmpty(codigo) && !_form.CodigosBarra.Contains(codigo))
            _form.CodigosBarra.Add(codigo);

        _nuevoCodigoBarra = string.Empty;
    }

    private async Task OnImagenSeleccionadaAsync(IBrowserFile? archivo)
    {
        if (archivo is null)
            return;

        const long maxBytes = 2 * 1024 * 1024;
        if (archivo.Size > maxBytes)
        {
            Snackbar.Add("La imagen no puede superar 2 MB.", Severity.Error);
            return;
        }

        using var stream = archivo.OpenReadStream(maxBytes);
        using var memoria = new MemoryStream();
        await stream.CopyToAsync(memoria);
        _form.ImagenUrl = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}";
    }

    // Inventariable y Receta son mutuamente excluyentes (el backend lo rechaza si llegan
    // juntos) — sin esto, marcar Inventariable en un producto que ya tenía receta configurada
    // guardaba igual el _form.Receta viejo y el guardado fallaba con un error confuso.
    private void OnInventariableChanged(bool valor)
    {
        _form.Inventariable = valor;
        if (valor && _form.Receta.Count > 0)
        {
            _form.Receta.Clear();
            Snackbar.Add("Se borró la receta configurada: un producto Inventariable no puede tener receta.", Severity.Warning);
        }
    }

    private void AbrirNuevaCategoria()
    {
        _formCategoria = new GuardarCategoriaRequestDto();
        _creandoCategoria = true;
    }

    private async Task GuardarCategoriaAsync()
    {
        if (_procesando) return;

        if (string.IsNullOrWhiteSpace(_formCategoria.Nombre))
        {
            Snackbar.Add("El nombre es obligatorio.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            var (exito, error) = await ApiClient.CrearCategoriaAsync(_formCategoria);
            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add("Categoría creada.", Severity.Success);
            _categorias = await ApiClient.ListarCategoriasAsync();
            var nueva = _categorias.FirstOrDefault(c => c.Nombre == _formCategoria.Nombre);
            if (nueva is not null)
                _form.CategoriaId = nueva.Id;

            _creandoCategoria = false;
        }
        finally
        {
            _procesando = false;
        }
    }

    private void AbrirNuevaUnidadMedida()
    {
        _formUnidadMedida = new GuardarUnidadMedidaRequestDto();
        _creandoUnidadMedida = true;
    }

    private async Task GuardarUnidadMedidaAsync()
    {
        if (_procesando) return;

        if (string.IsNullOrWhiteSpace(_formUnidadMedida.Nombre))
        {
            Snackbar.Add("El nombre es obligatorio.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            var (exito, error) = await ApiClient.CrearUnidadMedidaAsync(_formUnidadMedida);
            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add("Unidad de medida creada.", Severity.Success);
            _unidadesMedida = await ApiClient.ListarUnidadesMedidaAsync();
            var nueva = _unidadesMedida.FirstOrDefault(u => u.Nombre == _formUnidadMedida.Nombre);
            if (nueva is not null)
                _form.UnidadMedidaId = nueva.Id;

            _creandoUnidadMedida = false;
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task GuardarAsync()
    {
        if (_procesando) return;
        _procesando = true;
        try
        {
            _form.Precio = Math.Round(_precioConItbis / (1 + _form.TasaItbis), 2);

            var esNuevo = ProductoId is null;
            var (exito, error) = ProductoId is null
                ? await ApiClient.CrearProductoAsync(_form)
                : await ApiClient.ActualizarProductoAsync(ProductoId.Value, _form);

            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add(esNuevo ? "Producto creado." : "Producto actualizado.", Severity.Success);
            Navegacion.NavigateTo("/productos");
        }
        finally
        {
            _procesando = false;
        }
    }
}
