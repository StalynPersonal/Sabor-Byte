@page "/deliveries"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>SaborByte</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Deliveries</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NuevoDelivery">
            Nuevo delivery
        </MudButton>
    </div>

    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Asigna facturas ya emitidas a un delivery para llevar cuenta de cuánto dinero debe
        devolver al negocio (el total de productos), y registra sus abonos parciales.
    </MudText>

    <MudTextField T="string" Label="Buscar por nombre" @bind-Value="_textoBusqueda"
                   Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="CargarAsync" Class="mb-4" Style="max-width:400px" />

    <MudTable Items="_deliveries" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Teléfono</MudTh>
            <MudTh>Saldo pendiente</MudTh>
            <MudTh>Activo</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Nombre</MudTd>
            <MudTd>@(context.Telefono ?? "—")</MudTd>
            <MudTd Style="@(context.SaldoPendiente > 0 ? "color:var(--mud-palette-error); font-weight:bold" : "")">
                RD$ @context.SaldoPendiente.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            </MudTd>
            <MudTd>@(context.Activo ? "Sí" : "No")</MudTd>
            <MudTd>
                <MudTooltip Text="Ver cuenta">
                    <MudIconButton Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" OnClick="() => AbrirCuentaAsync(context)" />
                </MudTooltip>
                <MudTooltip Text="Editar">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditarDelivery(context)" />
                </MudTooltip>
                @if (context.Activo)
                {
                    <MudTooltip Text="Desactivar">
                        <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" OnClick="() => DesactivarAsync(context)" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDialog @bind-Visible="_editando" Options="_opcionesDialogo">
    <TitleContent>@(_deliveryId is null ? "Nuevo delivery" : "Editar delivery")</TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="Nombre" @bind-Value="_form.Nombre" Required="true" Class="mb-2" />
        <MudTextField T="string" Label="Teléfono" @bind-Value="_form.Telefono" Class="mb-2" />
        @if (_deliveryId is not null)
        {
            <MudCheckBox T="bool" @bind-Value="_form.Activo" Label="Activo" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editando = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Guardar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_viendoCuenta" Options="_opcionesDialogoGrande">
    <TitleContent>Cuenta — @_deliverySeleccionado?.Nombre</TitleContent>
    <DialogContent>
        @if (_deliverySeleccionado is not null)
        {
            <MudGrid Class="mb-3">
                <MudItem xs="4">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Total facturado</MudText>
                    <MudText Typo="Typo.body1">RD$ @((_resumenCuenta?.TotalFacturado ?? 0).ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</MudText>
                </MudItem>
                <MudItem xs="4">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Total abonado</MudText>
                    <MudText Typo="Typo.body1">RD$ @((_resumenCuenta?.TotalAbonado ?? 0).ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</MudText>
                </MudItem>
                <MudItem xs="4">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Saldo pendiente</MudText>
                    <MudText Typo="Typo.body1"><strong>RD$ @_deliverySeleccionado.SaldoPendiente.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</strong></MudText>
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-3">
                <MudItem xs="6" sm="4">
                    <MudDatePicker Label="Desde" Date="_desdeCuenta" DateChanged="OnDesdeCuentaCambiadaAsync" Clearable="true" />
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudDatePicker Label="Hasta" Date="_hastaCuenta" DateChanged="OnHastaCuentaCambiadaAsync" Clearable="true" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-space-between align-center mb-1">
                <MudText Typo="Typo.subtitle2">Facturas asignadas</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="AbrirAsignarFactura">Asignar factura</MudButton>
            </div>
            <MudTable @ref="_tablaFacturas" ServerData="CargarPaginaFacturasAsync" Hover="true" Dense="true" Class="mb-4" T="FacturaDeliveryDto">
                <HeaderContent>
                    <MudTh>N° Factura</MudTh>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Productos</MudTh>
                    <MudTh>Delivery</MudTh>
                    <MudTh>Asignada por</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.NumeroFactura</MudTd>
                    <MudTd>@context.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>RD$ @context.MontoFactura.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
                    <MudTd>RD$ @context.MontoDelivery.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
                    <MudTd>@context.AsignadoPorNombre</MudTd>
                    <MudTd>
                        <MudTooltip Text="Reimprimir recibo informativo">
                            <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small" OnClick="() => ImprimirReciboAsync(context)" />
                        </MudTooltip>
                        @if (PuedeGestionarAbonos)
                        {
                            <MudTooltip Text="Quitar asignación">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => QuitarAsignacionAsync(context)" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2">Todavía no hay facturas asignadas.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" InfoFormat="{first_item}-{last_item} de {all_items}" />
                </PagerContent>
            </MudTable>

            <div class="d-flex justify-space-between align-center mb-1">
                <MudText Typo="Typo.subtitle2">Abonos</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_deliverySeleccionado.SaldoPendiente <= 0" OnClick="AbrirRegistrarAbono">Registrar abono</MudButton>
            </div>
            <MudTable @ref="_tablaAbonos" ServerData="CargarPaginaAbonosAsync" Hover="true" Dense="true" T="AbonoDeliveryDto">
                <HeaderContent>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Monto</MudTh>
                    <MudTh>Forma de pago</MudTh>
                    <MudTh>N° comprobante</MudTh>
                    <MudTh>Registrado por</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="@(context.Anulado ? "text-decoration:line-through; opacity:0.6" : "")">@context.FechaPago.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd Style="@(context.Anulado ? "text-decoration:line-through; opacity:0.6" : "")">RD$ @context.Monto.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
                    <MudTd Style="@(context.Anulado ? "text-decoration:line-through; opacity:0.6" : "")">@context.MetodoPagoNombre</MudTd>
                    <MudTd Style="@(context.Anulado ? "text-decoration:line-through; opacity:0.6" : "")">@(context.NumeroComprobante ?? "—")</MudTd>
                    <MudTd>@context.RegistradoPorNombre</MudTd>
                    <MudTd>
                        @if (context.Anulado)
                        {
                            <MudTooltip Text="@($"Anulado por {context.AnuladoPorNombre} — {context.MotivoAnulacion}")">
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">Anulado</MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Vigente</MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        @if (!context.Anulado && PuedeGestionarAbonos)
                        {
                            <MudTooltip Text="Anular abono">
                                <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error" OnClick="() => AbrirAnularAbono(context)" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2">Todavía no se ha registrado ningún abono.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" InfoFormat="{first_item}-{last_item} de {all_items}" />
                </PagerContent>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _viendoCuenta = false">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_asignandoFactura" Options="_opcionesDialogo">
    <TitleContent>Asignar factura</TitleContent>
    <DialogContent>
        <MudAutocomplete T="FacturaAsignableDto" Label="Factura" Value="_facturaAAsignar" ValueChanged="f => _facturaAAsignar = f"
                          SearchFunc="BuscarFacturasAsignablesAsync"
                          ToStringFunc="@(f => f is null ? string.Empty : $"{f.NumeroFactura} - RD$ {f.Total:0.00}")" Class="mb-2" />
        @if (_facturaAAsignar is { YaAsignada: true })
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">
                Esta factura ya está asignada a @_facturaAAsignar.DeliveryNombreActual.
            </MudAlert>
        }
        <MudNumericField T="decimal" Label="Monto del delivery/viaje (opcional)" @bind-Value="_montoDeliveryAsignar" Min="0" Class="mb-2" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Ese monto es informativo (lo que el delivery cobra por el viaje) — no se suma al
            saldo que debe devolver por los productos.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _asignandoFactura = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmarAsignarFacturaAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Asignar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_registrandoAbono" Options="_opcionesDialogo">
    <TitleContent>Registrar abono — saldo RD$ @(_deliverySeleccionado?.SaldoPendiente.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</TitleContent>
    <DialogContent>
        <MudNumericField T="decimal" Label="Monto del abono" @bind-Value="_formAbono.Monto" Class="mb-2" />
        <MudSelect T="Guid" Label="Forma de pago" @bind-Value="_formAbono.MetodoPagoId" Class="mb-2">
            @foreach (var metodo in _metodosPago)
            {
                <MudSelectItem Value="@metodo.Id">@metodo.Nombre</MudSelectItem>
            }
        </MudSelect>
        @if (RequiereComprobante(_formAbono.MetodoPagoId))
        {
            <MudTextField T="string" Label="N° de comprobante" @bind-Value="_formAbono.NumeroComprobante"
                           Required="true" RequiredError="Este método de pago requiere número de comprobante." Class="mb-2" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _registrandoAbono = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmarAbonoAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Confirmar abono</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_anulandoAbono" Options="_opcionesDialogo">
    <TitleContent>Anular abono — RD$ @(_abonoAAnular?.Monto.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            El abono no se borra: queda marcado como anulado (con este motivo, quién y cuándo)
            y su monto vuelve al saldo pendiente del delivery.
        </MudAlert>
        <MudTextField T="string" Label="Motivo de la anulación" @bind-Value="_motivoAnulacion" Lines="2"
                       Required="true" RequiredError="El motivo es obligatorio." Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _anulandoAbono = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmarAnulacionAbonoAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Anular abono</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@if (_reciboAImprimir is not null)
{
    <div class="solo-imprimir @ClaseFormatoImpresion">
        <p style="text-align:center; margin:0; font-weight:bold">RECIBO INFORMATIVO</p>
        <p style="text-align:center; margin:0; font-weight:bold">NO ES UN COMPROBANTE FISCAL</p>
        <hr />
        <p style="margin:0">Factura: @_reciboAImprimir.NumeroFactura</p>
        <p style="margin:0">Fecha: @_reciboAImprimir.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        <p style="margin:0">Delivery: @_deliverySeleccionado?.Nombre</p>
        <hr />
        <div style="display:flex; justify-content:space-between"><span>Productos</span><span>@_reciboAImprimir.MontoFactura.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</span></div>
        <div style="display:flex; justify-content:space-between"><span>Delivery/Flete</span><span>@_reciboAImprimir.MontoDelivery.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</span></div>
        <hr />
        <div style="display:flex; justify-content:space-between; font-weight:bold">
            <span>TOTAL PAGADO</span><span>RD$ @((_reciboAImprimir.MontoFactura + _reciboAImprimir.MontoDelivery).ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</span>
        </div>
        <hr />
        <p style="text-align:center; margin-top:8px; font-size:0.85em">Este recibo es solo informativo, no reemplaza la factura.</p>
        @* Cierre con contenido real (no padding): muchas impresoras térmicas recortan el
           espacio vacío al final para ahorrar papel, pero no pueden recortar contenido ya
           impreso. *@
        <p style="margin:8px 0 0 0">&nbsp;</p>
        <p style="text-align:center; margin:0">------------------------------</p>
        <p style="text-align:center; margin:0; font-weight:bold">FIN DEL DOCUMENTO</p>
    </div>
}

@code {
    private readonly DialogOptions _opcionesDialogo = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
    private readonly DialogOptions _opcionesDialogoGrande = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };

    private List<DeliveryDto> _deliveries = [];
    private string _textoBusqueda = string.Empty;
    private bool _procesando;
    private List<MetodoPagoDto> _metodosPago = [];

    private bool _editando;
    private Guid? _deliveryId;
    private GuardarDeliveryRequestDto _form = new();

    private bool _viendoCuenta;
    private DeliveryDto? _deliverySeleccionado;
    private ResumenCuentaDeliveryDto? _resumenCuenta;
    private DateTime? _desdeCuenta;
    private DateTime? _hastaCuenta;
    private MudTable<FacturaDeliveryDto>? _tablaFacturas;
    private MudTable<AbonoDeliveryDto>? _tablaAbonos;

    private bool _asignandoFactura;
    private FacturaAsignableDto? _facturaAAsignar;
    private decimal _montoDeliveryAsignar;

    private bool _registrandoAbono;
    private RegistrarAbonoDeliveryRequestDto _formAbono = new();

    private bool _anulandoAbono;
    private AbonoDeliveryDto? _abonoAAnular;
    private string _motivoAnulacion = string.Empty;

    private FacturaDeliveryDto? _reciboAImprimir;

    // Formato del recibo informativo: se toma de la caja activa de la sucursal (Central →
    // Cajas). No hay selector aquí — asume una sola caja activa por sucursal.
    private FormatoImpresion _formatoImpresion = FormatoImpresion.Ticket80mm;

    private string ClaseFormatoImpresion => _formatoImpresion switch
    {
        FormatoImpresion.Ticket58mm => "formato-ticket-58mm",
        FormatoImpresion.Carta => "formato-carta",
        _ => "formato-ticket-80mm"
    };

    private bool PuedeGestionarAbonos => Sesion.Roles.Contains("Admin") || Sesion.Roles.Contains("Supervisor");

    private Guid SucursalId => Sesion.SucursalActivaId;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        if (Sesion.RequiereSeleccionSucursal)
        {
            Navegacion.NavigateTo("/seleccionar-sucursal");
            return;
        }

        _metodosPago = await ApiClient.ListarMetodosPagoAsync();
        var cajas = await ApiClient.ListarCajasAsync(SucursalId);
        if (cajas.Count > 0)
            _formatoImpresion = cajas[0].FormatoImpresion;

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _deliveries = await ApiClient.ListarDeliveriesAsync(SucursalId, incluirInactivos: true, texto: _textoBusqueda);
    }

    private void NuevoDelivery()
    {
        _deliveryId = null;
        _form = new GuardarDeliveryRequestDto();
        _editando = true;
    }

    private void EditarDelivery(DeliveryDto delivery)
    {
        _deliveryId = delivery.Id;
        _form = new GuardarDeliveryRequestDto { Nombre = delivery.Nombre, Telefono = delivery.Telefono, Activo = delivery.Activo };
        _editando = true;
    }

    private async Task GuardarAsync()
    {
        if (_procesando) return;

        if (string.IsNullOrWhiteSpace(_form.Nombre))
        {
            Snackbar.Add("El nombre es obligatorio.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            bool exito;
            string? error;
            if (_deliveryId is null)
                (exito, _, error) = await ApiClient.CrearDeliveryAsync(SucursalId, _form);
            else
                (exito, error) = await ApiClient.ActualizarDeliveryAsync(SucursalId, _deliveryId.Value, _form);

            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add(_deliveryId is null ? "Delivery creado." : "Delivery actualizado.", Severity.Success);
            _editando = false;
            await CargarAsync();
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task DesactivarAsync(DeliveryDto delivery)
    {
        var (exito, error) = await ApiClient.DesactivarDeliveryAsync(SucursalId, delivery.Id);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Delivery desactivado.", Severity.Success);
        await CargarAsync();
    }

    private async Task AbrirCuentaAsync(DeliveryDto delivery)
    {
        _deliverySeleccionado = delivery;
        _desdeCuenta = DateTime.Today;
        _hastaCuenta = DateTime.Today;
        _resumenCuenta = await ApiClient.ObtenerResumenCuentaDeliveryAsync(SucursalId, delivery.Id);
        _viendoCuenta = true;
        // Las tablas ya están montadas (se reusan entre deliveries) — hay que forzar la
        // recarga o seguirían mostrando los datos del delivery visto anteriormente.
        await (_tablaFacturas?.ReloadServerData() ?? Task.CompletedTask);
        await (_tablaAbonos?.ReloadServerData() ?? Task.CompletedTask);
    }

    private async Task RecargarCuentaAsync()
    {
        if (_deliverySeleccionado is null) return;

        // Refresca también el saldo cacheado en la fila del listado.
        _deliveries = await ApiClient.ListarDeliveriesAsync(SucursalId, incluirInactivos: true, texto: _textoBusqueda);
        _deliverySeleccionado = _deliveries.FirstOrDefault(d => d.Id == _deliverySeleccionado.Id) ?? _deliverySeleccionado;

        _resumenCuenta = await ApiClient.ObtenerResumenCuentaDeliveryAsync(SucursalId, _deliverySeleccionado.Id);
        await (_tablaFacturas?.ReloadServerData() ?? Task.CompletedTask);
        await (_tablaAbonos?.ReloadServerData() ?? Task.CompletedTask);
    }

    private Task OnDesdeCuentaCambiadaAsync(DateTime? fecha)
    {
        _desdeCuenta = fecha;
        return RecargarCuentaAsync();
    }

    private Task OnHastaCuentaCambiadaAsync(DateTime? fecha)
    {
        _hastaCuenta = fecha;
        return RecargarCuentaAsync();
    }

    private async Task<TableData<FacturaDeliveryDto>> CargarPaginaFacturasAsync(TableState estado, CancellationToken ct)
    {
        if (_deliverySeleccionado is null)
            return new TableData<FacturaDeliveryDto>();

        var resultado = await ApiClient.ListarFacturasDeliveryAsync(
            SucursalId, _deliverySeleccionado.Id, _desdeCuenta, _hastaCuenta?.Date.AddDays(1).AddSeconds(-1),
            estado.Page + 1, estado.PageSize);
        return new TableData<FacturaDeliveryDto> { Items = resultado.Items, TotalItems = resultado.TotalRegistros };
    }

    private async Task<TableData<AbonoDeliveryDto>> CargarPaginaAbonosAsync(TableState estado, CancellationToken ct)
    {
        if (_deliverySeleccionado is null)
            return new TableData<AbonoDeliveryDto>();

        var resultado = await ApiClient.ListarAbonosDeliveryAsync(
            SucursalId, _deliverySeleccionado.Id, _desdeCuenta, _hastaCuenta?.Date.AddDays(1).AddSeconds(-1),
            estado.Page + 1, estado.PageSize);
        return new TableData<AbonoDeliveryDto> { Items = resultado.Items, TotalItems = resultado.TotalRegistros };
    }

    private void AbrirAsignarFactura()
    {
        _facturaAAsignar = null;
        _montoDeliveryAsignar = 0;
        _asignandoFactura = true;
    }

    private async Task<IEnumerable<FacturaAsignableDto>> BuscarFacturasAsignablesAsync(string texto, CancellationToken ct) =>
        await ApiClient.BuscarFacturasAsignablesDeliveryAsync(SucursalId, texto);

    private async Task ConfirmarAsignarFacturaAsync()
    {
        if (_deliverySeleccionado is null || _procesando) return;

        if (_facturaAAsignar is null)
        {
            Snackbar.Add("Selecciona una factura.", Severity.Error);
            return;
        }

        if (_facturaAAsignar.YaAsignada)
        {
            Snackbar.Add("Esta factura ya está asignada a otro delivery.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            var request = new AsignarFacturaRequestDto { FacturaId = _facturaAAsignar.FacturaId, MontoDelivery = _montoDeliveryAsignar };
            var (exito, error) = await ApiClient.AsignarFacturaADeliveryAsync(SucursalId, _deliverySeleccionado.Id, request);
            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
                return;
            }

            Snackbar.Add("Factura asignada.", Severity.Success);

            // Recibo informativo automático solo si se indicó un monto de delivery — si es
            // 0, no hay nada que informar aparte de la factura misma. Se arma con los datos
            // que ya se tienen a mano (no hace falta buscarla en la tabla paginada).
            if (_montoDeliveryAsignar > 0)
            {
                await ImprimirReciboAsync(new FacturaDeliveryDto
                {
                    FacturaId = _facturaAAsignar.FacturaId,
                    NumeroFactura = _facturaAAsignar.NumeroFactura,
                    FechaEmision = _facturaAAsignar.FechaEmision,
                    MontoFactura = _facturaAAsignar.Total,
                    MontoDelivery = _montoDeliveryAsignar
                });
            }

            _asignandoFactura = false;
            await RecargarCuentaAsync();
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task QuitarAsignacionAsync(FacturaDeliveryDto factura)
    {
        if (_deliverySeleccionado is null) return;

        var (exito, error) = await ApiClient.QuitarAsignacionFacturaDeliveryAsync(SucursalId, _deliverySeleccionado.Id, factura.Id);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Asignación eliminada.", Severity.Success);
        await RecargarCuentaAsync();
    }

    private async Task ImprimirReciboAsync(FacturaDeliveryDto factura)
    {
        _reciboAImprimir = factura;
        StateHasChanged();
        // Sin esta espera, "print" a veces se dispara antes de que el navegador termine de
        // pintar el recibo (mismo problema que en Caja al reimprimir tickets).
        await Task.Delay(50);
        await JS.InvokeVoidAsync("print");
        _reciboAImprimir = null;
    }

    private bool RequiereComprobante(Guid metodoPagoId) =>
        _metodosPago.FirstOrDefault(m => m.Id == metodoPagoId)?.RequiereComprobante ?? false;

    private void AbrirRegistrarAbono()
    {
        _formAbono = new RegistrarAbonoDeliveryRequestDto { MetodoPagoId = _metodosPago.FirstOrDefault()?.Id ?? Guid.Empty };
        _registrandoAbono = true;
    }

    private async Task ConfirmarAbonoAsync()
    {
        if (_deliverySeleccionado is null || _procesando) return;

        if (RequiereComprobante(_formAbono.MetodoPagoId) && string.IsNullOrWhiteSpace(_formAbono.NumeroComprobante))
        {
            Snackbar.Add("Este método de pago requiere número de comprobante.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            var (exito, error) = await ApiClient.RegistrarAbonoDeliveryAsync(SucursalId, _deliverySeleccionado.Id, _formAbono);
            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
                return;
            }

            Snackbar.Add("Abono registrado.", Severity.Success);
            _registrandoAbono = false;
            await RecargarCuentaAsync();
        }
        finally
        {
            _procesando = false;
        }
    }

    private void AbrirAnularAbono(AbonoDeliveryDto abono)
    {
        _abonoAAnular = abono;
        _motivoAnulacion = string.Empty;
        _anulandoAbono = true;
    }

    private async Task ConfirmarAnulacionAbonoAsync()
    {
        if (_deliverySeleccionado is null || _abonoAAnular is null || _procesando) return;

        if (string.IsNullOrWhiteSpace(_motivoAnulacion))
        {
            Snackbar.Add("El motivo de la anulación es obligatorio.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            var request = new AnularAbonoDeliveryRequestDto { Motivo = _motivoAnulacion };
            var (exito, error) = await ApiClient.AnularAbonoDeliveryAsync(SucursalId, _deliverySeleccionado.Id, _abonoAAnular.Id, request);
            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
                return;
            }

            Snackbar.Add("Abono anulado.", Severity.Success);
            _anulandoAbono = false;
            await RecargarCuentaAsync();
        }
        finally
        {
            _procesando = false;
        }
    }
}
