@page "/cotizaciones"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>SaborByte</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Cotizaciones</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NuevaCotizacion">
            Nueva cotización
        </MudButton>
    </div>

    <MudPaper Class="pa-3 mb-3">
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" Label="Buscar por cliente" @bind-Value="_textoBusqueda"
                               Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="RecargarAsync"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="EstadoCotizacion?" Label="Estado" Value="_filtroEstado" ValueChanged="OnFiltroEstadoCambiadoAsync" Clearable="true">
                    <MudSelectItem Value="@((EstadoCotizacion?)null)">Todos</MudSelectItem>
                    <MudSelectItem Value="@((EstadoCotizacion?)EstadoCotizacion.Pendiente)">Pendiente</MudSelectItem>
                    <MudSelectItem Value="@((EstadoCotizacion?)EstadoCotizacion.Aceptada)">Aceptada</MudSelectItem>
                    <MudSelectItem Value="@((EstadoCotizacion?)EstadoCotizacion.Rechazada)">Rechazada</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudDatePicker Label="Creado desde" Date="_desde" DateChanged="OnFiltroFechaCambiadoAsync" Clearable="true" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudDatePicker Label="Creado hasta" Date="_hasta" DateChanged="OnFiltroFechaHastaCambiadoAsync" Clearable="true" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable @ref="_tabla" ServerData="CargarPaginaAsync" Hover="true" Dense="true" T="CotizacionResumenDto">
        <HeaderContent>
            <MudTh>Cliente</MudTh>
            <MudTh>Creado</MudTh>
            <MudTh>Vencimiento</MudTh>
            <MudTh>Ítems</MudTh>
            <MudTh>Total estimado</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.ClienteNombre</MudTd>
            <MudTd>@context.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@(context.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</MudTd>
            <MudTd>@context.CantidadItems</MudTd>
            <MudTd>RD$ @context.Total.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@ColorEstado(context.Estado)">@TextoEstado(context.Estado)</MudChip>
                @if (context.YaCargadaEnCarrito)
                {
                    <MudTooltip Text="Ya se cargó al menos una vez en un carrito de Caja">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="ml-1" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="Ver detalle">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="() => VerDetalleAsync(context.Id)" />
                </MudTooltip>
                <MudTooltip Text="Editar">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditarAsync(context.Id)" />
                </MudTooltip>
                @if (context.Estado == EstadoCotizacion.Pendiente)
                {
                    <MudTooltip Text="Marcar aceptada">
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                       OnClick="() => CambiarEstadoAsync(context.Id, EstadoCotizacion.Aceptada)" />
                    </MudTooltip>
                    <MudTooltip Text="Marcar rechazada">
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                       OnClick="() => CambiarEstadoAsync(context.Id, EstadoCotizacion.Rechazada)" />
                    </MudTooltip>
                }
                <MudTooltip Text="Eliminar">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => EliminarAsync(context.Id)" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
}

<MudDialog @bind-Visible="_editando" Options="_opcionesDialogoGrande">
    <TitleContent>@(_cotizacionId is null ? "Nueva cotización" : "Editar cotización")</TitleContent>
    <DialogContent>
        <div class="d-flex gap-1 align-end mb-2">
            <MudAutocomplete T="ClienteDto" Label="Cliente (si ya está registrado)" Value="_clienteSeleccionado"
                              ValueChanged="OnClienteSeleccionado" SearchFunc="BuscarClientesAsync"
                              ToStringFunc="@(c => c is null ? string.Empty : $"{c.NombreORazonSocial} ({c.RncOCedula})")"
                              Clearable="true" Style="flex:1" />
        </div>
        <MudGrid Class="mb-2">
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Nombre del cliente" @bind-Value="_form.ClienteNombre" Required="true" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudTextField T="string" Label="Teléfono" @bind-Value="_form.ClienteTelefono" Required="true" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudDatePicker Label="Vence el" Date="_form.FechaVencimiento" DateChanged="d => _form.FechaVencimiento = d" />
            </MudItem>
        </MudGrid>

        <MudTextField T="string" Label="Notas / condiciones" @bind-Value="_form.Notas" Lines="2" Class="mb-3" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">Productos</MudText>
        @foreach (var item in _form.Items)
        {
            <div class="d-flex align-center gap-2 mb-2">
                <MudAutocomplete T="ProductoDetalleDto" Label="Producto" Value="ObtenerProductoPorId(item.ProductoId)"
                                  ValueChanged="p => item.ProductoId = p?.Id ?? Guid.Empty"
                                  SearchFunc="BuscarProductosAsync"
                                  ToStringFunc="@(p => p is null ? string.Empty : $"{p.Codigo} — {p.Nombre}")"
                                  Style="flex:2" />
                <MudNumericField T="decimal" Label="Cantidad" @bind-Value="item.Cantidad" Min="1" Style="flex:1" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="() => _form.Items.Remove(item)" />
            </div>
        }
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => _form.Items.Add(new ItemCotizacionRequestDto { Cantidad = 1 })">
            + Agregar producto
        </MudButton>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editando = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="_procesando">
            @if (_procesando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Guardar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_viendoDetalle" Options="_opcionesDialogoGrande">
    <TitleContent>Detalle de cotización</TitleContent>
    <DialogContent>
        @if (_detalle is not null)
        {
            <MudText><strong>Cliente:</strong> @_detalle.ClienteNombre</MudText>
            <MudText><strong>Teléfono:</strong> @_detalle.ClienteTelefono</MudText>
            <MudText><strong>Creado:</strong> @_detalle.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm") @(string.IsNullOrWhiteSpace(_detalle.CreadoPorNombre) ? "" : $"por {_detalle.CreadoPorNombre}")</MudText>
            <MudText><strong>Vence el:</strong> @(_detalle.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</MudText>
            <MudText Class="mb-2"><strong>Estado:</strong> <MudChip T="string" Size="Size.Small" Color="@ColorEstado(_detalle.Estado)">@TextoEstado(_detalle.Estado)</MudChip></MudText>
            @if (!string.IsNullOrWhiteSpace(_detalle.Notas))
            {
                <MudText Class="mb-2"><strong>Notas:</strong> @_detalle.Notas</MudText>
            }

            <MudTable Items="_detalle.Items" Dense="true" Hover="true" Class="mb-2">
                <HeaderContent>
                    <MudTh>Producto</MudTh>
                    <MudTh>Cantidad</MudTh>
                    <MudTh>Precio</MudTh>
                    <MudTh>Subtotal</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd>@item.NombreProducto</MudTd>
                    <MudTd>@item.Cantidad</MudTd>
                    <MudTd>RD$ @item.Precio.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</MudTd>
                    <MudTd>RD$ @((item.Precio * item.Cantidad * (1 + item.TasaItbis)).ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</MudTd>
                </RowTemplate>
            </MudTable>
            <MudText Typo="Typo.h6" Class="d-flex justify-end">Total estimado: RD$ @TotalDetalle.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _viendoDetalle = false">Cerrar</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ImprimirDetalleAsync">Imprimir</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RecrearDesdeDetalleAsync">Recrear</MudButton>
    </DialogActions>
</MudDialog>

@* ===== IMPRESIÓN DE LA COTIZACIÓN (solo visible al imprimir) ===== *@
@if (_detalle is not null)
{
    <div class="solo-imprimir @ClaseFormatoImpresion">
        <p style="text-align:center; margin:0; font-weight:bold">COTIZACIÓN</p>
        <hr />
        <p style="margin:0">Cliente: @_detalle.ClienteNombre</p>
        <p style="margin:0">Teléfono: @_detalle.ClienteTelefono</p>
        <p style="margin:0">Fecha: @_detalle.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy")</p>
        <p style="margin:0">Vence el: @(_detalle.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</p>
        <hr />
        <p style="text-align:center; margin:0; font-weight:bold">Productos</p>
        <hr />
        @foreach (var item in _detalle.Items)
        {
            <div style="display:flex; justify-content:space-between">
                <span>@item.Cantidad x @item.NombreProducto</span>
                <span>@((item.Precio * item.Cantidad * (1 + item.TasaItbis)).ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</span>
            </div>
        }
        <hr />
        <div style="display:flex; justify-content:space-between; font-weight:bold">
            <span>TOTAL ESTIMADO</span><span>RD$ @TotalDetalle.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</span>
        </div>
        <p style="margin:4px 0 0 0; font-size:0.85em">Los precios ya incluyen impuestos (ITBIS).</p>
        @if (!string.IsNullOrWhiteSpace(_detalle.Notas))
        {
            <hr />
            <p style="margin:0">Notas: @_detalle.Notas</p>
        }
        <p style="text-align:center; margin-top:8px; font-size:0.85em">Presupuesto sujeto a cambios luego de la fecha de vencimiento.</p>
    </div>
}

@code {
    private readonly DialogOptions _opcionesDialogoGrande = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };

    private MudTable<CotizacionResumenDto>? _tabla;
    private string _textoBusqueda = string.Empty;
    private EstadoCotizacion? _filtroEstado;
    private DateTime? _desde;
    private DateTime? _hasta;

    private List<ProductoDetalleDto> _productos = [];

    private bool _editando;
    private bool _procesando;
    private Guid? _cotizacionId;
    private GuardarCotizacionRequestDto _form = new();
    private ClienteDto? _clienteSeleccionado;

    private bool _viendoDetalle;
    private CotizacionDetalleDto? _detalle;
    private decimal TotalDetalle => _detalle?.Items.Sum(i => i.Precio * i.Cantidad * (1 + i.TasaItbis)) ?? 0;

    // Formato del documento impreso: se toma de la caja activa de la sucursal (mismo
    // criterio que el recibo informativo de Deliveries.razor).
    private FormatoImpresion _formatoImpresion = FormatoImpresion.Ticket80mm;

    private string ClaseFormatoImpresion => _formatoImpresion switch
    {
        FormatoImpresion.Ticket58mm => "formato-ticket-58mm",
        FormatoImpresion.Carta => "formato-carta",
        _ => "formato-ticket-80mm"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        if (Sesion.RequiereSeleccionSucursal)
        {
            Navegacion.NavigateTo("/seleccionar-sucursal");
            return;
        }

        var resultado = await ApiClient.ListarProductosAsync(1, 500, incluirInactivos: false, sucursalId: Sesion.SucursalActivaId);
        _productos = resultado.Items;

        var cajas = await ApiClient.ListarCajasAsync(Sesion.SucursalActivaId);
        if (cajas.Count > 0)
            _formatoImpresion = cajas[0].FormatoImpresion;
    }

    private Task RecargarAsync() => _tabla?.ReloadServerData() ?? Task.CompletedTask;

    private async Task OnFiltroEstadoCambiadoAsync(EstadoCotizacion? valor)
    {
        _filtroEstado = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroFechaCambiadoAsync(DateTime? valor)
    {
        _desde = valor;
        await RecargarAsync();
    }

    private async Task OnFiltroFechaHastaCambiadoAsync(DateTime? valor)
    {
        _hasta = valor;
        await RecargarAsync();
    }

    private async Task<TableData<CotizacionResumenDto>> CargarPaginaAsync(TableState estado, CancellationToken ct)
    {
        var sucursalId = Sesion.SucursalActivaId;
        if (sucursalId == Guid.Empty)
            return new TableData<CotizacionResumenDto>();

        var resultado = await ApiClient.ListarCotizacionesAsync(sucursalId, _textoBusqueda, _filtroEstado, estado.Page + 1, estado.PageSize, _desde, _hasta);
        return new TableData<CotizacionResumenDto> { Items = resultado.Items, TotalItems = resultado.TotalRegistros };
    }

    private static Color ColorEstado(EstadoCotizacion estado) => estado switch
    {
        EstadoCotizacion.Aceptada => Color.Success,
        EstadoCotizacion.Rechazada => Color.Error,
        _ => Color.Default
    };

    private static string TextoEstado(EstadoCotizacion estado) => estado switch
    {
        EstadoCotizacion.Aceptada => "Aceptada",
        EstadoCotizacion.Rechazada => "Rechazada",
        _ => "Pendiente"
    };

    private ProductoDetalleDto? ObtenerProductoPorId(Guid id) =>
        id == Guid.Empty ? null : _productos.FirstOrDefault(p => p.Id == id);

    private Task<IEnumerable<ProductoDetalleDto>> BuscarProductosAsync(string texto, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(texto))
            return Task.FromResult(_productos.AsEnumerable());

        var resultado = _productos.Where(p =>
            p.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            (p.Codigo?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false));

        return Task.FromResult(resultado);
    }

    private async Task<IEnumerable<ClienteDto>> BuscarClientesAsync(string texto, CancellationToken ct) =>
        await ApiClient.BuscarClientesAsync(Sesion.SucursalActivaId, texto);

    private void OnClienteSeleccionado(ClienteDto? cliente)
    {
        _clienteSeleccionado = cliente;
        if (cliente is null) return;

        _form.ClienteId = cliente.Id;
        _form.ClienteNombre = cliente.NombreORazonSocial;
        _form.ClienteTelefono = cliente.Telefono;
    }

    private void NuevaCotizacion()
    {
        _cotizacionId = null;
        _clienteSeleccionado = null;
        _form = new GuardarCotizacionRequestDto
        {
            FechaVencimiento = DateTime.Today.AddDays(15),
            Items = [new ItemCotizacionRequestDto { Cantidad = 1 }]
        };
        _editando = true;
    }

    private async Task EditarAsync(Guid id)
    {
        var detalle = await ApiClient.ObtenerCotizacionAsync(Sesion.SucursalActivaId, id);
        if (detalle is null) return;

        _cotizacionId = id;
        _clienteSeleccionado = null;
        _form = new GuardarCotizacionRequestDto
        {
            ClienteId = detalle.ClienteId,
            ClienteNombre = detalle.ClienteNombre,
            ClienteTelefono = detalle.ClienteTelefono,
            FechaVencimiento = detalle.FechaVencimiento,
            Notas = detalle.Notas,
            Items = detalle.Items.Select(i => new ItemCotizacionRequestDto { ProductoId = i.ProductoId, Cantidad = i.Cantidad }).ToList()
        };
        _editando = true;
    }

    private async Task GuardarAsync()
    {
        if (_procesando) return;

        if (string.IsNullOrWhiteSpace(_form.ClienteTelefono))
        {
            Snackbar.Add("El teléfono del cliente es obligatorio.", Severity.Error);
            return;
        }

        if (_form.Items.Count == 0 || _form.Items.Any(i => i.ProductoId == Guid.Empty))
        {
            Snackbar.Add("Agrega al menos un producto válido.", Severity.Error);
            return;
        }

        _procesando = true;
        try
        {
            var sucursalId = Sesion.SucursalActivaId;

            bool exito;
            string? error;
            if (_cotizacionId is null)
                (exito, _, error) = await ApiClient.CrearCotizacionAsync(sucursalId, _form);
            else
                (exito, error) = await ApiClient.ActualizarCotizacionAsync(sucursalId, _cotizacionId.Value, _form);

            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add(_cotizacionId is null ? "Cotización creada." : "Cotización actualizada.", Severity.Success);
            _editando = false;
            await RecargarAsync();
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task CambiarEstadoAsync(Guid id, EstadoCotizacion nuevoEstado)
    {
        var (exito, error) = await ApiClient.CambiarEstadoCotizacionAsync(Sesion.SucursalActivaId, id, nuevoEstado);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Estado actualizado.", Severity.Success);
        await RecargarAsync();
    }

    private async Task VerDetalleAsync(Guid id)
    {
        _detalle = await ApiClient.ObtenerCotizacionAsync(Sesion.SucursalActivaId, id);
        if (_detalle is null) return;

        _viendoDetalle = true;
    }

    private Task ImprimirDetalleAsync() => JS.InvokeVoidAsync("print").AsTask();

    // "Recrear": abre el formulario de Nueva cotización pre-cargado con los mismos datos
    // (cliente, notas, productos y cantidades) pero sin guardar nada todavía — el usuario
    // revisa/ajusta y decide si la crea. Los precios se calculan con el valor ACTUAL del
    // producto recién al guardar (ConstruirDesdeRequestAsync), no con los congelados de la
    // cotización original, y la fecha de vencimiento se reinicia a hoy + 15 días.
    private void RecrearDesdeDetalleAsync()
    {
        if (_detalle is null) return;

        _cotizacionId = null;
        _clienteSeleccionado = null;
        _form = new GuardarCotizacionRequestDto
        {
            ClienteId = _detalle.ClienteId,
            ClienteNombre = _detalle.ClienteNombre,
            ClienteTelefono = _detalle.ClienteTelefono,
            FechaVencimiento = DateTime.Today.AddDays(15),
            Notas = _detalle.Notas,
            Items = _detalle.Items.Select(i => new ItemCotizacionRequestDto { ProductoId = i.ProductoId, Cantidad = i.Cantidad }).ToList()
        };

        // Si algún producto de la cotización original quedó fuera de los primeros 500
        // activos precargados (o ya no está activo), el autocomplete no tendría de dónde
        // mostrar su nombre — se agrega aquí para que ObtenerProductoPorId lo encuentre.
        foreach (var item in _detalle.Items)
        {
            if (!_productos.Any(p => p.Id == item.ProductoId))
                _productos.Add(new ProductoDetalleDto { Id = item.ProductoId, Nombre = item.NombreProducto });
        }

        _viendoDetalle = false;
        _editando = true;
    }

    private async Task EliminarAsync(Guid id)
    {
        var (exito, error) = await ApiClient.EliminarCotizacionAsync(Sesion.SucursalActivaId, id);
        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Cotización eliminada.", Severity.Success);
        await RecargarAsync();
    }
}
