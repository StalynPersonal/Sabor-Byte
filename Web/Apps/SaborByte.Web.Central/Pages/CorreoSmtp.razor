@page "/correo-smtp"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<PageTitle>SaborByte</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-4">Correo saliente (SMTP)</MudText>

    <MudSelect T="Guid" Label="Sucursal" Value="_sucursalSeleccionadaId" ValueChanged="OnSucursalCambiadaAsync" Class="mb-4" Style="max-width:400px">
        @foreach (var sucursal in _sucursales)
        {
            <MudSelectItem Value="@sucursal.Id">@sucursal.Nombre</MudSelectItem>
        }
    </MudSelect>

    @if (_form is not null)
    {
        <MudPaper Class="pa-4" Style="max-width:600px">
            <MudCheckBox T="bool" @bind-Value="_form.SmtpActivo" Label="Activar envío de correo" Class="mb-2" />
            @if (_form.SmtpActivo)
            {
                <MudTextField T="string" Label="Servidor SMTP" @bind-Value="_form.SmtpHost" Class="mb-2" />
                <MudNumericField T="int?" Label="Puerto" @bind-Value="_form.SmtpPuerto" Class="mb-2" />
                <MudTextField T="string" Label="Usuario" @bind-Value="_form.SmtpUsuario" Class="mb-2" />
                <MudTextField T="string" Label="Contraseña (dejar en blanco para no cambiarla)" InputType="InputType.Password" @bind-Value="_form.SmtpPassword" Class="mb-2" />
                <MudTextField T="string" Label="Remitente" @bind-Value="_form.SmtpRemitente" Class="mb-2" />
                <MudCheckBox T="bool" @bind-Value="_form.SmtpUsaSsl" Label="Usar SSL/TLS" Class="mb-2" />
            }

            <div class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="_procesando">
                    @if (_procesando)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudText>Guardar</MudText>
                    }
                </MudButton>
            </div>

            @if (_form.SmtpActivo)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Enviar correo de prueba</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Usa la configuración ya guardada — si acabas de cambiar algo, guarda primero.
                </MudText>
                <div class="d-flex gap-2 align-end flex-wrap">
                    <MudTextField T="string" Label="Correo de destino" @bind-Value="_correoPrueba" Style="max-width:320px" />
                    <MudButton Variant="Variant.Outlined" OnClick="EnviarPruebaAsync" Disabled="_procesandoPrueba || string.IsNullOrWhiteSpace(_correoPrueba)">
                        @if (_procesandoPrueba)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Enviando...</MudText>
                        }
                        else
                        {
                            <MudText>Enviar prueba</MudText>
                        }
                    </MudButton>
                </div>
            }
        </MudPaper>
    }
}

@code {
    private List<SucursalResumenDto> _sucursales = [];
    private Guid _sucursalSeleccionadaId;
    private ActualizarSmtpRequestDto? _form;
    private bool _procesando;
    private string _correoPrueba = string.Empty;
    private bool _procesandoPrueba;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        _sucursales = await ApiClient.ListarSucursalesGestionAsync();
        _sucursalSeleccionadaId = _sucursales.Any(s => s.Id == Sesion.SucursalActivaId)
            ? Sesion.SucursalActivaId
            : _sucursales.FirstOrDefault()?.Id ?? Guid.Empty;

        await CargarAsync();
    }

    private async Task OnSucursalCambiadaAsync(Guid sucursalId)
    {
        _sucursalSeleccionadaId = sucursalId;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        if (_sucursalSeleccionadaId == Guid.Empty)
        {
            _form = null;
            return;
        }

        var sucursal = await ApiClient.ObtenerSucursalAsync(_sucursalSeleccionadaId);
        if (sucursal is null)
        {
            _form = null;
            return;
        }

        _form = new ActualizarSmtpRequestDto
        {
            SmtpActivo = sucursal.SmtpActivo,
            SmtpHost = sucursal.SmtpHost,
            SmtpPuerto = sucursal.SmtpPuerto,
            SmtpUsuario = sucursal.SmtpUsuario,
            SmtpRemitente = sucursal.SmtpRemitente,
            SmtpUsaSsl = sucursal.SmtpUsaSsl
        };
    }

    private async Task GuardarAsync()
    {
        if (_procesando) return;
        _procesando = true;
        try
        {
            var (exito, error) = await ApiClient.ActualizarSmtpSucursalAsync(_sucursalSeleccionadaId, _form!);
            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error inesperado.", Severity.Error);
                return;
            }

            Snackbar.Add("Configuración de correo guardada.", Severity.Success);
            await CargarAsync();
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task EnviarPruebaAsync()
    {
        if (_procesandoPrueba || string.IsNullOrWhiteSpace(_correoPrueba)) return;
        _procesandoPrueba = true;
        try
        {
            var (exito, error) = await ApiClient.EnviarPruebaSmtpAsync(_sucursalSeleccionadaId, _correoPrueba);
            if (!exito)
            {
                Snackbar.Add(error ?? "No se pudo enviar el correo de prueba.", Severity.Error);
                return;
            }

            Snackbar.Add($"Correo de prueba enviado a {_correoPrueba}.", Severity.Success);
        }
        finally
        {
            _procesandoPrueba = false;
        }
    }
}
