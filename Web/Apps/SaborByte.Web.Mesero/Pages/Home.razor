@page "/inicio"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject ConexionComandas Conexion
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>SaborByte — Mesero</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else
{
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4">
        <MudTabPanel Text="Nuevo pedido">
            <MudGrid>
                <MudItem xs="9">
                    <MudGrid Class="mb-4">
                        <MudItem xs="8">
                            <MudTextField T="string" Label="Buscar producto (código de barra o descripción)"
                                           @bind-Value="_textoBusqueda" Immediate="true" DebounceInterval="300"
                                           OnDebounceIntervalElapsed="BuscarAsync" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudSelect T="Guid?" Label="Categoría" Value="_categoriaId" ValueChanged="OnCategoriaCambiadaAsync" Clearable="true">
                                <MudSelectItem Value="@((Guid?)null)">Todas</MudSelectItem>
                                @foreach (var categoria in _categorias)
                                {
                                    <MudSelectItem Value="@((Guid?)categoria.Id)">@categoria.Nombre</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudGrid>
                        @foreach (var producto in _productos)
                        {
                            var oferta = OfertaDeProducto(producto);
                            <MudItem xs="6" sm="4" md="3" lg="2">
                                <MudCard Class="cursor-pointer" Style="position:relative" @onclick="() => AgregarAlPedidoAsync(producto)">
                                    @if (oferta.Promocion is not null)
                                    {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Style="position:absolute; top:4px; right:4px; z-index:1">OFERTA</MudChip>
                                    }
                                    @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                                    {
                                        <MudCardMedia Image="@producto.ImagenUrl" Height="100" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-center justify-center mud-theme-primary" style="height:100px;background-color:var(--mud-palette-primary-lighten)">
                                            <MudIcon Icon="@Icons.Material.Filled.RestaurantMenu" Size="Size.Large" Color="Color.Surface" />
                                        </div>
                                    }
                                    <MudCardContent>
                                        <MudText Typo="Typo.subtitle2">@producto.Nombre</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Cód. @producto.Codigo</MudText>
                                        @if (oferta.Promocion is not null)
                                        {
                                            <MudText Typo="Typo.caption" Style="text-decoration:line-through" Class="mud-text-secondary">RD$ @producto.PrecioConItbis.ToString("0.00")</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Error"><strong>RD$ @oferta.PrecioConOferta.ToString("0.00")</strong></MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2">RD$ @producto.PrecioConItbis.ToString("0.00")</MudText>
                                        }
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                </MudItem>

                <MudItem xs="3">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-2">Pedido</MudText>

                        <MudSelect T="Guid?" Label="Mesa" @bind-Value="_mesaId" Class="mb-3" Required="true">
                            @foreach (var mesa in _mesas.Where(m => m.Activo))
                            {
                                <MudSelectItem Value="@((Guid?)mesa.Id)">
                                    Mesa @mesa.Numero @(string.IsNullOrEmpty(mesa.Salon) ? "" : $"— {mesa.Salon}") @(mesa.Estado == EstadoMesa.Ocupada ? "(ocupada)" : "")
                                </MudSelectItem>
                            }
                        </MudSelect>

                        @foreach (var linea in _pedido)
                        {
                            <div class="d-flex justify-space-between align-center mb-1 gap-1">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                               OnClick="() => QuitarUnidad(linea)" />
                                <div style="min-width:130px">
                                    <MudText Typo="Typo.body2">@linea.Cantidad x @linea.Nombre</MudText>
                                    @if (linea.NombresExcluidos.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Sin: @string.Join(", ", linea.NombresExcluidos)</MudText>
                                    }
                                </div>
                                <MudTextField T="string" Label="Notas" @bind-Value="linea.Notas" Margin="Margin.Dense" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="() => _pedido.Remove(linea)" />
                            </div>
                        }

                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                   Disabled="@(_pedido.Count == 0 || _mesaId is null || _procesandoEnvio)" OnClick="EnviarACocinaAsync" Class="mt-2">
                            @if (_procesandoEnvio)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Enviando...</MudText>
                            }
                            else
                            {
                                <MudText>Enviar a cocina</MudText>
                            }
                        </MudButton>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Mis comandas">
            @if (_comandas.Count == 0)
            {
                <MudText Typo="Typo.body2">No hay comandas abiertas.</MudText>
            }
            else
            {
                <MudGrid>
                    @foreach (var comanda in _comandas.OrderByDescending(c => c.NumeroComanda))
                    {
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-4 mb-3">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <div>
                                        <MudText Typo="Typo.subtitle1">
                                            <strong>
                                                Comanda #@comanda.NumeroComanda
                                                @(string.IsNullOrEmpty(comanda.NumeroMesa) ? "" : $"— Mesa {comanda.NumeroMesa}{(string.IsNullOrEmpty(comanda.NombreSalon) ? "" : $" ({comanda.NombreSalon})")}")
                                            </strong>
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            Mesero: @(comanda.NombreMesero ?? "—")
                                        </MudText>
                                    </div>
                                    <MudButton Size="Size.Small" Color="Color.Error"
                                               OnClick="() => AbrirCancelarComanda(comanda.Id)">
                                        Cancelar comanda
                                    </MudButton>
                                </div>

                                @foreach (var item in comanda.Items.Where(i => i.Estado != EstadoItemComanda.Cancelado))
                                {
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <div>
                                            <div class="d-flex align-center gap-2">
                                                <MudText Typo="Typo.body2">@item.Cantidad x @item.NombreProducto</MudText>
                                                <MudChip T="string" Size="Size.Small" Color="@ColorEstadoItem(item.Estado)">@TextoEstadoItem(item.Estado)</MudChip>
                                            </div>
                                            @if (item.IngredientesExcluidosNombres.Count > 0)
                                            {
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Sin: @string.Join(", ", item.IngredientesExcluidosNombres)</MudText>
                                            }
                                        </div>
                                        @if (item.Estado == EstadoItemComanda.Listo)
                                        {
                                            <MudButton Size="Size.Small" Color="Color.Success"
                                                       OnClick="() => MarcarEntregadoAsync(item.Id)">
                                                Marcar entregado
                                            </MudButton>
                                        }
                                    </div>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudTabPanel>
    </MudTabs>

    @if (_mostrarDialogoCancelarComanda)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" @onclick="() => _mostrarDialogoCancelarComanda = false">
            <MudPaper Class="pa-6" @onclick:stopPropagation="true" Style="width:400px">
                <MudText Typo="Typo.h6" Class="mb-3">Cancelar comanda completa</MudText>
                <MudTextField T="string" Label="Motivo" @bind-Value="_motivoCancelacion" Class="mb-2" />

                <div class="d-flex gap-2 mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmarCancelarComandaAsync" Disabled="_procesandoCancelacion">
                        @if (_procesandoCancelacion)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <MudText>Cancelar comanda</MudText>
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => _mostrarDialogoCancelarComanda = false">Volver</MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }

    @if (_productoParaPersonalizar is not null)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" @onclick="() => _productoParaPersonalizar = null">
            <MudPaper Class="pa-6" @onclick:stopPropagation="true" Style="width:400px">
                <MudText Typo="Typo.h6" Class="mb-3">@_productoParaPersonalizar.Nombre</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">Desmarca lo que no lleve:</MudText>

                @foreach (var ingrediente in _ingredientesOpcionales)
                {
                    <MudCheckBox T="bool" Label="@ingrediente.InsumoNombre" Value="!_excluidosSeleccionados.Contains(ingrediente.InsumoId)"
                                 ValueChanged="@((bool incluido) => AlternarExclusion(ingrediente.InsumoId, incluido))" />
                }

                <div class="d-flex gap-2 mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmarPersonalizacion">Agregar al pedido</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => _productoParaPersonalizar = null">Cancelar</MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }
}

@code {
    private string _textoBusqueda = string.Empty;
    private List<ProductoResumenDto> _productos = [];
    private List<CategoriaDto> _categorias = [];
    private List<PromocionDto> _promocionesVigentes = [];

    // Prioridad: una promoción específica del producto siempre le gana a una de su
    // categoría. Si compiten varias del mismo nivel, gana la que dé mayor descuento en
    // RD$ — nunca se acumulan dos promociones en la misma línea. Mismo criterio que
    // VentaAppService.SeleccionarMejorPromocion (backend, autoritativo) y Caja.
    private (PromocionDto? Promocion, decimal Descuento) MejorPromocion(Guid productoId, Guid categoriaId, decimal totalLinea, decimal cantidad)
    {
        decimal CalcularDescuento(PromocionDto promo) => Math.Min(totalLinea, promo.TipoDescuento switch
        {
            TipoDescuentoPromocion.Porcentaje => totalLinea * (promo.Valor / 100m),
            _ => promo.Valor * cantidad
        });

        var candidatas = _promocionesVigentes.Where(p => p.ProductoId == productoId).ToList();
        if (candidatas.Count == 0)
            candidatas = _promocionesVigentes.Where(p => p.CategoriaId == categoriaId).ToList();

        if (candidatas.Count == 0)
            return (null, 0m);

        return candidatas.Select(p => (Promocion: (PromocionDto?)p, Descuento: CalcularDescuento(p)))
            .OrderByDescending(x => x.Descuento)
            .First();
    }

    // Badge "OFERTA" en el catálogo: precio con descuento de una sola unidad, con ITBIS
    // incluido para compararlo a simple vista con PrecioConItbis (el precio normal que
    // ya se muestra en la tarjeta).
    private (PromocionDto? Promocion, decimal PrecioConOferta) OfertaDeProducto(ProductoResumenDto producto)
    {
        var (promo, descuentoNeto) = MejorPromocion(producto.Id, producto.CategoriaId, producto.Precio, 1);
        if (promo is null)
            return (null, producto.PrecioConItbis);

        var precioOfertaNeto = producto.Precio - descuentoNeto;
        return (promo, precioOfertaNeto * (1 + producto.TasaItbis));
    }
    private Guid? _categoriaId;
    private readonly List<LineaPedido> _pedido = [];
    private bool _procesandoEnvio;
    private bool _procesandoCancelacion;
    private List<MesaDto> _mesas = [];
    private Guid? _mesaId;

    private List<ComandaDto> _comandas = [];
    private bool _mostrarDialogoCancelarComanda;
    private Guid? _comandaACancelar;
    private string _motivoCancelacion = string.Empty;

    private readonly Dictionary<Guid, List<RecetaItemDto>> _recetaCache = [];
    private ProductoResumenDto? _productoParaPersonalizar;
    private List<RecetaItemDto> _ingredientesOpcionales = [];
    private readonly HashSet<Guid> _excluidosSeleccionados = [];

    private static Color ColorEstadoItem(EstadoItemComanda estado) => estado switch
    {
        EstadoItemComanda.Pendiente => Color.Default,
        EstadoItemComanda.EnPreparacion => Color.Warning,
        EstadoItemComanda.Listo => Color.Success,
        EstadoItemComanda.Entregado => Color.Info,
        EstadoItemComanda.Cancelado => Color.Error,
        _ => Color.Default
    };

    private static string TextoEstadoItem(EstadoItemComanda estado) => estado switch
    {
        EstadoItemComanda.Pendiente => "Pendiente",
        EstadoItemComanda.EnPreparacion => "En preparación",
        EstadoItemComanda.Listo => "Listo",
        EstadoItemComanda.Entregado => "Entregado",
        EstadoItemComanda.Cancelado => "Cancelado",
        _ => estado.ToString()
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        if (Sesion.RequiereSeleccionSucursal)
        {
            Navegacion.NavigateTo("/seleccionar-sucursal");
            return;
        }

        var sucursalId = Sesion.SucursalActivaId;
        _categorias = await ApiClient.ListarCategoriasAsync();
        _promocionesVigentes = await ApiClient.ListarPromocionesVigentesAsync(sucursalId);
        await BuscarAsync();
        _mesas = await ApiClient.ListarMesasAsync(sucursalId);
        await CargarComandasAsync();

        Conexion.ItemActualizado += OnItemActualizado;
        Conexion.ComandaCerrada += OnComandaCerrada;
        Conexion.ComandaCancelada += OnComandaCancelada;
        await Conexion.ConectarAsync();
    }

    private void OnItemActualizado(Guid comandaId, ComandaItemDto item)
    {
        var comanda = _comandas.FirstOrDefault(c => c.Id == comandaId);
        var existente = comanda?.Items.FirstOrDefault(i => i.Id == item.Id);
        if (existente is not null)
        {
            comanda!.Items[comanda.Items.IndexOf(existente)] = item;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnComandaCerrada(Guid comandaId)
    {
        _comandas.RemoveAll(c => c.Id == comandaId);
        InvokeAsync(StateHasChanged);
    }

    private async void OnComandaCancelada(Guid comandaId, Guid? itemId)
        => await InvokeAsync(async () => { await CargarComandasAsync(); StateHasChanged(); });

    private async Task CargarComandasAsync()
    {
        var sucursalId = Sesion.SucursalActivaId;
        _comandas = await ApiClient.ObtenerComandasAbiertasAsync(sucursalId);
    }

    private async Task BuscarAsync()
    {
        _productos = await ApiClient.BuscarProductosAsync(_textoBusqueda, _categoriaId);
    }

    private async Task OnCategoriaCambiadaAsync(Guid? categoriaId)
    {
        _categoriaId = categoriaId;
        await BuscarAsync();
    }

    private async Task<List<RecetaItemDto>> ObtenerRecetaAsync(Guid productoId)
    {
        if (_recetaCache.TryGetValue(productoId, out var receta))
            return receta;

        var detalle = await ApiClient.ObtenerProductoAsync(productoId);
        receta = detalle?.Receta ?? [];
        _recetaCache[productoId] = receta;
        return receta;
    }

    private async Task AgregarAlPedidoAsync(ProductoResumenDto producto)
    {
        var receta = await ObtenerRecetaAsync(producto.Id);
        var opcionales = receta.Where(r => r.Opcional).ToList();

        if (opcionales.Count == 0)
        {
            AgregarLinea(producto, []);
            return;
        }

        _productoParaPersonalizar = producto;
        _ingredientesOpcionales = opcionales;
        _excluidosSeleccionados.Clear();
    }

    private void AlternarExclusion(Guid insumoId, bool incluido)
    {
        if (incluido)
            _excluidosSeleccionados.Remove(insumoId);
        else
            _excluidosSeleccionados.Add(insumoId);
    }

    private void ConfirmarPersonalizacion()
    {
        AgregarLinea(_productoParaPersonalizar!, [.. _excluidosSeleccionados]);
        _productoParaPersonalizar = null;
    }

    private void AgregarLinea(ProductoResumenDto producto, List<Guid> excluidosIds)
    {
        var nombresExcluidos = _ingredientesOpcionales
            .Where(i => excluidosIds.Contains(i.InsumoId))
            .Select(i => i.InsumoNombre)
            .ToList();

        // Dos líneas del mismo producto solo se combinan (suman cantidad) si tienen
        // exactamente la misma personalización — "sin cebolla" no debe mezclarse con la
        // versión completa del mismo plato.
        var existente = _pedido.FirstOrDefault(l =>
            l.ProductoId == producto.Id && l.IngredientesExcluidosIds.SetEquals(excluidosIds));

        if (existente is not null)
        {
            existente.Cantidad++;
            return;
        }

        _pedido.Add(new LineaPedido
        {
            ProductoId = producto.Id,
            Nombre = producto.Nombre,
            Cantidad = 1,
            IngredientesExcluidosIds = [.. excluidosIds],
            NombresExcluidos = nombresExcluidos
        });
    }

    private void QuitarUnidad(LineaPedido linea)
    {
        linea.Cantidad--;
        if (linea.Cantidad <= 0)
            _pedido.Remove(linea);
    }

    private async Task EnviarACocinaAsync()
    {
        if (_procesandoEnvio) return;

        if (_mesaId is null)
        {
            Snackbar.Add("Debes seleccionar una mesa.", Severity.Error);
            return;
        }

        _procesandoEnvio = true;
        try
        {
            var request = new CrearComandaRequestDto
            {
                MesaId = _mesaId,
                Items = _pedido.Select(l => new ItemComandaRequestDto
                {
                    ProductoId = l.ProductoId,
                    Cantidad = l.Cantidad,
                    Notas = l.Notas,
                    IngredientesExcluidosIds = [.. l.IngredientesExcluidosIds]
                }).ToList()
            };

            var sucursalId = Sesion.SucursalActivaId;
            var (exito, comanda, error) = await ApiClient.CrearComandaAsync(sucursalId, request);

            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
                return;
            }

            Snackbar.Add($"Comanda #{comanda!.NumeroComanda} enviada a cocina.", Severity.Success);
            _pedido.Clear();
            _mesaId = null;
            _mesas = await ApiClient.ListarMesasAsync(sucursalId);
            await CargarComandasAsync();
        }
        finally
        {
            _procesandoEnvio = false;
        }
    }

    private async Task MarcarEntregadoAsync(Guid comandaItemId)
    {
        var sucursalId = Sesion.SucursalActivaId;
        await ApiClient.CambiarEstadoItemAsync(sucursalId, comandaItemId, EstadoItemComanda.Entregado);
        Snackbar.Add("Ítem marcado entregado.", Severity.Success);
        await CargarComandasAsync();
    }

    private void AbrirCancelarComanda(Guid comandaId)
    {
        _comandaACancelar = comandaId;
        _motivoCancelacion = string.Empty;
        _mostrarDialogoCancelarComanda = true;
    }

    private async Task ConfirmarCancelarComandaAsync()
    {
        if (_procesandoCancelacion) return;

        if (string.IsNullOrWhiteSpace(_motivoCancelacion))
        {
            Snackbar.Add("El motivo es obligatorio.", Severity.Error);
            return;
        }

        _procesandoCancelacion = true;
        try
        {
            var sucursalId = Sesion.SucursalActivaId;
            var (exito, error) = await ApiClient.CancelarComandaAsync(
                sucursalId, _comandaACancelar!.Value, _motivoCancelacion, RolQueCancelo.Mesero);

            if (!exito)
            {
                Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
                return;
            }

            Snackbar.Add("Comanda cancelada.", Severity.Success);
            _mostrarDialogoCancelarComanda = false;
            _mesas = await ApiClient.ListarMesasAsync(sucursalId);
            await CargarComandasAsync();
        }
        finally
        {
            _procesandoCancelacion = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Conexion.ItemActualizado -= OnItemActualizado;
        Conexion.ComandaCerrada -= OnComandaCerrada;
        Conexion.ComandaCancelada -= OnComandaCancelada;
        await Task.CompletedTask;
    }

    private class LineaPedido
    {
        public Guid ProductoId { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public int Cantidad { get; set; }
        public string? Notas { get; set; }
        public HashSet<Guid> IngredientesExcluidosIds { get; set; } = [];
        public List<string> NombresExcluidos { get; set; } = [];
    }
}
