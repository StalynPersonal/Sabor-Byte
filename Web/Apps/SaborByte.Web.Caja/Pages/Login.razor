@page "/"
@page "/login"
@layout LoginLayout
@using SaborByte.Web.Api
@inject SaborByteApiClient ApiClient
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<PageTitle>SaborByte</PageTitle>

<div class="pantalla-login">
    <div class="panel-marca">
        <div class="panel-marca__contenido">
            <div class="panel-marca__logo">SB</div>
            <h1 class="panel-marca__titulo">SaborByte</h1>
            <p class="panel-marca__subtitulo">Caja — factura ventas directas y comandas, controla el turno.</p>
        </div>
    </div>

    <div class="panel-formulario">
        <div class="formulario-login">
            <h2 class="formulario-login__titulo">Bienvenido de nuevo</h2>
            <p class="formulario-login__ayuda">Ingresa tus credenciales para continuar.</p>

            <MudTextField T="string" Label="Usuario" @bind-Value="_nombreUsuario" Variant="Variant.Outlined"
                           Immediate="true" Class="mb-4" @onkeydown="OnKeyDown" />
            <MudTextField T="string" Label="Contraseña" InputType="InputType.Password" @bind-Value="_password"
                           Variant="Variant.Outlined" Immediate="true" Class="mb-4" @onkeydown="OnKeyDown" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_cargando"
                       OnClick="EntrarAsync" Class="formulario-login__boton">
                @if (_cargando)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Entrando...</MudText>
                }
                else
                {
                    <MudText>Entrar</MudText>
                }
            </MudButton>
        </div>
    </div>
</div>

@code {
    private string _nombreUsuario = string.Empty;
    private string _password = string.Empty;
    private bool _cargando;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await EntrarAsync();
    }

    private async Task EntrarAsync()
    {
        if (_cargando) return;
        _cargando = true;

        var resultado = await ApiClient.LoginAsync(_nombreUsuario, _password);

        _cargando = false;

        if (resultado is null)
        {
            Snackbar.Add("Usuario o contraseña incorrectos.", Severity.Error);
            return;
        }

        Navegacion.NavigateTo("/inicio");
    }
}
