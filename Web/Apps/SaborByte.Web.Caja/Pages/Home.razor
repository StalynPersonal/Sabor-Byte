    private async Task EmitirNotaAsync()
    {
        if (_motivoNotaId is null)
        {
            Snackbar.Add("Selecciona un motivo.", Severity.Error);
            return;
        }

        var detalle = _cantidadesNota
            .Where(kv => kv.Value > 0)
            .Select(kv => new DetalleNotaRequestDto { FacturaDetalleId = kv.Key, Cantidad = kv.Value })
            .ToList();

        if (detalle.Count == 0)
        {
            Snackbar.Add("Indica al menos una cantidad a acreditar.", Severity.Error);
            return;
        }

        if (_codigoAutorizacionNota is null)
        {
            Snackbar.Add("Falta la autorización de supervisor.", Severity.Error);
            return;
        }

        var request = new CrearNotaRequestDto
        {
            FacturaOriginalId = _facturaParaNota!.Id,
            MotivoId = _motivoNotaId.Value,
            Detalle = detalle,
            CodigoAutorizacion = _codigoAutorizacionNota.Value
        };

        var (exito, nota, error) = await ApiClient.CrearNotaAsync(Sesion.SucursalActivaId, request);

        // El código de autorización es de un solo uso — falle o no, hay que pedir uno nuevo.
        _notaAutorizada = false;
        _codigoAutorizacionNota = null;

        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Nota de crédito emitida.", Severity.Success);
        _ultimaNota = nota;
        _facturaParaNota = null;
        _textoBusquedaNota = string.Empty;
        await RecargarFacturasNotaAsync();

        StateHasChanged();
        // Mismo motivo que en la venta: sin esta espera, "print" a veces se dispara antes
        // de que el navegador termine de pintar el recibo de la nota.
        await Task.Delay(50);
        await JS.InvokeVoidAsync("print");
    }

    private async Task FacturarAsync()
    {
        // Caso común (un solo pago): se ajusta solo al total, sin obligar a escribirlo.
        // Si el usuario agregó una segunda forma de pago (split), ahí sí escribe los montos.
        if (_pagos.Count == 1)
            _pagos[0].Monto = TotalConPropina;

        // Si se está cobrando una comanda, sus líneas (EsDeComanda = true) NO viajan en
        // Items: el backend las toma de la comanda directo de la base de datos (ver
        // VentaAppService.CrearVentaAsync). Solo los productos agregados aparte durante
        // el cobro van en Items.
        var itemsAEnviar = _comandaOrigen is null ? _carrito : _carrito.Where(l => !l.EsDeComanda).ToList();

        if (_clienteSeleccionado is null)
        {
            Snackbar.Add("Selecciona un cliente antes de facturar.", Severity.Error);
            return;
        }

        if (_descuentoAutorizado && itemsAEnviar.Count == 0)
        {
            Snackbar.Add("El descuento necesita al menos un producto agregado aparte de la comanda para aplicarse — o quita el descuento.", Severity.Error);
            return;
        }

        var request = new CrearVentaRequestDto
        {
            TurnoCajaId = _turnoCajaId!.Value,
            ClienteId = _clienteSeleccionado?.Id,
            ComandaId = _comandaOrigen?.Id,
            Pagos = _pagos,
            Items = itemsAEnviar.Select((l, indice) => new ItemVentaDto
            {
                ProductoId = l.ProductoId,
                Cantidad = l.Cantidad,
                IngredientesExcluidosIds = [.. l.IngredientesExcluidosIds],
                // El descuento autorizado se aplica a la primera línea; simple y suficiente para v1.
                Descuento = indice == 0 ? (_descuentoAutorizado ? _montoDescuento : 0) : 0
            }).ToList(),
            PorcentajePropina = _porcentajePropina > 0 ? _porcentajePropina : null,
            CodigoAutorizacionDescuento = _codigoAutorizacionDescuento
        };

        var sucursalId = Sesion.SucursalActivaId;
        var (exito, resultado, error) = await ApiClient.CrearVentaAsync(sucursalId, request);

        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Venta registrada.", Severity.Success);
        _ultimaVenta = resultado;
        _lineasUltimaVenta = [.. _carrito];

        _carrito.Clear();
        _comandaOrigen = null;
        _porcentajePropina = 0;
        _descuentoAutorizado = false;
        _codigoAutorizacionDescuento = null;
        _montoDescuento = 0;
        _clienteSeleccionado = null;
        _pagos = [new() { MetodoPagoId = MetodoPagoEfectivoId }];
        _cajas = await ApiClient.ListarCajasAsync(sucursalId);
        await CargarComandasAbiertasAsync();

        StateHasChanged();
        // Sin esta espera, "print" a veces se dispara antes de que el navegador termine de
        // pintar el recibo — sale la hoja con el encabezado pero sin las líneas.
        await Task.Delay(50);
        await JS.InvokeVoidAsync("print");
    }

    private async Task IniciarCierreAsync()
    {
        _resumenCierre = await ApiClient.ObtenerResumenTurnoAsync(_turnoCajaId!.Value);
        _cerrando = true;
    }

    private async Task ConfirmarCierreAsync()
    {
        var denominaciones = _denominacionesEfectivo
            .Where(d => _cantidadesPorDenominacion.GetValueOrDefault(d) > 0)
            .Select(d => new DenominacionCierreDto { MetodoPagoId = MetodoPagoEfectivoId, Denominacion = d, Cantidad = _cantidadesPorDenominacion[d] })
            .ToList();

        foreach (var metodo in _metodosPago.Where(m => !m.EsEfectivo))
        {
            var monto = _montoContadoPorMetodo.GetValueOrDefault(metodo.Id);
            if (monto > 0)
                denominaciones.Add(new DenominacionCierreDto { MetodoPagoId = metodo.Id, Denominacion = null, Cantidad = 1 * (int)monto });
        }

        var (exito, error) = await ApiClient.CerrarTurnoAsync(new CerrarTurnoRequestDto
        {
            TurnoCajaId = _turnoCajaId!.Value,
            Denominaciones = denominaciones
        });

        if (!exito)
        {
            _confirmandoCierre = false;
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Turno cerrado.", Severity.Success);
        _turnoCajaId = null;
        _cerrando = false;
        _confirmandoCierre = false;
        _resumenCierre = null;
        foreach (var d in _denominacionesEfectivo)
            _cantidadesPorDenominacion[d] = 0;
        _montoContadoPorMetodo.Clear();
    }

    private class LineaCarrito
    {
        public Guid ProductoId { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal Precio { get; set; }
        public int Cantidad { get; set; }
        public HashSet<Guid> IngredientesExcluidosIds { get; set; } = [];
        public List<string> NombresExcluidos { get; set; } = [];
        // true si esta línea viene de una comanda (ya se preparó en cocina y ya descontó
        // inventario) — esas líneas son de solo lectura en el carrito (no +/-/quitar) y
        // nunca se envían en Items al facturar (el backend las toma de la comanda en la
        // base de datos, no de lo que mande el cliente). Solo las líneas agregadas
        // "extra" durante el cobro (EsDeComanda = false) viajan en Items.
        public bool EsDeComanda { get; set; }
    }
}
