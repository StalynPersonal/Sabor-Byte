    private async Task CrearClienteRapidoAsync()
    {
        if (string.IsNullOrWhiteSpace(_formNuevoCliente.NombreORazonSocial))
        {
            Snackbar.Add("El nombre del cliente es obligatorio.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(_formNuevoCliente.Telefono))
        {
            Snackbar.Add("El teléfono del cliente es obligatorio.", Severity.Error);
            return;
        }

        if (_formNuevoCliente.TipoCliente == TipoCliente.Fiscal && string.IsNullOrWhiteSpace(_formNuevoCliente.RncOCedula))
        {
            Snackbar.Add("El RNC/Cédula es obligatorio para un cliente Fiscal.", Severity.Error);
            return;
        }

        var sucursalId = Sesion.SucursalActivaId;
        var (exito, clienteId, error) = await ApiClient.CrearClienteAsync(sucursalId, _formNuevoCliente);

        if (!exito || clienteId is null)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
            return;
        }

        Snackbar.Add("Cliente creado.", Severity.Success);
        _mostrarDialogoNuevoCliente = false;

        // Se recarga por nombre en vez de armar el ClienteDto a mano — así queda igual
        // a como lo devolvería una búsqueda normal (mismo shape, sin inventar datos).
        var resultados = await ApiClient.BuscarClientesAsync(sucursalId, _formNuevoCliente.NombreORazonSocial);
        _clienteSeleccionado = resultados.FirstOrDefault(c => c.Id == clienteId) ?? resultados.FirstOrDefault();
    }

    private async Task<List<RecetaItemDto>> ObtenerRecetaAsync(Guid productoId)
    {
        if (_recetaCache.TryGetValue(productoId, out var receta))
            return receta;

        var detalle = await ApiClient.ObtenerProductoAsync(productoId);
        receta = detalle?.Receta ?? [];
        _recetaCache[productoId] = receta;
        return receta;
    }

    private async Task AgregarAlCarritoAsync(ProductoResumenDto producto)
    {
        var receta = await ObtenerRecetaAsync(producto.Id);
        var opcionales = receta.Where(r => r.Opcional).ToList();

        if (opcionales.Count == 0)
        {
            AgregarLineaCarrito(producto, []);
            return;
        }

        _productoParaPersonalizar = producto;
        _ingredientesOpcionales = opcionales;
        _excluidosSeleccionados.Clear();
    }

    private void AlternarExclusion(Guid insumoId, bool incluido)
    {
        if (incluido)
            _excluidosSeleccionados.Remove(insumoId);
        else
            _excluidosSeleccionados.Add(insumoId);
    }

    private void ConfirmarPersonalizacion()
    {
        AgregarLineaCarrito(_productoParaPersonalizar!, [.. _excluidosSeleccionados]);
        _productoParaPersonalizar = null;
    }

    private void AgregarLineaCarrito(ProductoResumenDto producto, List<Guid> excluidosIds)
    {
        var nombresExcluidos = _ingredientesOpcionales
            .Where(i => excluidosIds.Contains(i.InsumoId))
            .Select(i => i.InsumoNombre)
            .ToList();

        // Nunca se mezcla con una línea EsDeComanda: esas ya vinieron preparadas de cocina;
        // un producto agregado ahora es una unidad nueva y distinta, aunque sea el mismo
        // producto — se factura y descuenta inventario aparte (ver CrearVentaAsync).
        var existente = _carrito.FirstOrDefault(l =>
            !l.EsDeComanda && l.ProductoId == producto.Id && l.IngredientesExcluidosIds.SetEquals(excluidosIds));

        if (existente is not null)
        {
            existente.Cantidad++;
            return;
        }

        _carrito.Add(new LineaCarrito
        {
            ProductoId = producto.Id,
            Nombre = producto.Nombre,
            Precio = producto.Precio,
            Cantidad = 1,
            IngredientesExcluidosIds = [.. excluidosIds],
            NombresExcluidos = nombresExcluidos
        });
    }

    private void QuitarUnidadCarrito(LineaCarrito linea)
    {
        linea.Cantidad--;
        if (linea.Cantidad <= 0)
            _carrito.Remove(linea);
    }

