@code {
    private readonly DialogOptions _opcionesDialogo = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
    private readonly DialogOptions _opcionesDialogoGrande = new() { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };
    private Guid? _turnoCajaId;
    private List<CajaResumenDto> _cajas = [];
    private Guid _cajaSeleccionadaId;
    private decimal _montoApertura;
    private TurnoAbiertoDto? _turnoBloqueadoOtroDia;
    private TurnoAbiertoDto? _turnoAbierto;

    private string NumeroCajaActual => _cajas.FirstOrDefault(c => c.Id == _cajaSeleccionadaId)?.Numero ?? "?";

    // Mismo formato que usa la factura real al emitirse: CodigoSucursal + NumeroCaja +
    // secuencia de 5 dígitos (ej. "010100023").
    private string ProximoNumeroFacturaActual
    {
        get
        {
            var caja = _cajas.FirstOrDefault(c => c.Id == _cajaSeleccionadaId);
            if (caja is null)
                return "?";

            return $"{caja.CodigoSucursal ?? "??"}{caja.Numero}{caja.ProximoNumeroFactura:D5}";
        }
    }

    private string _textoBusqueda = string.Empty;
    private List<ProductoResumenDto> _productos = [];
    private List<CategoriaDto> _categorias = [];
    private Guid? _categoriaId;
    private readonly List<LineaCarrito> _carrito = [];
    private List<MetodoPagoDto> _metodosPago = [];
    private List<PagoVentaRequestDto> _pagos = [];
    private decimal _porcentajePropina;
    private List<PorcentajePropinaDto> _porcentajesPropina = [];
    private ClienteDto? _clienteSeleccionado;
    private bool _mostrarDialogoNuevoCliente;
    private GuardarClienteRequestDto _formNuevoCliente = new();

    private readonly Dictionary<Guid, List<RecetaItemDto>> _recetaCache = [];
    private ProductoResumenDto? _productoParaPersonalizar;
    private List<RecetaItemDto> _ingredientesOpcionales = [];
    private readonly HashSet<Guid> _excluidosSeleccionados = [];

    private bool _mostrarDialogoDescuento;
    private string _supervisorUsuario = string.Empty;
    private string _supervisorPassword = string.Empty;
    private decimal _montoDescuento;
    private bool _descuentoAutorizado;
    private Guid? _codigoAutorizacionDescuento;

    private VentaResultadoDto? _ultimaVenta;
    private List<LineaCarrito> _lineasUltimaVenta = [];

    private bool _cerrando;
    private bool _confirmandoCierre;
    private ResumenTurnoDto? _resumenCierre;
    private List<int> _denominacionesEfectivo = [];
    private readonly Dictionary<int, int> _cantidadesPorDenominacion = [];
    private readonly Dictionary<Guid, decimal> _montoContadoPorMetodo = [];

    private List<ComandaDto> _comandasAbiertas = [];
    // La comanda que se está cobrando ahora mismo (si hay una) — sus ítems viven en
    // _carrito como líneas de solo lectura (LineaCarrito.EsDeComanda = true); ver punto 4
    // del rediseño: cobrar una comanda ya no factura "en el sitio" desde la pestaña de
    // comandas, transfiere sus ítems al carrito de Venta para poder elegir cliente,
    // aplicar descuento y agregar productos extra igual que en una venta directa.
    private ComandaDto? _comandaOrigen;
    private int _tabIndex;

