@page "/inicio"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>SaborByte — Caja</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else if (_turnoBloqueadoOtroDia is not null)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-8" Elevation="3">
            <MudText Typo="Typo.h5" Class="mb-4">Turno sin cerrar de otro día</MudText>
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                Esta caja tiene el turno #@_turnoBloqueadoOtroDia.NumeroTurno abierto desde el @_turnoBloqueadoOtroDia.FechaHoraApertura.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                (por @(_turnoBloqueadoOtroDia.UsuarioAperturaNombre ?? "otro usuario")). No puede seguir operando en un día
                distinto — hay que cerrarlo primero.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="IrACerrarTurnoBloqueadoAsync">
                Ir a cerrar ese turno
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else if (_turnoCajaId is null)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-8" Elevation="3">
            <MudText Typo="Typo.h5" Class="mb-4">Abrir turno de caja</MudText>

            @if (_cajas.Count == 0)
            {
                <MudAlert Severity="Severity.Warning">
                    No hay ninguna caja configurada para tu sucursal. Pide a un Admin que
                    cree una desde Central → Administración → Cajas.
                </MudAlert>
            }
            else
            {
                <MudSelect T="Guid" Label="Caja" Value="_cajaSeleccionadaId" ValueChanged="OnCajaSeleccionadaAsync" Class="mb-3">
                    @foreach (var caja in _cajas)
                    {
                        <MudSelectItem Value="@caja.Id">Caja @caja.Numero</MudSelectItem>
                    }
                </MudSelect>

                <MudNumericField T="decimal" Label="Monto de apertura (efectivo)" @bind-Value="_montoApertura" Class="mb-3" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="AbrirTurnoAsync">
                    Abrir turno
                </MudButton>
            }
        </MudPaper>
    </MudContainer>
}
else if (_cerrando)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Class="mb-4">Cierre de turno #@_resumenCierre?.NumeroTurno — conteo de efectivo</MudText>

            <MudText Typo="Typo.subtitle2" Class="mb-2">Esperado por forma de pago (según ventas del turno)</MudText>
            @foreach (var total in _resumenCierre?.Totales ?? [])
            {
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.body2">@total.MetodoPagoNombre</MudText>
                    <MudText Typo="Typo.body2">RD$ @total.Esperado.ToString("0.00")</MudText>
                </div>
            }

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Efectivo — desglose de billetes y monedas</MudText>

            <MudGrid>
                @foreach (var denom in _denominacionesEfectivo)
                {
                    <MudItem xs="4" sm="3">
                        <MudNumericField T="int" Label="@($"RD$ {denom}")" @bind-Value="_cantidadesPorDenominacion[denom]" Min="0" />
                    </MudItem>
                }
            </MudGrid>

            <MudText Typo="Typo.subtitle1" Class="mt-3">
                Total efectivo contado: RD$ @TotalEfectivoContado.ToString("0.00")
            </MudText>

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Otras formas de pago — monto contado/reportado</MudText>
            @foreach (var metodo in _metodosPago.Where(m => !m.EsEfectivo))
            {
                <MudNumericField T="decimal" Label="@metodo.Nombre" Value="_montoContadoPorMetodo.GetValueOrDefault(metodo.Id)"
                                  ValueChanged="v => _montoContadoPorMetodo[metodo.Id] = v" Class="mb-2" />
            }

            <div class="d-flex gap-2 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="() => _confirmandoCierre = true">
                    Confirmar cierre
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="() => _cerrando = false">Cancelar</MudButton>
            </div>
        </MudPaper>
    </MudContainer>

    <MudDialog @bind-Visible="_confirmandoCierre" Options="_opcionesDialogo">
        <TitleContent>¿Cerrar el turno #@_resumenCierre?.NumeroTurno?</TitleContent>
        <DialogContent>
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                Esta acción no se puede deshacer. Verifica el conteo de efectivo antes de continuar.
            </MudAlert>
            <MudText Typo="Typo.body2">Total efectivo contado: <strong>RD$ @TotalEfectivoContado.ToString("0.00")</strong></MudText>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _confirmandoCierre = false">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmarCierreAsync">Sí, cerrar turno</MudButton>
        </DialogActions>
    </MudDialog>
}
else
{
    <MudPaper Class="pa-3 mb-3 d-flex flex-wrap gap-4" Outlined="true">
        <MudText Typo="Typo.body2"><strong>Caja:</strong> @NumeroCajaActual</MudText>
        <MudText Typo="Typo.body2">
            <strong>Turno abierto:</strong>
            @(_turnoAbierto is null ? "—" : $"#{_turnoAbierto.NumeroTurno} — {_turnoAbierto.FechaHoraApertura.ToLocalTime():dd/MM/yyyy HH:mm} por {_turnoAbierto.UsuarioAperturaNombre ?? "?"}")
        </MudText>
        <MudText Typo="Typo.body2"><strong>Próximo N° de factura:</strong> @ProximoNumeroFacturaActual</MudText>
    </MudPaper>

    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4" @bind-ActivePanelIndex="_tabIndex">
    <MudTabPanel Text="Venta">
    <MudGrid>
        <MudItem xs="8">
            <MudGrid Class="mb-4">
                <MudItem xs="8">
                    <MudTextField T="string" Label="Buscar producto (código de barra o descripción)"
                                   @bind-Value="_textoBusqueda" Immediate="true" DebounceInterval="300"
                                   OnDebounceIntervalElapsed="BuscarAsync" />
                </MudItem>
                <MudItem xs="4">
                    <MudSelect T="Guid?" Label="Categoría" Value="_categoriaId" ValueChanged="OnCategoriaCambiadaAsync" Clearable="true">
                        <MudSelectItem Value="@((Guid?)null)">Todas</MudSelectItem>
                        @foreach (var categoria in _categorias)
                        {
                            <MudSelectItem Value="@((Guid?)categoria.Id)">@categoria.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudGrid>
                @foreach (var producto in _productos)
                {
                    <MudItem xs="4" sm="3">
                        <MudCard Class="cursor-pointer" @onclick="() => AgregarAlCarritoAsync(producto)">
                            @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                            {
                                <MudCardMedia Image="@producto.ImagenUrl" Height="100" />
                            }
                            else
                            {
                                <div class="d-flex align-center justify-center" style="height:100px;background-color:var(--mud-palette-primary-lighten)">
                                    <MudIcon Icon="@Icons.Material.Filled.RestaurantMenu" Size="Size.Large" Color="Color.Surface" />
                                </div>
                            }
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle2">@producto.Nombre</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Cód. @producto.Codigo</MudText>
                                <MudText Typo="Typo.body2">RD$ @producto.PrecioConItbis.ToString("0.00")</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>

        <MudItem xs="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Carrito</MudText>

                @if (_comandaOrigen is not null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        <div class="d-flex justify-space-between align-center gap-2">
                            <span>
                                Cobrando comanda #@_comandaOrigen.NumeroComanda
                                @(string.IsNullOrEmpty(_comandaOrigen.NumeroMesa) ? "" : $"— Mesa {_comandaOrigen.NumeroMesa}{(string.IsNullOrEmpty(_comandaOrigen.NombreSalon) ? "" : $" ({_comandaOrigen.NombreSalon})")}")
                            </span>
                            <MudButton Size="Size.Small" OnClick="QuitarComandaDelCarrito">Quitar</MudButton>
                        </div>
                    </MudAlert>
                }

                <div class="d-flex gap-1 align-end mb-2">
                    <MudAutocomplete T="ClienteDto" Label="Cliente" Required="true" RequiredError="Debes seleccionar un cliente" Value="_clienteSeleccionado"
                                      ValueChanged="OnClienteSeleccionado" SearchFunc="BuscarClientesAsync"
                                      ToStringFunc="@(c => c is null ? string.Empty : $"{c.NombreORazonSocial} ({c.RncOCedula})")"
                                      Clearable="true" Style="flex:1" />
                    <MudTooltip Text="Nuevo cliente">
                        <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" OnClick="AbrirNuevoClienteAsync" />
                    </MudTooltip>
                </div>

                @foreach (var linea in _carrito)
                {
                    <div class="d-flex justify-space-between align-center mb-1 gap-1">
                        @if (linea.EsDeComanda)
                        {
                            <MudTooltip Text="Ya viene de la comanda — para cambiarla, cancela el ítem desde Cocina/Mesero">
                                <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Color="Color.Default" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                           OnClick="() => QuitarUnidadCarrito(linea)" />
                        }
                        <div style="flex:1">
                            <MudText Typo="Typo.body2">@linea.Cantidad x @linea.Nombre</MudText>
                            @if (linea.NombresExcluidos.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Sin: @string.Join(", ", linea.NombresExcluidos)</MudText>
                            }
                        </div>
                        <MudText Typo="Typo.body2">RD$ @((linea.Precio * linea.Cantidad).ToString("0.00"))</MudText>
                        @if (!linea.EsDeComanda)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="() => _carrito.Remove(linea)" />
                        }
                    </div>
                }

                <MudDivider Class="my-2" />
                <MudText Typo="Typo.body2">Subtotal: RD$ @TotalCarrito.ToString("0.00")</MudText>
                <MudText Typo="Typo.body2">ITBIS (18%): RD$ @ItbisCarrito.ToString("0.00")</MudText>

                <MudSelect T="decimal" Label="Propina" @bind-Value="_porcentajePropina" Class="my-2">
                    @foreach (var porcentaje in _porcentajesPropina)
                    {
                        <MudSelectItem Value="@porcentaje.Valor">@(porcentaje.Valor == 0 ? "Sin propina" : $"{porcentaje.Valor}%")</MudSelectItem>
                    }
                </MudSelect>

                @if (_descuentoAutorizado)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="my-2">
                        Descuento autorizado (RD$ @_montoDescuento.ToString("0.00"))
                    </MudAlert>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" FullWidth="true" Class="my-2" OnClick="() => _mostrarDialogoDescuento = true">
                        Aplicar descuento (requiere supervisor)
                    </MudButton>
                }

                <MudText Typo="Typo.subtitle1">Total: RD$ @TotalConPropina.ToString("0.00")</MudText>

                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Forma(s) de pago</MudText>
                @foreach (var pago in _pagos)
                {
                    <div class="d-flex gap-2 align-center mb-2">
                        <MudSelect T="Guid" Value="pago.MetodoPagoId" ValueChanged="v => pago.MetodoPagoId = v" Style="width:140px">
                            @foreach (var metodo in _metodosPago)
                            {
                                <MudSelectItem Value="@metodo.Id">@metodo.Nombre</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="decimal" @bind-Value="pago.Monto" Label="Monto" Style="width:110px" />
                        @if (RequiereComprobante(pago.MetodoPagoId))
                        {
                            <MudTextField T="string" @bind-Value="pago.NumeroComprobante" Label="N° comprobante" Style="width:140px" />
                        }
                        @if (_pagos.Count > 1)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => _pagos.Remove(pago)" />
                        }
                    </div>
                }
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mb-2" OnClick="() => _pagos.Add(new PagoVentaRequestDto { MetodoPagoId = MetodoPagoEfectivoId })">
                    + Agregar otra forma de pago
                </MudButton>
                <MudText Typo="Typo.body2" Class="mt-1 mb-2" Color="@(FaltaPorCubrir == 0 ? Color.Success : Color.Error)">
                    @(FaltaPorCubrir == 0 ? "Pagos completos" : $"Falta por cubrir: RD$ {FaltaPorCubrir:0.00}")
                </MudText>
                @if (CambioCarrito > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Info">
                        Cambio: RD$ @CambioCarrito.ToString("0.00")
                    </MudText>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                           Disabled="_carrito.Count == 0 || _clienteSeleccionado is null" OnClick="FacturarAsync" Class="mb-2">
                    Facturar
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" OnClick="IniciarCierreAsync">
                    Cerrar turno
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Comandas abiertas">
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mb-3" OnClick="CargarComandasAbiertasAsync">
            Actualizar
        </MudButton>

        @if (_comandasAbiertas.Count == 0)
        {
            <MudText Typo="Typo.body2">No hay comandas abiertas para facturar.</MudText>
        }
        else
        {
            <MudGrid>
                @foreach (var comanda in _comandasAbiertas)
                {
                    <MudItem xs="6" sm="4" md="3">
                        <MudCard>
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1">
                                    Comanda #@comanda.NumeroComanda
                                    @(string.IsNullOrEmpty(comanda.NumeroMesa) ? "" : $"— Mesa {comanda.NumeroMesa}{(string.IsNullOrEmpty(comanda.NombreSalon) ? "" : $" ({comanda.NombreSalon})")}")
                                </MudText>
                                <MudText Typo="Typo.body2">@comanda.Items.Count(i => i.Estado != EstadoItemComanda.Cancelado) ítem(s)</MudText>
                                <MudText Typo="Typo.caption">Mesero: @(comanda.NombreMesero ?? "—")</MudText>
                                <MudText Typo="Typo.caption">@comanda.CreadoEn.ToLocalTime().ToString("HH:mm")</MudText>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="() => CobrarComanda(comanda)">
                                    Cobrar
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudTabPanel>

    <MudTabPanel Text="Facturas">
        @if (_facturaParaNota is null)
        {
            <MudText Typo="Typo.h6" Class="mb-2">Facturas</MudText>
            <MudTextField T="string" Label="Buscar factura (N° o NCF)" @bind-Value="_textoBusquedaNota"
                           Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="RecargarFacturasNotaAsync" Class="mb-3"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

            <MudTable @ref="_tablaFacturasNota" ServerData="CargarPaginaFacturasNotaAsync" Hover="true" Dense="true" T="FacturaResumenDto">
                <HeaderContent>
                    <MudTh>N° Factura</MudTh>
                    <MudTh>NCF</MudTh>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.NumeroFactura</MudTd>
                    <MudTd>@(context.NumeroNcf ?? "(sin NCF)")</MudTd>
                    <MudTd>@context.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>RD$ @context.Total.ToString("0.00")</MudTd>
                    <MudTd>
                        <MudTooltip Text="Ver detalle">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="() => VerDetalleFacturaNotaAsync(context.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="Reimprimir (duplicado)">
                            <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small" OnClick="() => ReimprimirFacturaAsync(context.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="Emitir nota de crédito">
                            <MudIconButton Icon="@Icons.Material.Filled.AssignmentReturn" Size="Size.Small" OnClick="() => SeleccionarFacturaNotaAsync(context)" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" InfoFormat="{first_item}-{last_item} de {all_items}" />
                </PagerContent>
            </MudTable>
        }
        else
        {
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.h6">
                    Factura @_facturaParaNota.NumeroFactura (@(_facturaParaNota.NumeroNcf ?? "sin NCF")) — Total RD$ @_facturaParaNota.Total.ToString("0.00")
                </MudText>
                <MudButton Size="Size.Small" OnClick="() => _facturaParaNota = null">Cambiar factura</MudButton>
            </div>

            <MudSelect T="Guid?" Label="Motivo" Value="_motivoNotaId" ValueChanged="v => _motivoNotaId = v" Class="mb-3" Style="max-width:400px">
                @foreach (var motivo in _motivosNota)
                {
                    <MudSelectItem Value="@((Guid?)motivo.Id)">@motivo.Nombre</MudSelectItem>
                }
            </MudSelect>

            <MudTable Items="_lineasDisponiblesNota" Hover="true" Dense="true" Class="mb-3">
                <HeaderContent>
                    <MudTh>Producto</MudTh>
                    <MudTh>Vendido</MudTh>
                    <MudTh>Ya acreditado</MudTh>
                    <MudTh>Disponible</MudTh>
                    <MudTh>Cantidad a acreditar</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.NombreProducto</MudTd>
                    <MudTd>@context.Cantidad.ToString("0.###")</MudTd>
                    <MudTd>@context.CantidadAcreditada.ToString("0.###")</MudTd>
                    <MudTd>@context.CantidadDisponible.ToString("0.###")</MudTd>
                    <MudTd Style="width:160px">
                        <MudNumericField T="decimal" Value="ObtenerCantidadNota(context.FacturaDetalleId)"
                                          ValueChanged="v => _cantidadesNota[context.FacturaDetalleId] = v"
                                          Min="0" Max="@context.CantidadDisponible" Disabled="@(context.CantidadDisponible <= 0)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            @if (_notaAutorizada)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">Autorización obtenida — ya se puede emitir.</MudAlert>
            }
            else
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mb-2" OnClick="() => _mostrarDialogoAutorizacionNota = true">
                    Solicitar autorización de supervisor
                </MudButton>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="!_notaAutorizada" OnClick="EmitirNotaAsync">
                Emitir nota de crédito
            </MudButton>
        }
    </MudTabPanel>
    </MudTabs>

    @if (_mostrarDialogoAutorizacionNota)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" @onclick="() => _mostrarDialogoAutorizacionNota = false">
            <MudPaper Class="pa-6" @onclick:stopPropagation="true" Style="width:400px">
                <MudText Typo="Typo.h6" Class="mb-3">Autorización de supervisor</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">Requiere un usuario con Autorizacion.</MudText>
                <MudTextField T="string" Label="Usuario" @bind-Value="_supervisorUsuarioNota" Class="mb-2" />
                <MudTextField T="string" Label="Contraseña" InputType="InputType.Password" @bind-Value="_supervisorPasswordNota" Class="mb-2" />

                <div class="d-flex gap-2 mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SolicitarAutorizacionNotaAsync">Autorizar</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => _mostrarDialogoAutorizacionNota = false">Cancelar</MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }

    @if (_mostrarDialogoDescuento)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" @onclick="() => _mostrarDialogoDescuento = false">
            <MudPaper Class="pa-6" @onclick:stopPropagation="true" Style="width:400px">
                <MudText Typo="Typo.h6" Class="mb-3">Autorización de supervisor</MudText>
                <MudTextField T="string" Label="Usuario supervisor" @bind-Value="_supervisorUsuario" Class="mb-2" />
                <MudTextField T="string" Label="Contraseña" InputType="InputType.Password" @bind-Value="_supervisorPassword" Class="mb-2" />
                <MudNumericField T="decimal" Label="Monto del descuento" @bind-Value="_montoDescuento" Class="mb-2" />

                <div class="d-flex gap-2 mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SolicitarAutorizacionAsync">Autorizar</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => _mostrarDialogoDescuento = false">Cancelar</MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }

    @if (_mostrarDialogoNuevoCliente)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" @onclick="() => _mostrarDialogoNuevoCliente = false">
            <MudPaper Class="pa-6" @onclick:stopPropagation="true" Style="width:400px">
                <MudText Typo="Typo.h6" Class="mb-3">Nuevo cliente</MudText>
                <MudTextField T="string" Label="Nombre / Razón social" @bind-Value="_formNuevoCliente.NombreORazonSocial" Required="true" Class="mb-2" />

                <MudSelect T="TipoCliente" Label="Tipo de cliente" @bind-Value="_formNuevoCliente.TipoCliente" Class="mb-2">
                    <MudSelectItem Value="TipoCliente.Consumo">Consumo (sin RNC)</MudSelectItem>
                    <MudSelectItem Value="TipoCliente.Fiscal">Fiscal (con RNC, crédito fiscal)</MudSelectItem>
                </MudSelect>

                <MudTextField T="string" Label="RNC/Cédula" @bind-Value="_formNuevoCliente.RncOCedula"
                               Required="@(_formNuevoCliente.TipoCliente == TipoCliente.Fiscal)"
                               HelperText="@(_formNuevoCliente.TipoCliente == TipoCliente.Fiscal ? "Obligatorio para clientes Fiscal" : null)"
                               Class="mb-2" />
                <MudTextField T="string" Label="Teléfono" @bind-Value="_formNuevoCliente.Telefono" Required="true" Class="mb-2" />

                <div class="d-flex gap-2 mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CrearClienteRapidoAsync">Crear y seleccionar</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => _mostrarDialogoNuevoCliente = false">Cancelar</MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }

    @if (_productoParaPersonalizar is not null)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" @onclick="() => _productoParaPersonalizar = null">
            <MudPaper Class="pa-6" @onclick:stopPropagation="true" Style="width:400px">
                <MudText Typo="Typo.h6" Class="mb-3">@_productoParaPersonalizar.Nombre</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">Desmarca lo que no lleve:</MudText>

                @foreach (var ingrediente in _ingredientesOpcionales)
                {
                    <MudCheckBox T="bool" Label="@ingrediente.InsumoNombre" Value="!_excluidosSeleccionados.Contains(ingrediente.InsumoId)"
                                 ValueChanged="@((bool incluido) => AlternarExclusion(ingrediente.InsumoId, incluido))" />
                }

                <div class="d-flex gap-2 mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmarPersonalizacion">Agregar al carrito</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => _productoParaPersonalizar = null">Cancelar</MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }

    <MudDialog @bind-Visible="_viendoDetalleFacturaNota" Options="_opcionesDialogoGrande">
        <TitleContent>Factura @_detalleFacturaNota?.NumeroFactura</TitleContent>
        <DialogContent>
            @if (_detalleFacturaNota is not null)
            {
                <MudGrid Class="mb-3">
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">N° Factura</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@_detalleFacturaNota.NumeroFactura</MudText>

                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Sucursal</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@_detalleFacturaNota.SucursalNombre (@_detalleFacturaNota.SucursalCodigo)</MudText>

                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Cliente</MudText>
                        <MudText Typo="Typo.body2">
                            @_detalleFacturaNota.ClienteNombre @(string.IsNullOrEmpty(_detalleFacturaNota.ClienteRncOCedula) ? "" : $"({_detalleFacturaNota.ClienteRncOCedula})")
                        </MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">NCF</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@(_detalleFacturaNota.NumeroNcf ?? "(sin NCF)")</MudText>

                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Caja</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@_detalleFacturaNota.CajaNumero</MudText>

                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Fecha</MudText>
                        <MudText Typo="Typo.body2">@_detalleFacturaNota.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle2" Class="mb-1">Líneas</MudText>
                <MudTable Items="_detalleFacturaNota.Lineas" Hover="true" Dense="true" Class="mb-3">
                    <HeaderContent>
                        <MudTh>Producto</MudTh>
                        <MudTh>Cantidad</MudTh>
                        <MudTh>Precio</MudTh>
                        <MudTh>Descuento</MudTh>
                        <MudTh>ITBIS</MudTh>
                        <MudTh>Total</MudTh>
                        <MudTh>Acreditado</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.NombreProducto</MudTd>
                        <MudTd>@context.Cantidad.ToString("0.###")</MudTd>
                        <MudTd>RD$ @context.PrecioUnitario.ToString("0.00")</MudTd>
                        <MudTd>RD$ @context.Descuento.ToString("0.00")</MudTd>
                        <MudTd>RD$ @context.Itbis.ToString("0.00")</MudTd>
                        <MudTd>RD$ @context.Total.ToString("0.00")</MudTd>
                        <MudTd>@(context.CantidadAcreditada > 0 ? context.CantidadAcreditada.ToString("0.###") : "—")</MudTd>
                    </RowTemplate>
                </MudTable>

                <MudText Typo="Typo.subtitle2" Class="mb-1">Pagos</MudText>
                <MudTable Items="_detalleFacturaNota.Pagos" Hover="true" Dense="true" Class="mb-3">
                    <HeaderContent>
                        <MudTh>Método</MudTh>
                        <MudTh>Monto</MudTh>
                        <MudTh>N° Comprobante</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.NombreMetodoPago</MudTd>
                        <MudTd>RD$ @context.Monto.ToString("0.00")</MudTd>
                        <MudTd>@(context.NumeroComprobante ?? "—")</MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="d-flex justify-end">
                    <div style="min-width:280px">
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2">Subtotal</MudText>
                            <MudText Typo="Typo.body2">RD$ @_detalleFacturaNota.Subtotal.ToString("0.00")</MudText>
                        </div>
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2">ITBIS</MudText>
                            <MudText Typo="Typo.body2">RD$ @_detalleFacturaNota.Itbis.ToString("0.00")</MudText>
                        </div>
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2">Descuento</MudText>
                            <MudText Typo="Typo.body2">RD$ @_detalleFacturaNota.Descuento.ToString("0.00")</MudText>
                        </div>
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2">Propina</MudText>
                            <MudText Typo="Typo.body2">RD$ @_detalleFacturaNota.Propina.ToString("0.00")</MudText>
                        </div>
                        <MudDivider Class="my-1" />
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.subtitle1"><strong>Total</strong></MudText>
                            <MudText Typo="Typo.subtitle1"><strong>RD$ @_detalleFacturaNota.Total.ToString("0.00")</strong></MudText>
                        </div>
                    </div>
                </div>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _viendoDetalleFacturaNota = false">Cerrar</MudButton>
        </DialogActions>
    </MudDialog>
}

@* El recibo de abajo (.solo-imprimir) queda oculto en pantalla a propósito — solo se ve al
   imprimir. Sin este diálogo, después de facturar no queda NADA visible en pantalla más
   que un toast que desaparece solo: el cajero no tiene forma de confirmar que la venta se
   registró ni de volver a ver el detalle si cerró el diálogo de impresión por error. *@
<MudDialog Visible="_ultimaVenta is not null" VisibleChanged="v => { if (!v) _ultimaVenta = null; }" Options="_opcionesDialogo">
    <TitleContent>Venta registrada — Factura @_ultimaVenta?.NumeroFactura</TitleContent>
    <DialogContent>
        @if (_ultimaVenta is not null)
        {
            @if (!string.IsNullOrEmpty(_ultimaVenta.MensajeDgii))
            {
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">Envío a DGII: @_ultimaVenta.MensajeDgii</MudAlert>
            }
            @if (!string.IsNullOrEmpty(_ultimaVenta.NumeroNcf))
            {
                <MudText Typo="Typo.body2" Class="mb-2">NCF: @_ultimaVenta.NumeroNcf</MudText>
            }

            @foreach (var linea in _lineasUltimaVenta)
            {
                <div class="d-flex justify-space-between mb-1">
                    <MudText Typo="Typo.body2">@linea.Cantidad x @linea.Nombre</MudText>
                    <MudText Typo="Typo.body2">RD$ @((linea.Precio * linea.Cantidad).ToString("0.00"))</MudText>
                </div>
                @if (linea.NombresExcluidos.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">Sin: @string.Join(", ", linea.NombresExcluidos)</MudText>
                }
            }
            <MudDivider Class="my-2" />
            <div class="d-flex justify-space-between"><MudText Typo="Typo.body2">Subtotal</MudText><MudText Typo="Typo.body2">RD$ @_ultimaVenta.Subtotal.ToString("0.00")</MudText></div>
            <div class="d-flex justify-space-between"><MudText Typo="Typo.body2">ITBIS</MudText><MudText Typo="Typo.body2">RD$ @_ultimaVenta.Itbis.ToString("0.00")</MudText></div>
            @if (_ultimaVenta.Descuento > 0)
            {
                <div class="d-flex justify-space-between"><MudText Typo="Typo.body2">Descuento</MudText><MudText Typo="Typo.body2">-RD$ @_ultimaVenta.Descuento.ToString("0.00")</MudText></div>
            }
            @if (_ultimaVenta.Propina > 0)
            {
                <div class="d-flex justify-space-between"><MudText Typo="Typo.body2">Propina</MudText><MudText Typo="Typo.body2">RD$ @_ultimaVenta.Propina.ToString("0.00")</MudText></div>
            }
            <MudDivider Class="my-1" />
            <div class="d-flex justify-space-between"><MudText Typo="Typo.subtitle1"><strong>Total</strong></MudText><MudText Typo="Typo.subtitle1"><strong>RD$ @_ultimaVenta.Total.ToString("0.00")</strong></MudText></div>

            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Forma(s) de pago</MudText>
            @foreach (var pago in _ultimaVenta.Pagos)
            {
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.body2">@NombreMetodoPago(pago.MetodoPagoId)@(string.IsNullOrEmpty(pago.NumeroComprobante) ? "" : $" (comp. {pago.NumeroComprobante})")</MudText>
                    <MudText Typo="Typo.body2">RD$ @pago.Monto.ToString("0.00")</MudText>
                </div>
            }
            @if (CambioUltimaVenta > 0)
            {
                <div class="d-flex justify-space-between mt-1"><MudText Typo="Typo.subtitle2"><strong>Cambio</strong></MudText><MudText Typo="Typo.subtitle2"><strong>RD$ @CambioUltimaVenta.ToString("0.00")</strong></MudText></div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => JS.InvokeVoidAsync("print"))">Volver a imprimir</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _ultimaVenta = null">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@if (_ultimaVenta is not null)
{
    <div class="solo-imprimir">
        @EncabezadoRecibo("FACTURA", _ultimaVenta.NumeroFactura, _ultimaVenta.NumeroNcf, _ultimaVenta.FechaEmision,
