    private void CobrarComanda(ComandaDto comanda)
    {
        _comandaOrigen = comanda;
        _carrito.Clear();
        foreach (var item in comanda.Items.Where(i => i.Estado != EstadoItemComanda.Cancelado))
        {
            _carrito.Add(new LineaCarrito
            {
                ProductoId = item.ProductoId,
                Nombre = item.NombreProducto,
                Precio = item.PrecioUnitario,
                Cantidad = (int)item.Cantidad,
                IngredientesExcluidosIds = [.. item.IngredientesExcluidosIds],
                NombresExcluidos = item.IngredientesExcluidosNombres,
                EsDeComanda = true
            });
        }

        _clienteSeleccionado = null;
        _porcentajePropina = 0;
        _descuentoAutorizado = false;
        _codigoAutorizacionDescuento = null;
        _montoDescuento = 0;
        _pagos = [new() { MetodoPagoId = MetodoPagoEfectivoId }];
        _tabIndex = 0;
    }

