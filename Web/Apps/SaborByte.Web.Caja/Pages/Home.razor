        <div style="display:flex; justify-content:space-between; font-weight:bold"><span>TOTAL</span><span>RD$ @_ultimaVenta.Total.ToString("0.00")</span></div>
        <hr />
        <p style="margin:0; font-weight:bold">FORMAS DE PAGO</p>
        @foreach (var pago in _ultimaVenta.Pagos)
        {
            <div style="display:flex; justify-content:space-between">
                <span>@NombreMetodoPago(pago.MetodoPagoId)@(string.IsNullOrEmpty(pago.NumeroComprobante) ? "" : $" (comp. {pago.NumeroComprobante})")</span>
                <span>@pago.Monto.ToString("0.00")</span>
            </div>
        }
        @if (CambioUltimaVenta > 0)
