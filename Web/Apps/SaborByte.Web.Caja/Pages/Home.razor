@page "/"
@using SaborByte.Web.Api
@using SaborByte.Web.Api.Dtos
@inject SaborByteApiClient ApiClient
@inject SesionCliente Sesion
@inject NavigationManager Navegacion
@inject IJSRuntime JS

<PageTitle>Sabor Byte — Caja</PageTitle>

@if (!Sesion.EstaAutenticado)
{
    <MudText>Redirigiendo al inicio de sesión...</MudText>
}
else if (_turnoCajaId is null)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-8" Elevation="3">
            <MudText Typo="Typo.h5" Class="mb-4">Abrir turno de caja</MudText>

            <MudSelect T="Guid" Label="Caja" @bind-Value="_cajaSeleccionadaId" Class="mb-3">
                @foreach (var caja in _cajas)
                {
                    <MudSelectItem Value="@caja.Id">Caja @caja.Numero</MudSelectItem>
                }
            </MudSelect>

            <MudNumericField T="decimal" Label="Monto de apertura (efectivo)" @bind-Value="_montoApertura" Class="mb-3" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="AbrirTurnoAsync">
                Abrir turno
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else if (_cerrando)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Class="mb-4">Cierre de turno — conteo de efectivo</MudText>

            <MudText Typo="Typo.subtitle2" Class="mb-2">Esperado por forma de pago (según ventas del turno)</MudText>
            @foreach (var total in _resumenCierre?.Totales ?? [])
            {
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.body2">@total.FormaPago</MudText>
                    <MudText Typo="Typo.body2">RD$ @total.Esperado.ToString("0.00")</MudText>
                </div>
            }

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Efectivo — desglose de billetes y monedas</MudText>

            <MudGrid>
                @foreach (var denom in _denominacionesEfectivo)
                {
                    <MudItem xs="4" sm="3">
                        <MudNumericField T="int" Label="@($"RD$ {denom}")" @bind-Value="_cantidadesPorDenominacion[denom]" Min="0" />
                    </MudItem>
                }
            </MudGrid>

            <MudText Typo="Typo.subtitle1" Class="mt-3">
                Total efectivo contado: RD$ @TotalEfectivoContado.ToString("0.00")
            </MudText>

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Otras formas de pago — monto contado/reportado</MudText>
            <MudNumericField T="decimal" Label="Tarjeta" @bind-Value="_montoTarjetaContado" Class="mb-2" />
            <MudNumericField T="decimal" Label="Transferencia" @bind-Value="_montoTransferenciaContado" Class="mb-2" />
            <MudNumericField T="decimal" Label="Depósito" @bind-Value="_montoDepositoContado" Class="mb-2" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="my-2">@_error</MudAlert>
            }

            <div class="d-flex gap-2 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmarCierreAsync">
                    Confirmar cierre
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="() => _cerrando = false">Cancelar</MudButton>
            </div>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudGrid>
        <MudItem xs="8">
            <MudTextField T="string" Label="Buscar producto (código de barra o descripción)"
                           @bind-Value="_textoBusqueda" Immediate="true" DebounceInterval="300"
                           OnDebounceIntervalElapsed="BuscarAsync" Class="mb-4" />

            <MudGrid>
                @foreach (var producto in _productos)
                {
                    <MudItem xs="4" sm="3">
                        <MudCard Class="cursor-pointer" @onclick="() => AgregarAlCarrito(producto)">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle2">@producto.Nombre</MudText>
                                <MudText Typo="Typo.body2">RD$ @producto.Precio.ToString("0.00")</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>

        <MudItem xs="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Carrito</MudText>

                <MudAutocomplete T="ClienteDto" Label="Cliente (opcional)" Value="_clienteSeleccionado"
                                  ValueChanged="OnClienteSeleccionado" SearchFunc="BuscarClientesAsync"
                                  ToStringFunc="@(c => c is null ? string.Empty : $"{c.NombreORazonSocial} ({c.RncOCedula})")"
                                  Clearable="true" Class="mb-2" />

                @foreach (var linea in _carrito)
                {
                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.body2">@linea.Cantidad x @linea.Nombre</MudText>
                        <MudText Typo="Typo.body2">RD$ @((linea.Precio * linea.Cantidad).ToString("0.00"))</MudText>
                    </div>
                }

                <MudDivider Class="my-2" />
                <MudText Typo="Typo.body2">Subtotal: RD$ @TotalCarrito.ToString("0.00")</MudText>

                <MudSelect T="decimal" Label="Propina" @bind-Value="_porcentajePropina" Class="my-2">
                    <MudSelectItem Value="0m">Sin propina</MudSelectItem>
                    <MudSelectItem Value="10m">10%</MudSelectItem>
                    <MudSelectItem Value="15m">15%</MudSelectItem>
                </MudSelect>

                @if (_descuentoAutorizado)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="my-2">
                        Descuento autorizado (RD$ @_montoDescuento.ToString("0.00"))
                    </MudAlert>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" FullWidth="true" Class="my-2" OnClick="() => _mostrarDialogoDescuento = true">
                        Aplicar descuento (requiere supervisor)
                    </MudButton>
                }

                <MudText Typo="Typo.subtitle1">Total: RD$ @TotalConPropina.ToString("0.00")</MudText>

                <MudSelect T="FormaPago" Label="Forma de pago" @bind-Value="_formaPago" Class="my-3">
                    <MudSelectItem Value="FormaPago.Efectivo">Efectivo</MudSelectItem>
                    <MudSelectItem Value="FormaPago.Tarjeta">Tarjeta</MudSelectItem>
                    <MudSelectItem Value="FormaPago.Transferencia">Transferencia</MudSelectItem>
                    <MudSelectItem Value="FormaPago.Deposito">Depósito</MudSelectItem>
                </MudSelect>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-2">@_error</MudAlert>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                           Disabled="_carrito.Count == 0" OnClick="FacturarAsync" Class="mb-2">
                    Facturar
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" OnClick="IniciarCierreAsync">
                    Cerrar turno
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_mostrarDialogoDescuento)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" @onclick="() => _mostrarDialogoDescuento = false">
            <MudPaper Class="pa-6" @onclick:stopPropagation="true" Style="width:400px">
                <MudText Typo="Typo.h6" Class="mb-3">Autorización de supervisor</MudText>
                <MudTextField T="string" Label="Usuario supervisor" @bind-Value="_supervisorUsuario" Class="mb-2" />
                <MudTextField T="string" Label="Contraseña" InputType="InputType.Password" @bind-Value="_supervisorPassword" Class="mb-2" />
                <MudNumericField T="decimal" Label="Monto del descuento" @bind-Value="_montoDescuento" Class="mb-2" />

                @if (!string.IsNullOrEmpty(_errorAutorizacion))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-2">@_errorAutorizacion</MudAlert>
                }

                <div class="d-flex gap-2 mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SolicitarAutorizacionAsync">Autorizar</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => _mostrarDialogoDescuento = false">Cancelar</MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }
}

@if (_ultimaVenta is not null)
{
    <div class="solo-imprimir">
        <p style="text-align:center; margin:0">Sabor Byte</p>
        <p style="text-align:center; margin:0">@_ultimaVenta.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        @if (!string.IsNullOrEmpty(_ultimaVenta.NumeroNcf))
        {
            <p style="text-align:center; margin:0">NCF: @_ultimaVenta.NumeroNcf</p>
        }
        <hr />
        @foreach (var linea in _lineasUltimaVenta)
        {
            <div style="display:flex; justify-content:space-between">
                <span>@linea.Cantidad x @linea.Nombre</span>
                <span>@((linea.Precio * linea.Cantidad).ToString("0.00"))</span>
            </div>
        }
        <hr />
        <div style="display:flex; justify-content:space-between"><span>Subtotal</span><span>@_ultimaVenta.Subtotal.ToString("0.00")</span></div>
        <div style="display:flex; justify-content:space-between"><span>ITBIS</span><span>@_ultimaVenta.Itbis.ToString("0.00")</span></div>
        @if (_ultimaVenta.Descuento > 0)
        {
            <div style="display:flex; justify-content:space-between"><span>Descuento</span><span>-@_ultimaVenta.Descuento.ToString("0.00")</span></div>
        }
        @if (_ultimaVenta.Propina > 0)
        {
            <div style="display:flex; justify-content:space-between"><span>Propina</span><span>@_ultimaVenta.Propina.ToString("0.00")</span></div>
        }
        <div style="display:flex; justify-content:space-between; font-weight:bold"><span>TOTAL</span><span>RD$ @_ultimaVenta.Total.ToString("0.00")</span></div>
        <p style="text-align:center; margin-top:8px">¡Gracias por su compra!</p>
    </div>
}

@code {
    private Guid? _turnoCajaId;
    private List<CajaResumenDto> _cajas = [];
    private Guid _cajaSeleccionadaId;
    private decimal _montoApertura;
    private string? _error;

    private string _textoBusqueda = string.Empty;
    private List<ProductoResumenDto> _productos = [];
    private readonly List<LineaCarrito> _carrito = [];
    private FormaPago _formaPago = FormaPago.Efectivo;
    private decimal _porcentajePropina;
    private ClienteDto? _clienteSeleccionado;

    private bool _mostrarDialogoDescuento;
    private string _supervisorUsuario = string.Empty;
    private string _supervisorPassword = string.Empty;
    private decimal _montoDescuento;
    private bool _descuentoAutorizado;
    private Guid? _codigoAutorizacionDescuento;
    private string? _errorAutorizacion;

    private VentaResultadoDto? _ultimaVenta;
    private List<LineaCarrito> _lineasUltimaVenta = [];

    private bool _cerrando;
    private ResumenTurnoDto? _resumenCierre;
    private readonly int[] _denominacionesEfectivo = [2000, 1000, 500, 200, 100, 50, 25, 10, 5, 1];
    private readonly Dictionary<int, int> _cantidadesPorDenominacion = [];
    private decimal _montoTarjetaContado;
    private decimal _montoTransferenciaContado;
    private decimal _montoDepositoContado;

    private decimal TotalCarrito => _carrito.Sum(l => l.Precio * l.Cantidad);
    // Aproximación en pantalla (con ITBIS incluido de forma simplificada); el total real, con ITBIS
    // exacto por línea y la propina aplicada sobre el total con impuestos, lo calcula el backend.
    private decimal TotalConPropina =>
        ((TotalCarrito * 1.18m) - (_descuentoAutorizado ? _montoDescuento : 0)) * (1 + _porcentajePropina / 100m);

    private decimal TotalEfectivoContado => _denominacionesEfectivo.Sum(d => d * (_cantidadesPorDenominacion.GetValueOrDefault(d)));

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        foreach (var d in _denominacionesEfectivo)
            _cantidadesPorDenominacion[d] = 0;

        var sucursalId = Sesion.SucursalesPermitidas.FirstOrDefault();
        _cajas = await ApiClient.ListarCajasAsync(sucursalId);
        if (_cajas.Count > 0)
            _cajaSeleccionadaId = _cajas[0].Id;
    }

    private async Task AbrirTurnoAsync()
    {
        _error = null;
        var (exito, turnoId, error) = await ApiClient.AbrirTurnoAsync(_cajaSeleccionadaId, _montoApertura);

        if (!exito)
        {
            _error = error;
            return;
        }

        _turnoCajaId = turnoId;
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        var sucursalId = Sesion.SucursalesPermitidas.FirstOrDefault();
        _productos = await ApiClient.BuscarProductosAsync(sucursalId, _textoBusqueda);
    }

    private async Task<IEnumerable<ClienteDto>> BuscarClientesAsync(string texto, CancellationToken ct)
    {
        var sucursalId = Sesion.SucursalesPermitidas.FirstOrDefault();
        return await ApiClient.BuscarClientesAsync(sucursalId, texto);
    }

    private void OnClienteSeleccionado(ClienteDto? cliente) => _clienteSeleccionado = cliente;

    private void AgregarAlCarrito(ProductoResumenDto producto)
    {
        var existente = _carrito.FirstOrDefault(l => l.ProductoId == producto.Id);
        if (existente is not null)
        {
            existente.Cantidad++;
        }
        else
        {
            _carrito.Add(new LineaCarrito
            {
                ProductoId = producto.Id,
                Nombre = producto.Nombre,
                Precio = producto.Precio,
                Cantidad = 1
            });
        }
    }

    private async Task SolicitarAutorizacionAsync()
    {
        _errorAutorizacion = null;
        var (exito, codigo, error) = await ApiClient.SolicitarAutorizacionAsync(_supervisorUsuario, _supervisorPassword, "Descuento");

        if (!exito)
        {
            _errorAutorizacion = error;
            return;
        }

        _codigoAutorizacionDescuento = codigo;
        _descuentoAutorizado = true;
        _mostrarDialogoDescuento = false;
        _supervisorPassword = string.Empty;
    }

    private async Task FacturarAsync()
    {
        _error = null;

        var request = new CrearVentaRequestDto
        {
            TurnoCajaId = _turnoCajaId!.Value,
            ClienteId = _clienteSeleccionado?.Id,
            FormaPago = _formaPago,
            Items = _carrito.Select((l, indice) => new ItemVentaDto
            {
                ProductoId = l.ProductoId,
                Cantidad = l.Cantidad,
                // El descuento autorizado se aplica a la primera línea; simple y suficiente para v1.
                Descuento = indice == 0 ? (_descuentoAutorizado ? _montoDescuento : 0) : 0
            }).ToList(),
            PorcentajePropina = _porcentajePropina > 0 ? _porcentajePropina : null,
            CodigoAutorizacionDescuento = _codigoAutorizacionDescuento
        };

        var sucursalId = Sesion.SucursalesPermitidas.FirstOrDefault();
        var (exito, resultado, error) = await ApiClient.CrearVentaAsync(sucursalId, request);

        if (!exito)
        {
            _error = error;
            return;
        }

        _ultimaVenta = resultado;
        _lineasUltimaVenta = [.. _carrito];

        _carrito.Clear();
        _porcentajePropina = 0;
        _descuentoAutorizado = false;
        _codigoAutorizacionDescuento = null;
        _montoDescuento = 0;
        _clienteSeleccionado = null;

        StateHasChanged();
        await JS.InvokeVoidAsync("print");
    }

    private async Task IniciarCierreAsync()
    {
        _resumenCierre = await ApiClient.ObtenerResumenTurnoAsync(_turnoCajaId!.Value);
        _cerrando = true;
    }

    private async Task ConfirmarCierreAsync()
    {
        _error = null;

        var denominaciones = _denominacionesEfectivo
            .Where(d => _cantidadesPorDenominacion.GetValueOrDefault(d) > 0)
            .Select(d => new DenominacionCierreDto { FormaPago = FormaPago.Efectivo, Denominacion = d, Cantidad = _cantidadesPorDenominacion[d] })
            .ToList();

        if (_montoTarjetaContado > 0)
            denominaciones.Add(new DenominacionCierreDto { FormaPago = FormaPago.Tarjeta, Denominacion = null, Cantidad = 1 * (int)_montoTarjetaContado });
        if (_montoTransferenciaContado > 0)
            denominaciones.Add(new DenominacionCierreDto { FormaPago = FormaPago.Transferencia, Denominacion = null, Cantidad = 1 * (int)_montoTransferenciaContado });
        if (_montoDepositoContado > 0)
            denominaciones.Add(new DenominacionCierreDto { FormaPago = FormaPago.Deposito, Denominacion = null, Cantidad = 1 * (int)_montoDepositoContado });

        var (exito, error) = await ApiClient.CerrarTurnoAsync(new CerrarTurnoRequestDto
        {
            TurnoCajaId = _turnoCajaId!.Value,
            Denominaciones = denominaciones
        });

        if (!exito)
        {
            _error = error;
            return;
        }

        _turnoCajaId = null;
        _cerrando = false;
        _resumenCierre = null;
        foreach (var d in _denominacionesEfectivo)
            _cantidadesPorDenominacion[d] = 0;
        _montoTarjetaContado = _montoTransferenciaContado = _montoDepositoContado = 0;
    }

    private class LineaCarrito
    {
        public Guid ProductoId { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal Precio { get; set; }
        public int Cantidad { get; set; }
    }
}
