    private decimal TotalCarrito => _carrito.Sum(l => l.Precio * l.Cantidad);
    private decimal ItbisCarrito => TotalCarrito * 0.18m;
    // Aproximación en pantalla (con ITBIS incluido de forma simplificada); el total real, con ITBIS
    // exacto por línea y la propina aplicada sobre el total con impuestos, lo calcula el backend.
    private decimal TotalConPropina =>
        ((TotalCarrito * 1.18m) - (_descuentoAutorizado ? _montoDescuento : 0)) * (1 + _porcentajePropina / 100m);

    private decimal FaltaPorCubrir => Math.Max(0, Math.Round(TotalConPropina - _pagos.Sum(p => p.Monto), 2));
    private decimal CambioCarrito => Math.Max(0, Math.Round(_pagos.Sum(p => p.Monto) - TotalConPropina, 2));
    private decimal CambioUltimaVenta => _ultimaVenta is null ? 0 : Math.Max(0, Math.Round(_ultimaVenta.Pagos.Sum(p => p.Monto) - _ultimaVenta.Total, 2));

    private decimal TotalEfectivoContado => _denominacionesEfectivo.Sum(d => d * (_cantidadesPorDenominacion.GetValueOrDefault(d)));

    // Encabezado real de los recibos impresos (factura, nota de crédito, reimpresión):
    // nunca el nombre del sistema ("SaborByte"), siempre el de la empresa/sucursal del cliente.
    private EmpresaDto? _empresa;
    private SucursalDto? _sucursalActual;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaAutenticado)
        {
            Navegacion.NavigateTo("/login");
            return;
        }

        if (Sesion.RequiereSeleccionSucursal)
        {
            Navegacion.NavigateTo("/seleccionar-sucursal");
            return;
        }

        _denominacionesEfectivo = (await ApiClient.ListarDenominacionesEfectivoAsync())
            .OrderByDescending(d => d.Valor)
            .Select(d => d.Valor)
            .ToList();
        foreach (var d in _denominacionesEfectivo)
            _cantidadesPorDenominacion[d] = 0;

        _porcentajesPropina = await ApiClient.ListarPorcentajesPropinaAsync();

        var sucursalId = Sesion.SucursalActivaId;
        _empresa = await ApiClient.ObtenerEmpresaAsync();
        _sucursalActual = await ApiClient.ObtenerSucursalAsync(sucursalId);
        _categorias = await ApiClient.ListarCategoriasAsync();
        _cajas = await ApiClient.ListarCajasAsync(sucursalId);
        if (_cajas.Count > 0)
            _cajaSeleccionadaId = _cajas[0].Id;

        _metodosPago = await ApiClient.ListarMetodosPagoAsync();
        _pagos = [new PagoVentaRequestDto { MetodoPagoId = MetodoPagoEfectivoId }];

        if (_cajaSeleccionadaId != Guid.Empty)
            await VerificarTurnoAbiertoAsync();
    }

    private async Task OnCajaSeleccionadaAsync(Guid cajaId)
    {
        _cajaSeleccionadaId = cajaId;
        await VerificarTurnoAbiertoAsync();
    }

    // El turno vive en la base, no en la sesión de quien lo abrió: si ya hay uno abierto
    // en esta caja (lo haya abierto quien sea), hay que retomarlo — o, si quedó abierto
    // de un día anterior, forzar el cierre antes de dejar operar.
    private async Task VerificarTurnoAbiertoAsync()
    {
        _turnoBloqueadoOtroDia = null;
        var turnoAbierto = await ApiClient.ObtenerTurnoAbiertoAsync(_cajaSeleccionadaId);
        if (turnoAbierto is null)
            return;

        if (turnoAbierto.EsDeOtroDia)
        {
            _turnoBloqueadoOtroDia = turnoAbierto;
            return;
        }

        _turnoCajaId = turnoAbierto.TurnoCajaId;
        _turnoAbierto = turnoAbierto;
        await BuscarAsync();
        await CargarComandasAbiertasAsync();
    }

    private async Task IrACerrarTurnoBloqueadoAsync()
    {
        _turnoCajaId = _turnoBloqueadoOtroDia!.TurnoCajaId;
        _turnoBloqueadoOtroDia = null;
        await IniciarCierreAsync();
    }

    private async Task AbrirTurnoAsync()
    {
        var (exito, turnoId, error) = await ApiClient.AbrirTurnoAsync(_cajaSeleccionadaId, _montoApertura);

        if (!exito)
        {
            Snackbar.Add(error ?? "Ocurrió un error.", Severity.Error);
